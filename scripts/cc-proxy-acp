#!/usr/bin/env python3
# /// script
# requires-python = ">=3.12"
# dependencies = [
#     "agent-client-protocol==1.0.0",
#     "httpx==0.28.1",
#     "mcp==2.3.0",
# ]
# ///
"""Attach ACP clients to the running sessions owned by the existing fleet HQ."""

import argparse
import asyncio
import hashlib
import json
import os
import time
import uuid
from dataclasses import dataclass, field
from pathlib import Path
from urllib.parse import quote

import httpx
import httpx2
from acp import RequestError
from acp.experimental.v2 import Agent, run_agent
from acp.experimental.v2 import schema as s
from mcp import ClientSession
from mcp.client.streamable_http import streamable_http_client


def failure(message):
    return RequestError(-32000, message)


def available(row):
    return (row.get("alive") is True and row.get("online") is not False
            and row.get("lifecycle") not in {"ended", "unreachable", "unknown"})


def messages(row):
    return [m for m in row.get("messages", []) if m.get("role") in {"user", "assistant"}
            and isinstance(m.get("text"), str) and m["text"]]


def identify_messages(rows, previous):
    def matches(old, new):
        if new.get("id"):
            return old.get("id") == new["id"]
        return old["role"] == new["role"] and (new["text"] == old["text"] or new["text"].startswith(old["text"]))

    overlap, offset = 0, 0
    for start in range(len(previous)):
        size = min(len(previous) - start, len(rows))
        if size > overlap and all(matches(previous[start + i], rows[i]) for i in range(size)):
            overlap, offset = size, start
    result, counts = [], {}
    for index, message in enumerate(rows):
        digest = hashlib.sha256(f"{message['role']}\0{message['text']}".encode()).hexdigest()
        counts[digest] = counts.get(digest, 0) + 1
        key = message.get("id") or (previous[offset + index]["key"] if index < overlap else
                                    f"{digest}:{counts[digest]}")
        result.append({**message, "key": str(key)})
    return result


class HQ:
    def __init__(self, url, token, *, transport=None, mcp_url=None, mcp_token=None):
        self.http = httpx.AsyncClient(base_url=url.rstrip("/"), timeout=180,
                                      headers={"Authorization": f"Bearer {token}"} if token else {},
                                      transport=transport, follow_redirects=False)
        self.mcp_url = mcp_url
        self.mcp_token = mcp_token

    async def list(self):
        async with (
            httpx2.AsyncClient(headers={"Authorization": f"Bearer {self.mcp_token}"}, timeout=180) as http,
            streamable_http_client(self.mcp_url, http_client=http) as (read, write, *_),
            ClientSession(read, write) as client,
        ):
            await client.initialize()
            result = await client.call_tool("list_sessions", {})
            if result.is_error:
                raise failure("Fleet session discovery failed.")
            data = result.structured_content
            rows = data["result"] if data is not None else json.loads(result.content[0].text)
            if not isinstance(rows, list):
                raise failure("Fleet session discovery returned an invalid list.")
            return rows

    async def get(self, path):
        try:
            response = await self.http.get(path)
        except httpx.TransportError as exc:
            raise failure("Fleet HQ is unavailable; the existing session was left running.") from exc
        if response.status_code != 200:
            raise failure(f"Fleet HQ read failed (HTTP {response.status_code}).")
        return response.json()

    async def detail(self, session_id):
        row = await self.get(f"/api/sessions/{quote(session_id, safe='')}")
        if not available(row) or not row.get("revision"):
            raise failure("This fleet session is offline or ended; it cannot be controlled.")
        return row

    async def action(self, session_id, action, *, revision=None, **fields):
        path = f"/api/sessions/{quote(session_id, safe='')}"
        for attempt in range(3):
            request_id = uuid.uuid4().hex
            row = await self.detail(session_id)
            if revision is not None and revision != row["revision"]:
                raise failure("The request changed. Read the session again before answering.")
            body = {"action": action, "revision": revision or row["revision"],
                    "request_id": request_id, **fields}
            try:
                response = await self.http.post(f"{path}/action", json=body)
            except httpx.TransportError as exc:
                raise failure(f"Delivery is unknown; do not resend. request_id={request_id}") from exc
            if (response.status_code == 409 and "refresh" in response.text.lower()
                    and revision is None and attempt < 2):
                continue
            if response.status_code >= 400:
                raise failure(f"Fleet action rejected (HTTP {response.status_code}); request_id={request_id}")
            return response.json()


@dataclass
class Attached:
    seen: dict = field(default_factory=dict)
    history: list = field(default_factory=list)
    aliases: dict = field(default_factory=dict)
    observer: asyncio.Task | None = None
    lock: asyncio.Lock = field(default_factory=asyncio.Lock)
    pending: str | None = None
    prompt_id: str | None = None
    prompt_started: float = 0
    echoed: bool = False
    answered: bool = False
    settled: int = 0
    state: str | None = None
    cancelled: bool = False
    controls: set = field(default_factory=set)


CONFIG_OPTIONS = [{"configId": "model", "name": "Model", "category": "model", "type": "select",
                   "currentValue": "attached", "options": [{"value": "attached", "name": "Existing session"}]}]


class FleetAgent(Agent):
    def __init__(self, hq, *, poll_interval=1, turn_timeout=3600, sleep=asyncio.sleep, observe=True):
        self.hq = hq
        self.poll_interval = poll_interval
        self.turn_timeout = turn_timeout
        self.sleep = sleep
        self.observe = observe
        self.sessions = {}
        self.client_capabilities = s.ClientCapabilities()

    def on_connect(self, conn):
        self.conn = conn

    async def initialize(self, protocol_version, info=None, capabilities=None, **kwargs):
        self.client_capabilities = capabilities or s.ClientCapabilities()
        return s.InitializeResponse(protocol_version=2,
            info=s.Implementation(name="cc-proxy-fleet", title="CC fleet", version="0.1.0"),
            capabilities=s.AgentCapabilities(session=s.SessionCapabilities()), auth_methods=[])

    async def new_session(self, cwd, **kwargs):
        # T3 probes providers with session/new; this is an unbound ACP handle, never an agent launch.
        return s.NewSessionResponse(session_id=f"unbound:{uuid.uuid4().hex}",
                                    config_options=CONFIG_OPTIONS)

    async def list_sessions(self, cwd=None, cursor=None, **kwargs):
        rows = [row for row in await self.hq.list() if available(row)]
        rows.sort(key=lambda row: row["id"])
        start = 0
        if cursor:
            matching = [i for i, row in enumerate(rows) if row["id"] == cursor]
            if matching:
                start = matching[0] + 1
        selected = rows[start:start + 100]
        sessions = []
        for row in selected:
            host = row.get("host_label") or row.get("host") or "Fleet"
            title = row.get("title") or row.get("session") or row["id"]
            transport = row.get("transport", "tmux")
            sessions.append(s.SessionInfo(session_id=row["id"], cwd=row.get("workdir") or cwd or "/",
                                           title=f"[{host} · {transport}] {title}"))
        return s.ListSessionsResponse(sessions=sessions,
            next_cursor=selected[-1]["id"] if start + len(selected) < len(rows) else None)

    async def emit_messages(self, session_id, row, attached):
        fresh = []
        rows = identify_messages(messages(row), attached.history)
        attached.history = rows
        for message in rows:
            key = message["key"]
            if attached.pending and message["role"] == "user" and attached.pending in message["text"] and key not in attached.seen:
                attached.echoed = True
                attached.aliases[key] = attached.prompt_id
            if attached.seen.get(key) == message["text"]:
                continue
            attached.seen[key] = message["text"]
            fresh.append(message)
            if message["role"] == "assistant" and attached.echoed:
                attached.answered = True
            cls = s.UserMessageUpdate if message["role"] == "user" else s.AgentMessageUpdate
            await self.conn.session_update(session_id, cls(content=[s.TextContentBlock(text=message["text"])],
                                                           message_id=attached.aliases.get(key, key)))
        return fresh

    async def resume_session(self, cwd, session_id, **kwargs):
        row = await self.hq.detail(session_id)
        await self.close_session(session_id)
        attached = self.sessions[session_id] = Attached()
        await self.emit_messages(session_id, row, attached)
        if self.observe:
            attached.observer = asyncio.create_task(self.watch(session_id, attached))
        return s.ResumeSessionResponse(config_options=CONFIG_OPTIONS)

    async def set_config_option(self, config_id, session_id, value, **kwargs):
        if config_id != "model" or value != "attached":
            raise failure("The existing session owns its model and settings.")
        return s.SetSessionConfigOptionResponse(config_options=CONFIG_OPTIONS)

    async def close_session(self, session_id, **kwargs):
        attached = self.sessions.pop(session_id, None)
        if attached and attached.observer:
            attached.observer.cancel()
            try:
                await attached.observer
            except asyncio.CancelledError:
                pass
        return s.CloseSessionResponse()

    async def state(self, session_id, attached, state, stop_reason="end_turn"):
        if state == attached.state:
            return
        attached.state = state
        update = (s.RunningSessionStateUpdate() if state == "running" else
                  s.RequiresActionSessionStateUpdate() if state == "requires_action" else
                  s.IdleSessionStateUpdate(stop_reason=stop_reason))
        await self.conn.session_update(session_id, update)

    async def poll(self, session_id, attached):
        async with attached.lock:
            row = await self.hq.detail(session_id)
            await self.emit_messages(session_id, row, attached)
            pending_control = bool(row.get("native_control") or row.get("menu"))
            busy = (row.get("activity") or row.get("status")) in {"working", "running", "thinking", "busy", "starting"}
            if pending_control:
                await self.state(session_id, attached, "requires_action")
                await self.handle_control(session_id, row, attached)
                return
            if attached.pending:
                attached.settled = attached.settled + 1 if attached.answered and not busy else 0
                if attached.settled >= 2 or (attached.cancelled and not busy):
                    attached.pending = None
                elif time.monotonic() - attached.prompt_started > self.turn_timeout:
                    attached.pending = None
                    await self.conn.session_update(session_id, s.SessionNotice(severity="error",
                        title="Observation timed out", description="The existing session continues. Read it before sending again."))
                    await self.state(session_id, attached, "idle", "refusal")
                    return
            await self.state(session_id, attached, "running" if busy or attached.pending else "idle",
                             "cancelled" if attached.cancelled else "end_turn")

    async def watch(self, session_id, attached):
        reported = False
        while self.sessions.get(session_id) is attached:
            await self.sleep(self.poll_interval if not reported else 5)
            try:
                await self.poll(session_id, attached)
                reported = False
            except (RequestError, httpx.TransportError):
                if not reported:
                    await self.conn.session_update(session_id, s.SessionNotice(severity="error",
                        title="Session needs attention", description="Open HQ or the original terminal. No action was retried or permission granted."))
                reported = True

    async def form(self, session_id, message, properties):
        elicitation = self.client_capabilities.elicitation
        if elicitation is None or elicitation.form is None:
            raise failure("This client cannot show the session's question. Answer it in HQ or the original terminal.")
        response = await self.conn.create_elicitation(message, "form", session_id=session_id,
            requested_schema=s.ElicitationSchema(properties=properties, required=list(properties)))
        if response.action != "accept":
            raise failure("Question left unanswered; the existing session is still waiting.")
        return response.content or {}

    async def handle_control(self, session_id, row, attached):
        control = row.get("native_control")
        menu = row.get("menu")
        key = control.get("request_id") if control else menu.get("signature") if menu else None
        key = key or (row["revision"] if menu else None)
        if key is None or key in attached.controls:
            return
        if control:
            if control.get("subtype") == "request_user_dialog":
                raise failure("This native dialog requires HQ or the original terminal; no permission was granted.")
            response = {"request_id": control["request_id"]}
            if control.get("tool_name") == "AskUserQuestion":
                questions = control.get("input", {}).get("questions", [])
                if not questions:
                    raise failure("The session question is malformed; answer it in HQ.")
                properties = {}
                for i, question in enumerate(questions):
                    choices = "; ".join(option["label"] for option in question.get("options", []))
                    properties[f"answer_{i}"] = {"type": "string", "title": question["question"],
                                                 "description": choices}
                answers = await self.form(session_id, "Answer the existing session's questions", properties)
                if any(not str(answers.get(f"answer_{i}", "")).strip() for i in range(len(questions))):
                    raise failure("Every question needs an answer.")
                response.update(behavior="allow", updated_input={**control["input"], "answers": {
                    question["question"]: str(answers[f"answer_{i}"]) for i, question in enumerate(questions)}})
            else:
                call = s.ToolCallUpdate(tool_call_id=control["request_id"], title=control.get("tool_name", "Permission"),
                                       kind="other", status="pending", raw_input=control.get("input", {}))
                await self.conn.session_update(session_id, s.SessionToolCallUpdate.model_validate(call.model_dump()))
                permission = await self.conn.request_permission(session_id, control.get("tool_name", "Permission"),
                    [s.PermissionOption(option_id="allow", name="Allow once", kind="allow_once"),
                     s.PermissionOption(option_id="deny", name="Deny", kind="reject_once")],
                    subject=s.ToolCallPermissionSubjectVariant(tool_call=call))
                allowed = permission.outcome.outcome == "selected" and permission.outcome.option_id == "allow"
                response.update(behavior="allow" if allowed else "deny")
                if allowed:
                    response["updated_input"] = control.get("input", {})
            attached.controls.add(key)
            await self.hq.action(session_id, "respond", revision=row["revision"], response=response)
        elif menu:
            if menu.get("multi_select") or any(option.get("kind") == "free_text" for option in menu.get("options", [])):
                raise failure("This terminal menu needs HQ or the original terminal; no choice was made.")
            options = menu.get("options", [])
            choices = {str(option["index"]): option["label"] for option in options}
            answer = await self.form(session_id, menu.get("question") or "Choose an option", {
                "choice": {"type": "string", "title": "Option", "enum": list(choices),
                           "enumNames": list(choices.values())}})
            if answer.get("choice") not in choices:
                raise failure("No valid option selected.")
            attached.controls.add(key)
            await self.hq.action(session_id, "select", revision=row["revision"], index=int(answer["choice"]))
        attached.controls.add(key)

    async def prompt(self, session_id, prompt, **kwargs):
        attached = self.sessions.get(session_id)
        if attached is None:
            raise failure("Choose List sessions on the CC fleet provider and import an existing session first.")
        if attached.pending:
            raise failure("A submitted prompt is still being observed for this session.")
        if any(not isinstance(block, s.TextContentBlock) for block in prompt):
            raise failure("Fleet sessions currently accept text prompts only.")
        text = "\n".join(block.text for block in prompt).strip()
        if not text or len(text.encode("utf-8")) > 16384:
            raise failure("The prompt must contain between 1 and 16384 UTF-8 bytes.")
        async with attached.lock:
            if attached.pending:
                raise failure("A submitted prompt is still being observed for this session.")
            row = await self.hq.detail(session_id)
            await self.emit_messages(session_id, row, attached)
            if row.get("native_control") or row.get("menu"):
                raise failure("The existing session has an unanswered request. Answer it before sending another prompt.")
            await self.hq.action(session_id, "send", text=text)
            attached.pending, attached.prompt_id = text, uuid.uuid4().hex
            attached.echoed = attached.answered = attached.cancelled = False
            attached.settled = 0
            attached.prompt_started = time.monotonic()
            await self.state(session_id, attached, "running")
            return s.PromptResponse(message_id=attached.prompt_id)

    async def cancel_session(self, session_id, **kwargs):
        attached = self.sessions.get(session_id)
        if attached is not None:
            await self.hq.action(session_id, "interrupt")
            attached.cancelled = True

    async def ext_method(self, method, params):
        raise RequestError(-32601, "Method not supported")

    async def ext_notification(self, method, params):
        return None


async def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--hq-url", default=os.environ.get("CC_TMUX_HQ_URL", "http://127.0.0.1:8389"))
    parser.add_argument("--token-file", default=os.environ.get("CC_TMUX_HQ_TOKEN_FILE"))
    parser.add_argument("--mcp-url", default=os.environ.get("CC_PROXY_MCP_URL"))
    parser.add_argument("--mcp-token-file", default=os.environ.get("CC_TMUX_MCP_TOKEN_FILE"))
    parser.add_argument("--poll-interval", type=float, default=1)
    parser.add_argument("--turn-timeout", type=float, default=3600)
    args = parser.parse_args()
    token = Path(args.token_file).expanduser().read_text().strip() if args.token_file else os.environ.get("CC_TMUX_HQ_TOKEN", "")
    if not args.mcp_url or not args.mcp_token_file:
        parser.error("--mcp-url and --mcp-token-file are required for fleet discovery")
    mcp_token = Path(args.mcp_token_file).expanduser().read_text().strip()
    if not mcp_token:
        parser.error("MCP token file is empty")
    if args.poll_interval <= 0 or args.turn_timeout <= 0:
        parser.error("poll interval and turn timeout must be positive")
    hq = HQ(args.hq_url, token, mcp_url=args.mcp_url, mcp_token=mcp_token)
    try:
        await run_agent(FleetAgent(hq, poll_interval=args.poll_interval, turn_timeout=args.turn_timeout))
    finally:
        await hq.http.aclose()


if __name__ == "__main__":
    asyncio.run(main())
