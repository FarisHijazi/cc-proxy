"""Attach ACP clients to the running sessions owned by the existing fleet HQ."""

import argparse
import asyncio
import hashlib
import os
import sys
import time
import uuid
from dataclasses import dataclass, field
from pathlib import Path

import httpx
from acp import Agent, RequestError, run_agent
from acp import schema as s

# Source checkouts and immutable bundles keep the SDK next to scripts/. Wheels
# expose the same cc_proxy package directly; there is no second client copy.
_source_python = Path(__file__).resolve().parents[1] / "python"
if _source_python.is_dir():
    sys.path.insert(0, str(_source_python))
from cc_proxy.session_client import (
    ActionRejected as SDKActionRejected,
)
from cc_proxy.session_client import (
    SessionClient,
    SessionClientError,
    available,
)


def failure(message):
    return RequestError(-32000, message)


class ActionRejected(RequestError):
    """The owner confirmed that the action was not delivered."""

    def __init__(self, message):
        super().__init__(-32000, message)


class ControlDeclined(RequestError):
    """The user left this exact control unanswered."""


class InvalidAnswer(RequestError):
    """A submitted form needs correction before any owner action is sent."""

    def __init__(self, message):
        super().__init__(-32000, message)


def metadata_text(value, limit=256):
    return value if (isinstance(value, str) and 0 < len(value) <= limit and value.strip() == value
                     and not any(ord(char) < 32 or 127 <= ord(char) < 160 for char in value)) else None


def machine(row):
    # HQ labels a session "<machine> / <local host or Codex>"; the transport is reported separately.
    label = metadata_text(row.get("host_label") or row.get("host"))
    return label.split(" / ")[0].strip() or None if label else None


def external_state(row):
    if row is None or not available(row):
        return "unavailable"
    activity = row.get("activity") or row.get("status")
    if row.get("native_control") or row.get("menu") or row.get("waiting_on_question") or activity == "waiting":
        return "requires_action"
    return {"running": "running", "working": "running", "idle": "idle"}.get(activity, "unavailable")


def external_identity(row):
    provider, transport = row.get("provider"), row.get("transport")
    host = machine(row)
    if not host or (provider, transport) not in (("claude", "tmux"), ("claude", "native"), ("codex", "codex")):
        return None
    live = available(row)
    owner = row.get("capabilities")
    owner = owner if isinstance(owner, dict) else {}
    control = row.get("native_control") or {}
    control = control if isinstance(control, dict) else {}
    menu = row.get("menu")
    # The verified-Claude tmux owner predates explicit capability fields.
    legacy_tmux = transport == "tmux" and "capabilities" not in row
    send = legacy_tmux or owner.get("send") is True
    interrupt = legacy_tmux or owner.get("interrupt") is True
    respond = legacy_tmux and bool(menu) or owner.get("respond") is True
    result = {"version": 1, "engine": "claude-code" if provider == "claude" else "codex",
              "connection": {"kind": "fleet", "host": host, "transport": transport},
              "capabilities": {"send": live and send and not bool(control or menu),
                  "interrupt": live and interrupt,
                  "respond": live and respond and control.get("subtype") != "request_user_dialog",
                  "setModel": False, "setPermissionMode": False, "terminal": False}}
    for key, source in (("model", "model"), ("nativeSessionId", "codex_thread_id" if provider == "codex" else "claude_session_id")):
        value = metadata_text(row.get(source), 1024 if key == "nativeSessionId" else 256)
        if value:
            result[key] = value
    return result


def identity_meta(identity):
    return {"t3.codes/externalSessionIdentity": identity} if identity else None


def messages(row):
    return [m for m in row.get("messages", []) if m.get("role") in {"user", "assistant"}
            and isinstance(m.get("text"), str) and m["text"]]


def other_choice(labels):
    value = "__cc_fleet_other__"
    while value in labels:
        value += "_"
    return value


def identify_messages(rows, previous):
    def matches(old, new):
        if new.get("id"):
            return old.get("id") == new["id"]
        return old["role"] == new["role"] and (new["text"] == old["text"] or new["text"].startswith(old["text"]))

    overlap, offset = 0, 0
    for start in range(len(previous)):
        size = min(len(previous) - start, len(rows))
        if size > overlap and all(matches(previous[start + i], rows[i]) for i in range(size)):
            overlap, offset = size, start
    result, counts = [], {}
    for index, message in enumerate(rows):
        digest = hashlib.sha256(f"{message['role']}\0{message['text']}".encode()).hexdigest()
        counts[digest] = counts.get(digest, 0) + 1
        key = message.get("id") or (previous[offset + index]["key"] if index < overlap else
                                    f"{digest}:{counts[digest]}")
        result.append({**message, "key": str(key)})
    return result


class HQ:
    """Translate the shared SDK's typed errors to the existing ACP wire errors."""

    def __init__(self, url, token, *, transport=None, mcp_url=None, mcp_token=None):
        self.client = SessionClient(url, token, transport=transport,
                                    mcp_url=mcp_url, mcp_token=mcp_token)
        self.http = self.client.http

    async def _call(self, operation, *args, **kwargs):
        try:
            return await operation(*args, **kwargs)
        except SDKActionRejected as exc:
            raise ActionRejected(str(exc)) from exc
        except SessionClientError as exc:
            raise failure(str(exc)) from exc

    async def list(self):
        return await self._call(self.client.list)

    async def get(self, path):
        return await self._call(self.client.get, path)

    async def detail(self, session_id):
        return await self._call(self.client.detail, session_id)

    async def action(self, session_id, action, *, revision=None, **fields):
        return await self._call(self.client.action, session_id, action,
                                revision=revision, **fields)

    async def aclose(self):
        await self.client.aclose()


@dataclass
class Attached:
    seen: dict = field(default_factory=dict)
    history: list = field(default_factory=list)
    observer: asyncio.Task | None = None
    lock: asyncio.Lock = field(default_factory=asyncio.Lock)
    pending: str | None = None
    completion: asyncio.Future | None = None
    own_user_key: str | None = None
    request_id: str | None = None
    source_message_id: str | None = None
    prompt_message_id: str | None = None
    prompt_started: float = 0
    echoed: bool = False
    answered: bool = False
    settled: int = 0
    cancelled: bool = False
    cancel_attempted: bool = False
    controls: set = field(default_factory=set)
    control_task: asyncio.Task | None = None
    control_key: str | None = None
    state: str | None = None
    identity: dict | None = None
    history_truncated: bool = False


CONFIG_OPTIONS = [{"id": "model", "name": "Model", "category": "model", "type": "select",
                   "currentValue": "attached", "options": [{"value": "attached", "name": "Existing session"}]}]


class FleetAgent(Agent):
    def __init__(self, hq, *, poll_interval=1, turn_timeout=3600, sleep=asyncio.sleep, observe=True):
        self.hq = hq
        self.poll_interval = poll_interval
        self.turn_timeout = turn_timeout
        self.sleep = sleep
        self.observe = observe
        self.sessions = {}
        self.client_capabilities = s.ClientCapabilities()
        self.external_session = False

    def on_connect(self, conn):
        self.conn = conn

    async def initialize(self, protocol_version, client_info=None, client_capabilities=None, **kwargs):
        self.client_capabilities = client_capabilities or s.ClientCapabilities()
        self.external_session = (self.client_capabilities.field_meta or {}).get(
            "t3.codes/externalSession") == {"version": 1}
        return s.InitializeResponse(protocol_version=1,
            field_meta={"t3.codes/externalSession": {"version": 1},
                        "t3.codes/connectionRole": {"version": 1, "role": "discovery"}},
            agent_info=s.Implementation(name="cc-proxy-fleet", title="CC fleet", version="0.2.0"),
            agent_capabilities=s.AgentCapabilities.model_validate({"loadSession": True,
                "sessionCapabilities": {"list": {}, "resume": {}, "close": {}}}), auth_methods=[])

    async def new_session(self, cwd, **kwargs):
        # T3 probes providers with session/new; this is an unbound ACP handle, never an agent launch.
        return s.NewSessionResponse(session_id=f"unbound:{uuid.uuid4().hex}",
                                    config_options=CONFIG_OPTIONS)

    async def list_sessions(self, cwd=None, cursor=None, **kwargs):
        rows = [row for row in await self.hq.list() if available(row)]
        rows.sort(key=lambda row: row["id"])
        start = 0
        if cursor:
            matching = [i for i, row in enumerate(rows) if row["id"] == cursor]
            if matching:
                start = matching[0] + 1
        selected = rows[start:start + 100]
        # A Remote Control session running inside a listed tmux pane is that pane's session.
        panes = {row["bridge_session_id"]: row["id"] for row in rows
                 if row.get("transport") == "tmux" and row.get("bridge_session_id")}
        sessions = []
        for row in selected:
            tmux_session = row.get("tmux_session") if row.get("transport", "tmux") == "tmux" else None
            title = row.get("title") or tmux_session or row.get("session") or row["id"]
            identity = external_identity(row)
            pane = panes.get(row.get("tmux_session")) if row.get("transport") == "native" else None
            if identity and pane:
                identity["duplicateOf"] = pane
            meta = ({**(identity_meta(identity) or {}),
                     "t3.codes/externalSessionState": {"version": 1, "state": external_state(row)}}
                    if self.external_session else None)
            sessions.append(s.SessionInfo(session_id=row["id"], cwd=row.get("workdir") or cwd or "/",
                                           title=title, field_meta=meta))
        return s.ListSessionsResponse(sessions=sessions,
            next_cursor=selected[-1]["id"] if start + len(selected) < len(rows) else None)

    async def emit_messages(self, session_id, row, attached):
        fresh = []
        rows = identify_messages(messages(row), attached.history)
        attached.history = rows
        own_index = next((i for i, m in enumerate(rows) if m["key"] == attached.own_user_key), None)
        for index, message in enumerate(rows):
            key = message["key"]
            correlated = bool((attached.request_id and message.get("client_id") == attached.request_id)
                              or (attached.source_message_id and message.get("id") == attached.source_message_id))
            legacy_echo = (not attached.source_message_id and row.get("provider") != "codex"
                           and attached.pending and attached.pending in message["text"])
            if attached.pending and not attached.echoed and message["role"] == "user" and (correlated or legacy_echo) and key not in attached.seen:
                attached.echoed = True
                attached.own_user_key = key
                own_index = index
            previous = attached.seen.get(key, "")
            if previous == message["text"]:
                continue
            if not message["text"].startswith(previous):
                raise failure("A remote message changed its existing text. Reload the session history to read the correction.")
            attached.seen[key] = message["text"]
            fresh.append(message)
            if message["role"] == "assistant" and own_index is not None and index > own_index:
                attached.answered = True
            meta = None
            if key == attached.own_user_key:
                if not self.external_session:
                    continue
                if correlated and message.get("id") and attached.prompt_message_id:
                    meta = {"t3.codes/messageId": attached.prompt_message_id}
            cls = s.UserMessageChunk if message["role"] == "user" else s.AgentMessageChunk
            await self.conn.session_update(session_id, cls(content=s.TextContentBlock(text=message["text"][len(previous):]),
                                                           message_id=key, field_meta=meta))
        truncated = row.get("history_truncated") is True
        if truncated and not attached.history_truncated:
            await self.conn.session_update(session_id, s.SessionUpdateNotice(severity="warning",
                title="Recent history only", description="Showing recent messages provided by the session owner. Earlier messages are not included."))
        attached.history_truncated = truncated
        return fresh

    async def resume_session(self, cwd, session_id, **kwargs):
        row = await self.hq.detail(session_id)
        await self.close_session(session_id)
        attached = self.sessions[session_id] = Attached()
        await self.emit_messages(session_id, row, attached)
        await self.emit_state(session_id, row, attached)
        if self.observe:
            attached.observer = asyncio.create_task(self.watch(session_id, attached))
        return s.ResumeSessionResponse(config_options=CONFIG_OPTIONS, field_meta=identity_meta(attached.identity))

    async def load_session(self, cwd, session_id, **kwargs):
        response = await self.resume_session(cwd, session_id, **kwargs)
        return s.LoadSessionResponse(config_options=CONFIG_OPTIONS, field_meta=response.field_meta)

    async def set_config_option(self, config_id, session_id, value, **kwargs):
        if config_id != "model" or value != "attached":
            raise failure("The existing session owns its model and settings.")
        return s.SetSessionConfigOptionResponse(config_options=CONFIG_OPTIONS)

    async def close_session(self, session_id, **kwargs):
        attached = self.sessions.pop(session_id, None)
        if attached and attached.observer:
            attached.observer.cancel()
            try:
                await attached.observer
            except asyncio.CancelledError:
                pass
        if attached and attached.completion and not attached.completion.done():
            attached.completion.cancel()
        if attached and attached.control_task:
            attached.control_task.cancel()
            await asyncio.gather(attached.control_task, return_exceptions=True)
        return s.CloseSessionResponse()

    def finish(self, attached, stop_reason):
        attached.pending = None
        if attached.completion is not None and not attached.completion.done():
            attached.completion.set_result(s.PromptResponse(stop_reason=stop_reason))

    async def emit_state(self, session_id, row, attached):
        if not self.external_session:
            return
        state = external_state(row)
        identity = external_identity(row) if row is not None else None
        if identity is None and attached.identity is not None:
            identity = {**attached.identity, "capabilities": {key: False for key in attached.identity["capabilities"]}}
        if attached.state != state or attached.identity != identity:
            if (attached.state == "idle" and state in {"running", "requires_action"}
                    and attached.cancelled and not attached.pending):
                attached.cancel_attempted = attached.cancelled = False
            await self.conn.session_update(session_id, s.SessionInfoUpdate(field_meta={
                "t3.codes/externalSessionState": {"version": 1, "state": state},
                **(identity_meta(identity) or {})}))
            attached.state, attached.identity = state, identity

    async def poll(self, session_id, attached):
        if attached.control_task is not None and attached.control_task.done():
            task, attached.control_task = attached.control_task, None
            attached.control_key = None
            task.result()
        async with attached.lock:
            row = await self.hq.detail(session_id)
            await self.emit_messages(session_id, row, attached)
            await self.emit_state(session_id, row, attached)
            idle = (row.get("activity") or row.get("status")) == "idle"
            control = bool(row.get("native_control") or row.get("menu"))
            key = self.control_identity(row) if available(row) else None
            if attached.control_task and key != attached.control_key:
                task, attached.control_task = attached.control_task, None
                attached.control_key = None
                task.cancel()
                await asyncio.gather(task, return_exceptions=True)
            if not available(row):
                self.observation_failed(attached)
                return
            if attached.pending and not control:
                attached.settled = attached.settled + 1 if attached.answered and idle else 0
                if attached.cancelled and idle:
                    self.finish(attached, "cancelled")
                elif attached.settled >= 2:
                    self.finish(attached, "end_turn")
        if key is not None and key not in attached.controls and attached.control_task is None:
            attached.control_key = key
            attached.control_task = asyncio.create_task(self.handle_control(session_id, row, attached))

    def observation_failed(self, attached):
        if attached.completion is not None and not attached.completion.done():
            attached.completion.set_exception(failure(
                "Session observation failed. The existing session continues; read it before sending again."))

    async def watch(self, session_id, attached):
        reported = False
        try:
            while self.sessions.get(session_id) is attached:
                await self.sleep(self.poll_interval if not reported else 5)
                try:
                    await self.poll(session_id, attached)
                    reported = False
                except (RequestError, httpx.TransportError, ValueError):
                    self.observation_failed(attached)
                    await self.emit_state(session_id, None, attached)
                    if not reported:
                        await self.conn.session_update(session_id, s.SessionUpdateNotice(severity="error",
                            title="Session needs attention", description="Open HQ or the original terminal. No action was retried or permission granted."))
                    reported = True
        finally:
            self.observation_failed(attached)

    async def form(self, session_id, message, properties, *, required=None):
        elicitation = self.client_capabilities.elicitation
        if elicitation is None or elicitation.form is None:
            raise failure("This client cannot show the session's question. Answer it in HQ or the original terminal.")
        response = await self.conn.create_elicitation(message, s.ElicitationFormSessionMode(
            session_id=session_id, requested_schema=s.ElicitationSchema(
                properties=properties, required=list(properties) if required is None else required)))
        if response.action != "accept":
            raise ControlDeclined(-32000, "Question left unanswered; the existing session is still waiting.")
        return response.content or {}

    @staticmethod
    def control_identity(row):
        control = row.get("native_control")
        menu = row.get("menu")
        key = control.get("request_id") if control else menu.get("signature") if menu else None
        return key or (row["revision"] if menu else None)

    async def handle_control(self, session_id, row, attached):
        control = row.get("native_control")
        menu = row.get("menu")
        key = self.control_identity(row)
        if key is None or key in attached.controls:
            return
        attached.controls.add(key)
        try:
            await self.answer_control(session_id, row, control, menu)
        except ControlDeclined:
            return
        except InvalidAnswer as exc:
            attached.controls.discard(key)
            await self.conn.session_update(session_id, s.SessionUpdateNotice(severity="warning",
                title="Answer needs correction", description=str(exc)))
        except ActionRejected:
            attached.controls.discard(key)
            await self.conn.session_update(session_id, s.SessionUpdateNotice(severity="warning",
                title="Answer was not delivered", description="Review the current session request and answer it again."))

    async def answer_control(self, session_id, row, control, menu):
        if control:
            if control.get("subtype") == "request_user_dialog":
                raise failure("This native dialog requires HQ or the original terminal; no permission was granted.")
            response = {"request_id": control["request_id"]}
            if control.get("tool_name") == "AskUserQuestion":
                questions = control.get("input", {}).get("questions", [])
                if not questions:
                    raise failure("The session question is malformed; answer it in HQ.")
                properties, required = {}, []
                for i, question in enumerate(questions):
                    key = f"answer_{i}"
                    options = [{"const": option["label"], "title": option["label"],
                                **({"description": option["description"]} if option.get("description") else {})}
                               for option in question.get("options", [])]
                    properties[key] = {"type": "string", "title": question["question"]}
                    if options:
                        if question.get("multiSelect"):
                            options.append({"const": other_choice([option["const"] for option in options]),
                                            "title": "Other (custom answer)"})
                            properties[key].update(type="array", items={"anyOf": options}, minItems=1,
                                                   maxItems=len(options))
                        else:
                            properties[key]["oneOf"] = options
                        properties[key + "__other"] = {"type": "string", "title": "Other"}
                    else:
                        required.append(key)
                answers = await self.form(session_id, "Answer the existing session's questions", properties,
                                          required=required)
                resolved = {}
                for i, question in enumerate(questions):
                    value, other = answers.get(f"answer_{i}"), answers.get(f"answer_{i}__other", "")
                    selected = [] if value is None else value if isinstance(value, list) else [value]
                    options = [option["label"] for option in question.get("options", [])]
                    if options and question.get("multiSelect") and other_choice(options) in selected:
                        if not isinstance(other, str) or not other.strip():
                            raise InvalidAnswer("Write your Other answer.")
                        selected = [choice for choice in selected if choice != other_choice(options)]
                    if (not isinstance(other, str) or any(not isinstance(v, str) or not v.strip() for v in selected)
                            or options and any(v not in options for v in selected)
                            or not question.get("multiSelect") and len(selected) + bool(other.strip()) > 1):
                        raise InvalidAnswer("Choose valid options or provide an explicit Other answer.")
                    text = ", ".join([*selected, *([other.strip()] if other.strip() else [])])
                    if not text.strip():
                        raise InvalidAnswer("Every question needs an answer.")
                    resolved[question.get("id") or question["question"]] = text
                response.update(behavior="allow", updated_input={**control["input"], "answers": resolved})
            else:
                call = s.ToolCallUpdate(tool_call_id=control["request_id"], title=control.get("tool_name", "Permission"),
                                       kind="other", status="pending", raw_input=control.get("input", {}))
                await self.conn.session_update(session_id, s.ToolCallProgress.model_validate(call.model_dump()))
                permission = await self.conn.request_permission(session_id, call,
                    [s.PermissionOption(option_id="allow", name="Allow once", kind="allow_once"),
                     s.PermissionOption(option_id="deny", name="Deny", kind="reject_once")])
                allowed = permission.outcome.outcome == "selected" and permission.outcome.option_id == "allow"
                response.update(behavior="allow" if allowed else "deny")
                if allowed:
                    response["updated_input"] = control.get("input", {})
            await self.hq.action(session_id, "respond", revision=row["revision"], response=response)
        elif menu:
            if menu.get("multi_select") or any(option.get("kind") == "free_text" for option in menu.get("options", [])):
                raise failure("This terminal menu needs HQ or the original terminal; no choice was made.")
            options = menu.get("options", [])
            choices = {str(option["index"]): option["label"] for option in options}
            answer = await self.form(session_id, menu.get("question") or "Choose an option", {
                "choice": {"type": "string", "title": "Option", "enum": list(choices),
                           "enumNames": list(choices.values())}})
            if answer.get("choice") not in choices:
                raise InvalidAnswer("No valid option selected.")
            await self.hq.action(session_id, "select", revision=row["revision"], index=int(answer["choice"]))

    async def prompt(self, session_id, prompt, **kwargs):
        attached = self.sessions.get(session_id)
        if attached is None:
            raise failure("Choose List sessions on the CC fleet provider and import an existing session first.")
        if attached.pending:
            raise failure("A submitted prompt is still being observed for this session.")
        if any(not isinstance(block, s.TextContentBlock) for block in prompt):
            raise failure("Fleet sessions currently accept text prompts only.")
        text = "\n".join(block.text for block in prompt).strip()
        if not text or len(text.encode("utf-8")) > 16384:
            raise failure("The prompt must contain between 1 and 16384 UTF-8 bytes.")
        async with attached.lock:
            if attached.pending:
                raise failure("A submitted prompt is still being observed for this session.")
            row = await self.hq.detail(session_id)
            await self.emit_messages(session_id, row, attached)
            if not available(row):
                raise ActionRejected("This fleet session is offline or ended; it cannot be controlled.")
            if row.get("native_control") or row.get("menu"):
                raise failure("The existing session has an unanswered request. Answer it before sending another prompt.")
            attached.pending = text
            attached.completion = asyncio.get_running_loop().create_future()
            attached.own_user_key = None
            attached.request_id = None
            attached.source_message_id = None
            app_message_id = kwargs.get("t3.codes/messageId")
            attached.prompt_message_id = app_message_id if isinstance(app_message_id, str) and app_message_id else None
            attached.echoed = attached.answered = attached.cancelled = attached.cancel_attempted = False
            attached.settled = 0
            attached.prompt_started = time.monotonic()
            completion = attached.completion
            try:
                receipt = await self.hq.action(session_id, "send", text=text)
                attached.request_id = receipt.get("request_id")
                attached.source_message_id = receipt.get("source_message_id")
                if (self.external_session and attached.prompt_message_id
                        and (receipt.get("ok") is True or receipt.get("accepted") is True)):
                    await self.conn.session_update(session_id, s.SessionInfoUpdate(field_meta={
                        "t3.codes/externalSessionDispatch": {"version": 1,
                            "messageId": attached.prompt_message_id, "state": "accepted"}}))
            except ActionRejected:
                attached.pending = None
                completion.cancel()
                raise
            except BaseException:
                completion.cancel()
                raise
        try:
            return await asyncio.wait_for(asyncio.shield(completion), timeout=self.turn_timeout)
        except TimeoutError as exc:
            completion.cancel()
            raise failure("Observation timed out. The existing session continues; read it before sending again.") from exc

    async def cancel(self, session_id, **kwargs):
        attached = self.sessions.get(session_id)
        if attached is None or attached.cancel_attempted:
            return
        async with attached.lock:
            if attached.cancel_attempted:
                return
            attached.cancel_attempted = True
            try:
                await self.hq.action(session_id, "interrupt")
            except (RequestError, httpx.TransportError):
                await self.conn.session_update(session_id, s.SessionUpdateNotice(severity="error",
                    title="Stop was not confirmed", description="Check HQ or the original terminal before trying again. No action was retried."))
                return
            attached.cancelled = True

    async def ext_method(self, method, params):
        raise RequestError(-32601, "Method not supported")

    async def ext_notification(self, method, params):
        return None


async def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--hq-url", default=os.environ.get("CC_TMUX_HQ_URL", "http://127.0.0.1:8389"))
    parser.add_argument("--token-file", default=os.environ.get("CC_TMUX_HQ_TOKEN_FILE"))
    parser.add_argument("--mcp-url", default=os.environ.get("CC_PROXY_MCP_URL"))
    parser.add_argument("--mcp-token-file", default=os.environ.get("CC_TMUX_MCP_TOKEN_FILE"))
    parser.add_argument("--poll-interval", type=float, default=1)
    parser.add_argument("--turn-timeout", type=float, default=3600)
    args = parser.parse_args()
    token = Path(args.token_file).expanduser().read_text().strip() if args.token_file else os.environ.get("CC_TMUX_HQ_TOKEN", "")
    if not args.mcp_url or not args.mcp_token_file:
        parser.error("--mcp-url and --mcp-token-file are required for fleet discovery")
    mcp_token = Path(args.mcp_token_file).expanduser().read_text().strip()
    if not mcp_token:
        parser.error("MCP token file is empty")
    if args.poll_interval <= 0 or args.turn_timeout <= 0:
        parser.error("poll interval and turn timeout must be positive")
    hq = HQ(args.hq_url, token, mcp_url=args.mcp_url, mcp_token=mcp_token)
    try:
        await run_agent(FleetAgent(hq, poll_interval=args.poll_interval, turn_timeout=args.turn_timeout))
    finally:
        await hq.aclose()


if __name__ == "__main__":
    asyncio.run(main())
