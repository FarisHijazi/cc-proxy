#!/usr/bin/env python3
"""Launch an isolated Claude session with account-aware mitmproxy routing."""

import argparse
import hashlib
import json
import logging
import os
import re
import shutil
import signal
import socket
import ssl
import subprocess
import sys
import tempfile
import time
from pathlib import Path
from types import SimpleNamespace
from urllib.parse import urlsplit


def proxy_command(router, port, state, all_endpoints=False, chrome_manifest=None):
    url = urlsplit(router)
    if (
        url.scheme not in {"http", "https"}
        or url.hostname not in {"localhost", "127.0.0.1", "::1"}
        or url.username
        or url.password
        or url.query
        or url.fragment
        or url.path not in {"", "/"}
    ):
        raise ValueError("--router must be an http(s) loopback origin without a path")
    # This is mitmproxy's built-in URL mapper, not a custom HTTP implementation.
    # Match exact paths, retaining query parameters and rejecting lookalike paths.
    rule = (
        "@~m POST@^https://api\\.anthropic\\.com"
        "(?=/v1/messages(?:/count_tokens)?(?:\\?|$))@" + router.rstrip("/")
    )
    if all_endpoints:
        # CONNECT establishes the local TLS tunnel and must never be rewritten.
        # The router's fixed-origin account relay handles every non-model path.
        rule = "@!~m CONNECT@^https://api\\.anthropic\\.com(?=/|$)@" + router.rstrip(
            "/"
        )
    command = [
        "mitmdump",
        "--listen-host",
        "127.0.0.1",
        "--listen-port",
        str(port),
        "--set",
        f"confdir={state / 'ca'}",
        "--allow-hosts",
        r"^api\.anthropic\.com:443$",
        "--set",
        "connection_strategy=lazy",
        "--set",
        "upstream_cert=false",
        "--scripts",
        str(Path(__file__).resolve().with_name("account_router_stream.py")),
        "--set",
        "flow_detail=0",
        "--set",
        "termlog_verbosity=error",
        "--map-remote",
        rule,
    ]
    if chrome_manifest:
        command[command.index("--allow-hosts") + 1] = (
            r"^(api\.anthropic\.com|bridge\.claudeusercontent\.com):443$"
        )
        command += [
            "--scripts",
            str(Path(__file__).resolve().with_name("account_chrome_route.py")),
            "--set",
            f"chrome_account_manifest={chrome_manifest}",
        ]
    return command


def bootstrap_login(source, destination, secure_storage, source_secure_storage=None):
    """Read the current login without sharing its refresh grant with another CLI."""
    destination.mkdir(mode=0o700, parents=True, exist_ok=True)
    metadata = destination / ".claude.json"
    original = source / ".claude.json"
    if source == Path.home() / ".claude":
        original = Path.home() / ".claude.json"
    if original.exists():
        data = json.loads(original.read_text())
        update_account_metadata(metadata, data)
    raw = None
    credential_source = source_secure_storage or source
    if sys.platform == "darwin":
        suffix = (
            ""
            if credential_source == Path.home() / ".claude"
            else "-" + hashlib.sha256(str(credential_source).encode()).hexdigest()[:8]
        )
        result = subprocess.run(
            [
                "security",
                "find-generic-password",
                "-s",
                "Claude Code-credentials" + suffix,
                "-w",
            ],
            capture_output=True,
            text=True,
            check=False,
        )
        if result.returncode == 0:
            raw = result.stdout.strip()
    original = credential_source / ".credentials.json"
    if raw is None and original.exists():
        raw = original.read_text()
    if raw:
        data = json.loads(raw)
        oauth = data.get("claudeAiOauth")
        if oauth and oauth.get("accessToken"):
            # A rotating refresh grant must never be consumed by two profiles.
            # Keep the full scopes: setup-token's narrower scope breaks Chrome.
            write_access_token(secure_storage, oauth)


# Identity and per-account server caches (feature flags, plan, model access).
ACCOUNT_SCOPED = re.compile(r"^oauthAccount$|cache|subscription|tier|^s1m|penguin", re.I)


def update_account_metadata(path, source):
    """Mirror ~/.claude.json preferences; keep this profile's account-scoped keys."""
    own = json.loads(path.read_text()) if path.exists() else {}
    home = Path.home() / ".claude.json"
    prefs = json.loads(home.read_text()) if home.exists() else {}
    data = {k: v for k, v in prefs.items() if not ACCOUNT_SCOPED.search(k)}
    data.update({k: v for k, v in own.items() if ACCOUNT_SCOPED.search(k)})
    data.pop("oauthAccount", None)
    data.update(
        {
            k: source[k]
            for k in ("oauthAccount", "hasCompletedOnboarding", "theme")
            if k in source
        }
    )
    # Atomic replacement also preserves private mode when reusing a profile.
    with tempfile.NamedTemporaryFile(mode="w", dir=path.parent, delete=False) as handle:
        json.dump(data, handle)
    os.replace(handle.name, path)


def share_user_config(config):
    """Link ~/.claude into the client profile exactly as `cswap env` does."""
    from claude_swap.session import HISTORY_ITEMS, SessionManager, share_all_items
    from claude_swap.switcher import ClaudeAccountSwitcher

    # cswap never replaces a real entry; this profile is ours, so set aside the
    # copies Claude made before sharing (cswap merges history itself).
    aside = config.parent / f"pre-share-{int(time.time())}"
    for name in share_all_items(Path.home() / ".claude"):
        item = config / name
        if name not in HISTORY_ITEMS and item.exists() and not item.is_symlink():
            aside.mkdir(mode=0o700, exist_ok=True)
            item.rename(aside / name)
    SessionManager(ClaudeAccountSwitcher())._sync_sharing(
        config, share=True, share_all=True
    )


def write_access_token(destination, oauth):
    access_only = {k: v for k, v in oauth.items() if k != "refreshToken"}
    write_private(
        destination / ".credentials.json", json.dumps({"claudeAiOauth": access_only})
    )


def refresh_cswap_slot(slot, email, raw):
    """Spend an expired slot's grant through cswap's own consume gate."""
    from claude_swap.switcher import ClaudeAccountSwitcher

    switcher = ClaudeAccountSwitcher()
    # The live default login shares its grant with ~/.claude; only claude refreshes it.
    if switcher.current_account_number() == slot:
        raise ValueError(
            "selected cswap account is the active default login and its token has expired; run claude once to refresh it"
        )
    if switcher.consume_backup_grant(slot, email, raw).error is not None:
        raise ValueError(
            "cswap could not refresh the selected account; re-add it with cswap add"
        )


def bootstrap_cswap(slot, destination, secure_storage, refresh=True):
    """Reuse the switcher's credential owner without constructing a switcher."""
    try:
        from claude_swap import oauth
        from claude_swap.credentials import CredentialStore
        from claude_swap.models import Platform
        from claude_swap.paths import get_backup_root
    except ImportError as error:
        raise RuntimeError(
            "--cswap-account needs a Python environment with claude-swap installed"
        ) from error
    root = get_backup_root()
    sequence_path = root / "sequence.json"
    original = sequence_path.read_bytes()
    sequence = json.loads(original)
    account = sequence.get("accounts", {}).get(str(slot))
    if not account:
        raise ValueError("selected cswap account does not exist")
    host = SimpleNamespace(
        platform=Platform.detect(),
        _logger=logging.getLogger("account-router"),
        credentials_dir=root / "credentials",
    )
    raw = CredentialStore(host)._read_account_credentials(str(slot), account["email"])
    token = oauth.extract_oauth_data(raw) or {}
    if not token.get("accessToken") or "user:profile" not in token.get("scopes", []):
        raise ValueError(
            "selected cswap account needs a full claude.ai login with user:profile scope"
        )
    if oauth.is_oauth_token_expired(token.get("expiresAt")):
        if not refresh:
            raise ValueError(
                "selected cswap access token has expired; sign in using that account before relaunching"
            )
        refresh_cswap_slot(str(slot), account["email"], raw)
        return bootstrap_cswap(slot, destination, secure_storage, refresh=False)
    config = root / "configs" / f".claude-config-{slot}-{account['email']}.json"
    saved = json.loads(config.read_text()) if config.exists() else {}
    profile = saved.get("oauthAccount") or {
        "emailAddress": account["email"],
        "accountUuid": account["uuid"],
        "organizationUuid": account.get("organizationUuid"),
    }
    if profile.get("emailAddress") != account["email"]:
        raise ValueError(
            "cswap saved account metadata does not match selected credentials"
        )
    if sequence_path.read_bytes() != original:
        raise RuntimeError(
            "cswap accounts changed while taking the login snapshot; retry"
        )
    destination.mkdir(mode=0o700, parents=True, exist_ok=True)
    update_account_metadata(
        destination / ".claude.json",
        {"oauthAccount": profile, "hasCompletedOnboarding": True},
    )
    write_access_token(secure_storage, token)


def write_private(path, content):
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, "w") as handle:
        handle.write(content)


def account_selection(entries, accounts_file=None, main=None):
    """Resolve friendly account aliases; values are cswap slots or login directories."""
    saved = json.loads(accounts_file.read_text()) if accounts_file else {}
    if accounts_file and (
        not isinstance(saved, dict)
        or not isinstance(saved.get("accounts"), dict)
        or not saved["accounts"]
    ):
        raise ValueError("--accounts-file must contain a nonempty accounts object")
    accounts = dict(saved.get("accounts", {}))
    for entry in entries:
        alias, separator, source = entry.partition("=")
        if not separator:
            raise ValueError("--account expects ALIAS=SLOT or ALIAS=/login/directory")
        accounts[alias] = source
    normalized = {}
    for alias, source in accounts.items():
        if alias.casefold() in {name.casefold() for name in normalized}:
            raise ValueError("account aliases must differ beyond letter case")
        if not re.fullmatch(r"[A-Za-z][A-Za-z0-9_-]{0,23}", alias):
            raise ValueError(
                "account aliases need 1-24 letters, digits, underscores or hyphens"
            )
        if isinstance(source, bool) or not isinstance(source, (int, str)):
            raise TypeError(
                "account sources must be a cswap slot or an absolute login directory"
            )
        if str(source).isdigit() and int(source) > 0:
            normalized[alias] = int(source)
        elif isinstance(source, str) and Path(source).expanduser().is_absolute():
            # Claude hashes the exported spelling for its Keychain service.
            # Resolve destinations for safety, but preserve source symlinks.
            normalized[alias] = Path(source).expanduser().absolute()
        else:
            raise ValueError(
                "account sources must be a positive cswap slot or an absolute login directory"
            )
    selected = main or saved.get("main") or next(iter(normalized), None)
    if selected is not None and selected not in normalized:
        raise ValueError("--main-account must name a configured account alias")
    return normalized, selected


def snapshot_accounts(accounts, main, state, login):
    """Snapshot main first; unavailable secondary accounts remain explicit."""
    manifest = {
        "main": main,
        "accounts": {},
        "claude": shutil.which("claude") or "claude",
    }
    for alias in [main, *(name for name in accounts if name != main)]:
        root = login / alias
        secure = root / "secure"
        secure.mkdir(mode=0o700, parents=True)
        config = state / "claude" if alias == main else root / "config"
        try:
            source = accounts[alias]
            if isinstance(source, int):
                bootstrap_cswap(source, config, secure)
            else:
                bootstrap_login(source, config, secure)
                credential = json.loads((secure / ".credentials.json").read_text())
                token = credential.get("claudeAiOauth", {})
                if "user:profile" not in token.get("scopes", []):
                    raise ValueError("login needs user:profile scope")
                if token.get("expiresAt", 0) <= time.time() * 1000:
                    raise ValueError("access token expired; renew the source login")
            manifest["accounts"][alias] = {
                "config_dir": str(config),
                "secure_storage_dir": str(secure),
            }
        except (OSError, ValueError, TypeError, AttributeError, RuntimeError):
            if alias == main:
                raise
            message = "source login unavailable, expired, or missing full account scopes; renew it and relaunch"
            manifest["accounts"][alias] = {"error": message}
            print(f"Account {alias}: {message}", file=sys.stderr)
    return manifest


def aggregate_mcp(login, manifest, forwarded):
    """Add shared tools while retaining the main account's native Chrome UI."""
    manifest_path = login / "accounts.json"
    write_private(manifest_path, json.dumps(manifest))
    servers = {}
    for name, script in (
        ("account-chrome", "account_chrome.py"),
        ("account-artifacts", "account_artifacts.py"),
    ):
        # An explicit native account uses the built-in MCP server end-to-end.
        # Avoid routing an aggregate child for main into that chosen account.
        if name == "account-chrome" and manifest.get("chrome_account"):
            continue
        servers[name] = {
            "type": "stdio",
            "command": shutil.which("uv") or "uv",
            "args": [
                "run",
                "--script",
                str(Path(__file__).resolve().with_name(script)),
                "--manifest",
                str(manifest_path),
            ],
        }
    config_path = login / "mcp.json"
    write_private(config_path, json.dumps({"mcpServers": servers}))
    # Claude reserves claude-in-chrome for its built-in server. Keep that UI
    # on main; the additional server exposes cross-account browser tools.
    args = list(forwarded)
    if not {"--chrome", "--no-chrome"}.intersection(args):
        args.append("--chrome")
    return [*args, "--mcp-config", str(config_path)]


def client_environment(state, port, secure_storage):
    env = os.environ.copy()
    settings_env = {
        "ANTHROPIC_BASE_URL": "https://api.anthropic.com",
        "HTTPS_PROXY": f"http://127.0.0.1:{port}",
        "HTTP_PROXY": f"http://127.0.0.1:{port}",
        "NO_PROXY": "127.0.0.1,localhost,::1",
        "NODE_EXTRA_CA_CERTS": str(state / "client-ca.pem"),
        "SSL_CERT_FILE": str(state / "client-ca.pem"),
        "REQUESTS_CA_BUNDLE": str(state / "client-ca.pem"),
    }
    for name in (
        "https_proxy",
        "http_proxy",
        "CLAUDE_CODE_HTTPS_PROXY",
        "CLAUDE_CODE_HTTP_PROXY",
    ):
        settings_env[name] = settings_env["HTTPS_PROXY"]
    settings_env["no_proxy"] = settings_env["NO_PROXY"]
    # An API credential selects API-key auth even when a subscription is saved.
    # Empty strings in CLI settings also override project settings for this run.
    for key in (
        "ANTHROPIC_API_KEY",
        "ANTHROPIC_AUTH_TOKEN",
        "CLAUDE_CODE_OAUTH_TOKEN",
        "ANTHROPIC_UNIX_SOCKET",
        "CLAUDE_CODE_USE_BEDROCK",
        "CLAUDE_CODE_USE_VERTEX",
        "CLAUDE_CODE_USE_FOUNDRY",
        "CLAUDE_CODE_USE_MANTLE",
        "CLAUDE_CODE_USE_ANTHROPIC_AWS",
        "CLAUDE_CODE_USE_ANTHROPIC_GOOGLE_CLOUD",
        "DISABLE_TELEMETRY",
        "DO_NOT_TRACK",
        "DISABLE_GROWTHBOOK",
        "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC",
    ):
        env.pop(key, None)
        settings_env[key] = ""
    for key in (
        "CLAUDE_CODE_OAUTH_TOKEN_FILE_DESCRIPTOR",
        "CLAUDE_CODE_API_KEY_FILE_DESCRIPTOR",
        "CLAUDE_CODE_GATEWAY_TOKEN_FILE_DESCRIPTOR",
        "CLAUDE_CODE_WEBSOCKET_AUTH_FILE_DESCRIPTOR",
        "CLAUDE_CODE_HOST_CREDS_FILE",
        "CLAUDE_CODE_HOST_AUTH_ENV_VAR",
        "CLAUDE_CODE_PROVIDER_MANAGED_BY_HOST",
        "CLAUDE_CODE_ACCOUNT_UUID",
        "CLAUDE_CODE_ORGANIZATION_UUID",
        "CLAUDE_CODE_SESSION_ACCESS_TOKEN",
        "CLAUDE_CODE_REMOTE_SESSION_ID",
        "SESSION_INGRESS_URL",
        "CLAUDE_CODE_OAUTH_REFRESH_TOKEN",
    ):
        env.pop(key, None)
    env.update(settings_env)
    env["CLAUDE_CONFIG_DIR"] = str(state / "claude")
    # Keep secure storage isolated too, including when the parent pinned it.
    env["CLAUDE_SECURESTORAGE_CONFIG_DIR"] = str(secure_storage)
    return env, json.dumps(
        {"env": settings_env, "apiKeyHelper": ""}
    )


def certificate_bundle(ca):
    """Retain public/custom trust when Python tools inherit our HTTPS proxy."""
    context = ssl.create_default_context()
    for name in ("NODE_EXTRA_CA_CERTS", "REQUESTS_CA_BUNDLE"):
        source = os.environ.get(name)
        if source:
            context.load_verify_locations(
                **{"capath" if Path(source).is_dir() else "cafile": source}
            )
    public_roots = b"".join(
        ssl.DER_cert_to_PEM_cert(cert).encode()
        for cert in context.get_ca_certs(binary_form=True)
    )
    return public_roots + b"\n" + ca.read_bytes()


def wait_listener(process, port, log_path, certificate=None):
    deadline = time.monotonic() + 15
    while True:
        if process.poll() is not None:
            raise RuntimeError(f"process exited; inspect {log_path}")
        try:
            with socket.create_connection(("127.0.0.1", port), timeout=0.2):
                if certificate is None or certificate.exists():
                    return
        except OSError:
            pass
        if time.monotonic() >= deadline:
            raise RuntimeError(f"listener startup timed out; inspect {log_path}")
        time.sleep(0.05)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--router", default="http://127.0.0.1:18765")
    parser.add_argument(
        "--start-router",
        action="store_true",
        help="start a private claude-codex server for this session and proxy all endpoints",
    )
    parser.add_argument(
        "--all-endpoints",
        action="store_true",
        help="send all api.anthropic.com endpoints through a router with account-relay support",
    )
    parser.add_argument(
        "--port", type=int, default=0, help="forward proxy port (default: random)"
    )
    parser.add_argument(
        "--state-dir",
        type=Path,
        default=Path.home() / ".local/state/claude-codex/account-router",
    )
    login_source = parser.add_mutually_exclusive_group()
    login_source.add_argument("--login-from", type=Path)
    login_source.add_argument(
        "--cswap-account",
        type=int,
        help="read a saved full-scope account using claude-swap (optional dependency)",
    )
    parser.add_argument(
        "--account",
        action="append",
        default=[],
        metavar="ALIAS=SOURCE",
        help="aggregate a cswap slot or absolute login directory (repeatable)",
    )
    parser.add_argument(
        "--accounts-file",
        type=Path,
        help='JSON account map: {"main":"work","accounts":{"work":2,"personal":1}}',
    )
    parser.add_argument(
        "--main-account",
        help="alias owning Remote Control and default account features",
    )
    parser.add_argument(
        "--chrome-account",
        help="account alias for native /chrome, independent of main (replaces aggregate Chrome tools for this session)",
    )
    parser.add_argument(
        "--remote-control-backend", help="HQ origin for native Remote Control"
    )
    parser.add_argument(
        "--remote-control-key-file",
        type=Path,
        help="Private HQ native registration key (never an Anthropic token)",
    )
    parser.add_argument(
        "claude_args", nargs=argparse.REMAINDER, help="Claude arguments after --"
    )
    args = parser.parse_args()
    if bool(args.remote_control_backend) != bool(args.remote_control_key_file):
        parser.error(
            "--remote-control-backend and --remote-control-key-file are required together"
        )
    accounts, main_account = account_selection(
        args.account, args.accounts_file, args.main_account
    )
    if args.chrome_account and args.chrome_account not in accounts:
        parser.error("--chrome-account must name a configured account alias")
    if accounts and (args.cswap_account is not None or args.login_from is not None):
        parser.error(
            "--account/--accounts-file replaces --cswap-account and --login-from"
        )
    state = args.state_dir.expanduser().resolve()
    if accounts:
        state = state / "accounts" / main_account
    protected = (Path.home() / ".claude").resolve()
    managed_paths = [state, state / "claude", state / "ca", state / "client-ca.pem"]
    if any(
        path.resolve() == protected or protected in path.resolve().parents
        for path in managed_paths
    ):
        parser.error("--state-dir must be outside ~/.claude")
    forwarded = (
        args.claude_args[1:] if args.claude_args[:1] == ["--"] else args.claude_args
    )
    if any(a == "--settings" or a.startswith("--settings=") for a in forwarded):
        parser.error(
            "--settings is managed by this launcher; use an isolated settings.json instead"
        )
    if forwarded[:1] == ["remote-control"]:
        parser.error(
            "use -- --remote-control for an interactive session; server mode cannot carry CLI settings"
        )
    if args.chrome_account and "--no-chrome" in forwarded:
        parser.error("--chrome-account cannot be combined with --no-chrome")
    os.umask(0o077)
    state.mkdir(mode=0o700, parents=True, exist_ok=True)
    # A shared CA is fine; each invocation has a separate listener and log.
    with socket.socket() as candidate:
        candidate.bind(("127.0.0.1", args.port))
        port = candidate.getsockname()[1]
    router_port = None
    if args.start_router:
        with socket.socket() as candidate:
            candidate.bind(("127.0.0.1", 0))
            router_port = candidate.getsockname()[1]
        args.router = f"http://127.0.0.1:{router_port}"
        args.all_endpoints = True
    command = proxy_command(args.router, port, state, args.all_endpoints)
    login = tempfile.TemporaryDirectory(prefix="login-", dir=state)
    main_secure = Path(login.name)
    if accounts:
        manifest = snapshot_accounts(accounts, main_account, state, Path(login.name))
        if args.chrome_account:
            if "error" in manifest["accounts"][args.chrome_account]:
                raise ValueError(
                    "selected Chrome account is unavailable; renew its full source login"
                )
            manifest["chrome_account"] = args.chrome_account
        main_secure = Path(manifest["accounts"][main_account]["secure_storage_dir"])
        forwarded = aggregate_mcp(Path(login.name), manifest, forwarded)
        if args.chrome_account:
            command = proxy_command(
                args.router,
                port,
                state,
                args.all_endpoints,
                Path(login.name) / "accounts.json",
            )
            print(f"Native Chrome account: {args.chrome_account}", file=sys.stderr)
        print(
            f"Main account: {main_account} (Remote Control and default account features)",
            file=sys.stderr,
        )
    elif args.cswap_account is not None:
        bootstrap_cswap(args.cswap_account, state / "claude", Path(login.name))
    else:
        source = args.login_from or Path(
            os.environ.get("CLAUDE_CONFIG_DIR", str(Path.home() / ".claude"))
        )
        secure_source = None
        if args.login_from is None and "CLAUDE_SECURESTORAGE_CONFIG_DIR" in os.environ:
            secure_source = Path(
                os.environ["CLAUDE_SECURESTORAGE_CONFIG_DIR"]
                or str(Path.home() / ".claude")
            )
        bootstrap_login(
            source.expanduser().absolute(),
            state / "claude",
            Path(login.name),
            secure_source,
        )
    share_user_config(state / "claude")
    if args.remote_control_backend:
        command += [
            "--scripts",
            str(Path(__file__).resolve().with_name("account_remote_route.py")),
            "--set",
            "hq_remote_origin=" + args.remote_control_backend,
            "--set",
            "hq_remote_key_file="
            + str(args.remote_control_key_file.expanduser().resolve()),
        ]
        if "--remote-control" not in forwarded:
            forwarded.append("--remote-control")
        print("Native Remote Control → " + args.remote_control_backend, file=sys.stderr)
    with (state / f"proxy-{port}.log").open("w") as log:
        proxy = subprocess.Popen(command, stdout=log, stderr=log)
        client = None
        model_router = None
        try:

            def stop(_signum, _frame):
                if client and client.poll() is None:
                    client.terminate()
                raise KeyboardInterrupt

            signal.signal(signal.SIGTERM, stop)
            if args.start_router:
                router_env = os.environ.copy()
                router_env["CCP_BIND_ADDRESS"] = "127.0.0.1"
                router_env["CCP_TRAFFIC_LOG"] = "0"
                model_router = subprocess.Popen(
                    [
                        "claude-codex",
                        "serve",
                        "--no-monitor",
                        "--port",
                        str(router_port),
                    ],
                    env=router_env,
                    stdout=log,
                    stderr=log,
                )
                wait_listener(model_router, router_port, log.name)
            ca = state / "ca/mitmproxy-ca-cert.pem"
            wait_listener(proxy, port, log.name, ca)
            (state / "client-ca.pem").write_bytes(certificate_bundle(ca))
            env, settings = client_environment(state, port, main_secure)
            print(
                f"Inference → {args.router}; account → {'router → Anthropic' if args.all_endpoints else 'Anthropic'}; config: {state / 'claude'} (shares ~/.claude)",
                file=sys.stderr,
            )
            client = subprocess.Popen(
                ["claude", "--settings", settings, *forwarded], env=env
            )
            return client.wait()
        finally:
            for process in (client, proxy, model_router):
                if process is not None and process.poll() is None:
                    process.terminate()
                    try:
                        process.wait(timeout=5)
                    except subprocess.TimeoutExpired:
                        process.kill()
                        process.wait()
            login.cleanup()


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
    except (OSError, ValueError, TypeError, RuntimeError) as error:
        print(f"error: {error}", file=sys.stderr)
        sys.exit(1)
