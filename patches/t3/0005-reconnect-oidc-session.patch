@@ -0,0 +1,50 @@
+import type { EnvironmentId } from "@t3tools/contracts";
+import type { SupervisorConnectionState } from "@t3tools/client-runtime/connection";
+
+export function createPrimaryOidcConnectionRecovery(input: {
+  readonly refresh: () => Promise<void>;
+  readonly retry: (environmentId: EnvironmentId) => Promise<void>;
+}) {
+  let enabled = false;
+  let currentId: EnvironmentId | null = null;
+  let currentState: SupervisorConnectionState | null = null;
+  let epoch = 0;
+  let attempted = false;
+  const blockedByAuthentication = () =>
+    currentState?.phase === "blocked" &&
+    currentState.lastFailure?._tag === "ConnectionBlockedError" &&
+    currentState.lastFailure.reason === "authentication";
+  const recover = async () => {
+    if (!enabled || currentId === null || attempted || !blockedByAuthentication()) return;
+    const id = currentId;
+    const attemptEpoch = epoch;
+    attempted = true;
+    try {
+      await input.refresh();
+      if (enabled && epoch === attemptEpoch && currentId === id && blockedByAuthentication())
+        await input.retry(id);
+    } catch (error) {
+      if (epoch === attemptEpoch) attempted = false;
+      throw error;
+    }
+  };
+  return {
+    recover,
+    setEnabled: async (value: boolean) => {
+      enabled = value;
+      await recover();
+    },
+    observe: async (id: EnvironmentId | null, state: SupervisorConnectionState | null) => {
+      if (
+        id !== currentId ||
+        (state?.phase === "connected" && currentState?.phase !== "connected")
+      ) {
+        epoch += 1;
+        attempted = false;
+      }
+      currentId = id;
+      currentState = state;
+      await recover();
+    },
+  };
+}
