@@ -0,0 +1,218 @@
+import { expect, it } from "@effect/vitest";
+import { EnvironmentId } from "@t3tools/contracts";
+import {
+  ConnectionBlockedError,
+  PrimaryConnectionTarget,
+  Connectivity,
+  Wakeups,
+} from "@t3tools/client-runtime/connection";
+import { ConnectionDriver as Driver } from "@t3tools/client-runtime/connection";
+import { EnvironmentSupervisor as Supervisor } from "@t3tools/client-runtime/connection";
+import type { RpcSession } from "@t3tools/client-runtime/rpc";
+import * as Deferred from "effect/Deferred";
+import * as Effect from "effect/Effect";
+import * as Fiber from "effect/Fiber";
+import * as Layer from "effect/Layer";
+import * as Option from "effect/Option";
+import * as Ref from "effect/Ref";
+import * as Queue from "effect/Queue";
+import * as Stream from "effect/Stream";
+import * as SubscriptionRef from "effect/SubscriptionRef";
+import { createPrimaryOidcConnectionRecovery } from "./oidcConnectionRecovery";
+
+const target = new PrimaryConnectionTarget({
+  environmentId: EnvironmentId.make("primary"),
+  label: "Server",
+  httpBaseUrl: "https://server.example.test",
+  wsBaseUrl: "wss://server.example.test",
+});
+const denied = () =>
+  new ConnectionBlockedError({
+    reason: "authentication",
+    detail: "The prior browser credential was rejected.",
+  });
+const harness = Effect.fn("OidcRecoveryTest.harness")(function* (lateFailure = false) {
+  let cookieAccepted = false;
+  const attempts = yield* Ref.make(0);
+  const staleAttempt = yield* Deferred.make<void>();
+  const started = yield* Deferred.make<void>();
+  const closedSessions = yield* Ref.make<Array<Deferred.Deferred<never, ConnectionBlockedError>>>(
+    [],
+  );
+  const supervisor = yield* Supervisor.make(
+    { target, profile: Option.none(), enabled: true },
+    { initiallyDesired: true },
+  ).pipe(
+    Effect.provide(
+      Layer.mergeAll(
+        Layer.succeed(Connectivity.Connectivity, {
+          status: Effect.succeed("online" as const),
+          changes: Stream.never,
+        }),
+        Wakeups.layer({ changes: Stream.never }),
+        Layer.succeed(Driver.ConnectionDriver, {
+          connect: Effect.fn("OidcRecoveryTest.connect")(function* () {
+            const attempt = yield* Ref.updateAndGet(attempts, (value) => value + 1);
+            const acceptedAtStart = cookieAccepted;
+            yield* Deferred.succeed(started, undefined);
+            if (lateFailure && attempt === 1) yield* Deferred.await(staleAttempt);
+            if (!acceptedAtStart) return yield* denied();
+            const closed = yield* Deferred.make<never, ConnectionBlockedError>();
+            yield* Ref.update(closedSessions, (sessions) => [...sessions, closed]);
+            return {
+              prepared: {
+                environmentId: target.environmentId,
+                label: target.label,
+                target,
+                httpBaseUrl: target.httpBaseUrl,
+                socketUrl: `${target.wsBaseUrl}/ws`,
+                httpAuthorization: null,
+              },
+              session: {
+                client: {} as RpcSession["client"],
+                initialConfig: Effect.never,
+                subscribeServerConfig: () => Stream.never,
+                ready: Effect.void,
+                probe: Effect.void,
+                inboundFrames: Effect.succeed(0),
+                closed: Deferred.await(closed),
+              },
+            };
+          }),
+          preflight: () => Effect.succeed("unchecked"),
+          checkHost: () => Effect.succeed("unchecked"),
+        }),
+      ),
+    ),
+  );
+  const state = (phase: string) =>
+    SubscriptionRef.changes(supervisor.state).pipe(
+      Stream.filter((value) => value.phase === phase),
+      Stream.runHead,
+      Effect.map(Option.getOrThrow),
+    );
+  const retryRequests = yield* Queue.unbounded<() => void>();
+  yield* Queue.take(retryRequests).pipe(
+    Effect.flatMap((complete) => supervisor.retryNow.pipe(Effect.andThen(Effect.sync(complete)))),
+    Effect.forever,
+    Effect.forkScoped,
+  );
+  let refreshes = 0;
+  const recovery = createPrimaryOidcConnectionRecovery({
+    refresh: async () => {
+      refreshes += 1;
+      cookieAccepted = true;
+    },
+    retry: () =>
+      new Promise<void>((resolve) => {
+        Queue.offerUnsafe(retryRequests, resolve);
+      }),
+  });
+  yield* SubscriptionRef.changes(supervisor.state).pipe(
+    Stream.runForEach((value) =>
+      Effect.promise(() => recovery.observe(target.environmentId, value)),
+    ),
+    Effect.forkScoped,
+  );
+  return {
+    supervisor,
+    state,
+    attempts,
+    started,
+    staleAttempt,
+    recovery,
+    expireSession: Ref.get(closedSessions).pipe(
+      Effect.flatMap((sessions) => Deferred.fail(sessions.at(-1)!, denied())),
+    ),
+    acceptCookie: () => {
+      cookieAccepted = true;
+    },
+    refreshes: () => refreshes,
+  };
+});
+
+it.effect("recovers the existing auth-blocked supervisor when the sign-in callback completes", () =>
+  Effect.gen(function* () {
+    const h = yield* harness();
+    yield* h.state("blocked");
+    expect(yield* Ref.get(h.attempts)).toBe(1);
+    h.acceptCookie();
+    yield* Effect.promise(() => h.recovery.setEnabled(true));
+    yield* h.state("connected");
+    expect(yield* Ref.get(h.attempts)).toBe(2);
+  }).pipe(Effect.scoped),
+);
+
+it.effect(
+  "recovers when callback success precedes a late rejection of the old in-flight credential",
+  () =>
+    Effect.gen(function* () {
+      const h = yield* harness(true);
+      yield* Deferred.await(h.started);
+      h.acceptCookie();
+      yield* Effect.promise(() => h.recovery.setEnabled(true));
+      yield* Deferred.succeed(h.staleAttempt, undefined);
+      yield* h.state("connected");
+      expect(yield* Ref.get(h.attempts)).toBe(2);
+    }).pipe(Effect.scoped),
+);
+
+it("bounds retries until a connection succeeds and ignores unrelated failures and healthy sockets", async () => {
+  let retries = 0;
+  const recovery = createPrimaryOidcConnectionRecovery({
+    refresh: async () => {},
+    retry: async () => {
+      retries += 1;
+    },
+  });
+  const base = {
+    desired: true,
+    network: "online" as const,
+    phase: "blocked" as const,
+    stage: null,
+    attempt: 1,
+    generation: 0,
+    retryAt: null,
+    lastFailure: denied(),
+  };
+  await recovery.setEnabled(true);
+  await recovery.observe(target.environmentId, {
+    ...base,
+    lastFailure: new ConnectionBlockedError({ reason: "permission", detail: "Forbidden." }),
+  });
+  expect(retries).toBe(0);
+  await recovery.observe(target.environmentId, base);
+  await recovery.recover();
+  await recovery.observe(target.environmentId, { ...base, attempt: 2 });
+  expect(retries).toBe(1);
+  await recovery.observe(target.environmentId, {
+    ...base,
+    phase: "connected",
+    stage: null,
+    lastFailure: null,
+  });
+  await recovery.recover();
+  expect(retries).toBe(1);
+  await recovery.observe(target.environmentId, base);
+  expect(retries).toBe(2);
+});
+
+it.effect(
+  "recovers after refresh revokes an established socket without disturbing a healthy connection",
+  () =>
+    Effect.gen(function* () {
+      const h = yield* harness();
+      yield* h.state("blocked");
+      yield* Effect.promise(() => h.recovery.setEnabled(true));
+      const connected = yield* h.state("connected");
+      yield* Effect.promise(() => h.recovery.observe(target.environmentId, connected));
+      yield* Effect.promise(() => h.recovery.recover());
+      expect(yield* Ref.get(h.attempts)).toBe(2);
+      const reconnected = yield* h
+        .state("blocked")
+        .pipe(Effect.andThen(h.state("connected")), Effect.forkChild);
+      yield* h.expireSession;
+      yield* Fiber.join(reconnected);
+      expect(yield* Ref.get(h.attempts)).toBe(3);
+    }).pipe(Effect.scoped),
+);
