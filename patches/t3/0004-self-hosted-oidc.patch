+      return bootstrapServerAuth(null);
+    }
     const currentSession = await fetchSessionState();
     return { status: "requires-auth", auth: currentSession.auth };
   }
diff --git a/apps/web/src/environments/primary/oidc.test.ts b/apps/web/src/environments/primary/oidc.test.ts
new file mode 100644
index 00000000..21c3b154
--- /dev/null
+++ b/apps/web/src/environments/primary/oidc.test.ts
@@ -0,0 +1,175 @@
+import { beforeEach, afterEach, describe, expect, it, vi } from "vite-plus/test";
+import {
+  __resetPrimaryOidcForTests,
+  beginPrimaryOidcSignIn,
+  completePrimaryOidcSignIn,
+  primaryOidcReturnTo,
+  PrimaryOidcSignInRequiredError,
+  refreshPrimaryOidcSession,
+  signOutPrimaryOidc,
+} from "./oidc";
+
+vi.mock("./target", () => ({
+  resolvePrimaryEnvironmentHttpUrl: (path: string) => `https://workspace.example.test${path}`,
+}));
+
+function storage() {
+  const values = new Map<string, string>();
+  return {
+    values,
+    getItem: (key: string) => values.get(key) ?? null,
+    setItem: (key: string, value: string) => {
+      values.set(key, value);
+    },
+    removeItem: (key: string) => {
+      values.delete(key);
+    },
+  };
+}
+
+function browser(path = "/threads/test") {
+  const sessionStorage = storage();
+  const localStorage = storage();
+  const location = Object.assign(new URL(path, "https://workspace.example.test"), {
+    assign: vi.fn(),
+    replace: vi.fn(),
+  });
+  const history = { state: null, replaceState: vi.fn() };
+  vi.stubGlobal("window", { location, history, sessionStorage, localStorage });
+  return { location, history, sessionStorage, localStorage };
+}
+
+const tokens = { access_token: "test-access-token", token_type: "Bearer", expires_in: 900 };
+function serve() {
+  const request = vi.fn<typeof fetch>().mockImplementation(async (input) => {
+    const path = String(input);
+    if (path.endsWith("/config"))
+      return Response.json({
+        enabled: true,
+        providerName: "Example SSO",
+        authorizationPath: "/api/auth/oidc/authorize",
+      });
+    if (path.endsWith("/logout")) return new Response(null, { status: 204 });
+    return Response.json(tokens);
+  });
+  vi.stubGlobal("fetch", request);
+  return request;
+}
+
+describe("primary browser identity-provider sign-in", () => {
+  beforeEach(() => {
+    vi.useFakeTimers();
+    vi.setSystemTime(new Date("2026-01-01T00:00:00Z"));
+    vi.stubGlobal("navigator", {});
+    vi.stubGlobal("document", { title: "T3" });
+    __resetPrimaryOidcForTests();
+  });
+  afterEach(() => {
+    vi.useRealTimers();
+    vi.unstubAllGlobals();
+  });
+
+  it("binds sign-in to state and PKCE, consumes it once, and persists no browser token", async () => {
+    const page = browser();
+    const request = serve();
+    await beginPrimaryOidcSignIn();
+    const authorization = new URL(page.location.assign.mock.calls[0]![0]);
+    expect(authorization.origin).toBe(page.location.origin);
+    expect(authorization.searchParams.get("code_challenge_method")).toBe("S256");
+    expect(authorization.searchParams.get("code_challenge")).toHaveLength(43);
+    page.location.href = `https://workspace.example.test/auth/oidc/callback?code=test-code&state=${authorization.searchParams.get("state")}`;
+    await Promise.all([completePrimaryOidcSignIn(), completePrimaryOidcSignIn()]);
+    expect(request.mock.calls.filter(([url]) => String(url).endsWith("/token"))).toHaveLength(1);
+    const payload = JSON.parse(String(request.mock.calls.at(-1)![1]!.body));
+    expect(payload).toMatchObject({
+      grant_type: "authorization_code",
+      code: "test-code",
+      client_type: "browser",
+      redirect_uri: "https://workspace.example.test/auth/oidc/callback",
+    });
+    expect(payload.code_verifier).toHaveLength(43);
+    expect(page.history.replaceState).toHaveBeenCalledWith(null, "T3", "/auth/oidc/callback");
+    expect(page.sessionStorage.values.size).toBe(0);
+    expect([...page.localStorage.values.keys()]).toEqual(["t3:oidc:browser:expires"]);
+    expect(primaryOidcReturnTo()).toBe("/threads/test");
+    __resetPrimaryOidcForTests();
+    await expect(completePrimaryOidcSignIn()).rejects.toThrow("already been used");
+  });
+
+  it.each(["wrong-state", "duplicate-code", "expired", "different-origin"])(
+    "rejects %s before exchanging any credential",
+    async (invalid) => {
+      const page = browser();
+      const request = serve();
+      await beginPrimaryOidcSignIn();
+      const authorization = new URL(page.location.assign.mock.calls[0]![0]);
+      const state = authorization.searchParams.get("state");
+      page.location.href = `https://workspace.example.test/auth/oidc/callback?code=test-code&state=${invalid === "wrong-state" ? "wrong" : state}`;
+      if (invalid === "duplicate-code") page.location.search += "&code=another";
+      if (invalid === "expired") vi.advanceTimersByTime(11 * 60_000);
+      if (invalid === "different-origin") page.location.host = "attacker.example.test";
+      await expect(completePrimaryOidcSignIn()).rejects.toThrow();
+      expect(request.mock.calls.filter(([url]) => String(url).endsWith("/token"))).toHaveLength(0);
+    },
+  );
+
+  it("coalesces concurrent cookie renewal and retries transport failures without retaining credentials", async () => {
+    browser();
+    const request = serve();
+    await Promise.all([refreshPrimaryOidcSession(true), refreshPrimaryOidcSession(true)]);
+    expect(request).toHaveBeenCalledTimes(1);
+    expect(JSON.parse(String(request.mock.calls[0]![1]!.body))).toEqual({
+      grant_type: "refresh_token",
+      client_type: "browser",
+    });
+    await refreshPrimaryOidcSession();
+    expect(request).toHaveBeenCalledTimes(1);
+    request.mockRejectedValueOnce(new TypeError("offline"));
+    await expect(refreshPrimaryOidcSession(true)).rejects.toThrow("offline");
+    await refreshPrimaryOidcSession(true);
+    expect(request).toHaveBeenCalledTimes(3);
+    request.mockResolvedValueOnce(new Response(null, { status: 401 }));
+    await expect(refreshPrimaryOidcSession(true)).rejects.toBeInstanceOf(
+      PrimaryOidcSignInRequiredError,
+    );
+  });
+
+  it("fails closed if the server exposes a browser refresh credential and confirms logout before leaving", async () => {
+    const page = browser();
+    const request = serve();
+    request.mockResolvedValueOnce(Response.json({ ...tokens, refresh_token: "must-be-http-only" }));
+    await expect(refreshPrimaryOidcSession(true)).rejects.toThrow("invalid browser session");
+    expect(page.localStorage.values.size).toBe(0);
+    request.mockResolvedValueOnce(new Response(null, { status: 503 }));
+    await expect(signOutPrimaryOidc()).rejects.toThrow("Could not sign out");
+    expect(page.location.replace).not.toHaveBeenCalled();
+    await signOutPrimaryOidc();
+    expect(page.location.replace).toHaveBeenCalledWith("/pair");
+    await expect(refreshPrimaryOidcSession()).rejects.toBeInstanceOf(
+      PrimaryOidcSignInRequiredError,
+    );
+  });
+
+  it("releases a stalled renewal so a later attempt can recover", async () => {
+    browser();
+    const request = serve();
+    const abort = new AbortController();
+    using timeout = vi.spyOn(AbortSignal, "timeout").mockReturnValueOnce(abort.signal);
+    request.mockImplementationOnce(
+      (_url, init) =>
+        new Promise((_resolve, reject) => {
+          init!.signal!.addEventListener(
+            "abort",
+            () => reject(new DOMException("Timed out", "AbortError")),
+            { once: true },
+          );
+        }),
+    );
+    const stalled = expect(refreshPrimaryOidcSession(true)).rejects.toThrow("Timed out");
+    expect(timeout).toHaveBeenCalledWith(10_000);
+    abort.abort();
+    await stalled;
+    await refreshPrimaryOidcSession(true);
+    expect(request).toHaveBeenCalledTimes(2);
+  });
+});
diff --git a/apps/web/src/environments/primary/oidc.ts b/apps/web/src/environments/primary/oidc.ts
new file mode 100644
index 00000000..a96f1539
--- /dev/null
+++ b/apps/web/src/environments/primary/oidc.ts
@@ -0,0 +1,218 @@
+import { Oidc } from "@t3tools/client-runtime/authorization";
+import { AuthOidcConfig, AuthOidcTokenResult, type AuthOidcTokenInput } from "@t3tools/contracts";
+import * as Schema from "effect/Schema";
+
+import { resolvePrimaryEnvironmentHttpUrl } from "./target";
+
+export const OIDC_CALLBACK_PATH = "/auth/oidc/callback";
+const TRANSACTION_KEY = "t3:oidc:browser:transaction";
+export const PRIMARY_OIDC_EXPIRY_KEY = "t3:oidc:browser:expires";
+const Transaction = Schema.Struct({
+  verifier: Schema.String,
+  state: Schema.String,
+  redirectUri: Schema.String,
+  createdAt: Schema.Number,
+  returnTo: Schema.String,
+});
+const decodeTransaction = Schema.decodeUnknownSync(Transaction);
+const decodeConfig = Schema.decodeUnknownSync(AuthOidcConfig);
+const decodeTokenResult = Schema.decodeUnknownSync(AuthOidcTokenResult);
+let configPromise: Promise<AuthOidcConfig> | undefined;
+let refreshPromise: Promise<void> | undefined;
+let callbackPromise: Promise<void> | undefined;
+let expiresAt = 0;
+let returnTo = "/";
+
+export class PrimaryOidcSignInRequiredError extends Schema.TaggedError<PrimaryOidcSignInRequiredError>()(
+  "PrimaryOidcSignInRequiredError",
+  {},
+) {
+  override get message(): string {
+    return "Your sign-in expired or was revoked. Sign in again to continue.";
+  }
+}
+export const isPrimaryOidcSignInRequiredError = Schema.is(PrimaryOidcSignInRequiredError);
+
+function sameOriginEndpoint(path: string): string {
+  const url = new URL(resolvePrimaryEnvironmentHttpUrl(path));
+  if (url.origin !== window.location.origin) {
+    throw new Error("Browser sign-in must use this server's own address.");
+  }
+  return url.toString();
+}
+
+function localPath(value: string): string {
+  const url = new URL(value, window.location.origin);
+  if (
+    url.origin !== window.location.origin ||
+    url.pathname === OIDC_CALLBACK_PATH ||
+    url.pathname === "/pair"
+  )
+    return "/";
+  return `${url.pathname}${url.search}${url.hash}`;
+}
+
+export function readPrimaryOidcConfig(): Promise<AuthOidcConfig> {
+  if (window.desktopBridge) return Promise.resolve({ enabled: false });
+  configPromise ??= fetch(sameOriginEndpoint("/api/auth/oidc/config"), {
+    credentials: "same-origin",
+    cache: "no-store",
+    redirect: "error",
+    signal: AbortSignal.timeout(10_000),
+  })
+    .then(async (response) => {
+      if (response.status === 404) return { enabled: false } as const;
+      if (!response.ok) throw new Error("Could not load this server's sign-in settings.");
+      return decodeConfig(await response.json());
+    })
+    .catch((error: unknown) => {
+      configPromise = undefined;
+      throw error;
+    });
+  return configPromise;
+}
+
+async function exchange(payload: AuthOidcTokenInput): Promise<void> {
+  const response = await fetch(sameOriginEndpoint("/api/auth/oidc/token"), {
+    method: "POST",
+    credentials: "same-origin",
+    cache: "no-store",
+    redirect: "error",
+    signal: AbortSignal.timeout(10_000),
+    headers: { "Content-Type": "application/json" },
+    body: JSON.stringify(payload),
+  });
+  if ([400, 401, 403].includes(response.status)) throw new PrimaryOidcSignInRequiredError({});
+  if (!response.ok)
+    throw new Error("Could not renew your sign-in. Check your connection and try again.");
+  const result = decodeTokenResult(await response.json());
+  if (!Number.isFinite(result.expires_in) || result.expires_in <= 0 || result.refresh_token) {
+    throw new Error("The server returned an invalid browser session.");
+  }
+  rememberPrimaryOidcExpiry(Date.now() + result.expires_in * 1_000);
+}
+
+export function rememberPrimaryOidcExpiry(value: number): void {
+  expiresAt = value;
+  try {
+    window.localStorage.setItem(PRIMARY_OIDC_EXPIRY_KEY, String(value));
+  } catch {
+    /* Storage can be disabled. */
+  }
+}
+
+export function primaryOidcRefreshDelay(): number {
+  return Math.max(0, expiresAt - Date.now() - 60_000);
+}
+
+export function refreshPrimaryOidcSession(force = false): Promise<void> {
+  if (refreshPromise) return refreshPromise;
+  const refresh = async () => {
+    if (!force) {
+      let stored: string | null = null;
+      try {
+        stored = window.localStorage.getItem(PRIMARY_OIDC_EXPIRY_KEY);
+      } catch {
+        /* Storage can be disabled. */
+      }
+      if (stored === "0") {
+        expiresAt = 0;
+        throw new PrimaryOidcSignInRequiredError({});
+      }
+      expiresAt = Math.max(expiresAt, Number(stored) || 0);
+      if (primaryOidcRefreshDelay() > 0) return;
+    }
+    await exchange({ grant_type: "refresh_token", client_type: "browser" });
+  };
+  refreshPromise = (
+    navigator.locks ? navigator.locks.request("t3:oidc:browser:refresh", refresh) : refresh()
+  ).finally(() => {
+    refreshPromise = undefined;
+  });
+  return refreshPromise;
+}
+
+export async function beginPrimaryOidcSignIn(): Promise<void> {
+  const config = await readPrimaryOidcConfig();
+  if (!config.enabled) throw new Error("This server has not enabled identity-provider sign-in.");
+  const pkce = await Oidc.createOidcPkce();
+  const redirectUri = new URL(OIDC_CALLBACK_PATH, window.location.origin).toString();
+  window.sessionStorage.setItem(
+    TRANSACTION_KEY,
+    JSON.stringify({
+      verifier: pkce.verifier,
+      state: pkce.state,
+      redirectUri,
+      createdAt: Date.now(),
+      returnTo: localPath(window.location.href),
+    }),
+  );
+  window.location.assign(
+    Oidc.buildOidcAuthorizationUrl({
+      httpBaseUrl: window.location.origin,
+      authorizationPath: config.authorizationPath,
+      redirectUri,
+      state: pkce.state,
+      challenge: pkce.challenge,
+    }),
+  );
+}
+
+export function completePrimaryOidcSignIn(): Promise<void> {
+  callbackPromise ??= (async () => {
+    const callbackUrl = window.location.href;
+    window.history.replaceState(window.history.state, document.title, OIDC_CALLBACK_PATH);
+    const raw = window.sessionStorage.getItem(TRANSACTION_KEY);
+    window.sessionStorage.removeItem(TRANSACTION_KEY);
+    if (!raw)
+      throw new Error(
+        "This sign-in request is missing or has already been used. Please sign in again.",
+      );
+    const transaction = decodeTransaction(JSON.parse(raw));
+    const age = Date.now() - transaction.createdAt;
+    if (
+      age < 0 ||
+      age > 10 * 60_000 ||
+      transaction.redirectUri !== new URL(OIDC_CALLBACK_PATH, window.location.origin).toString()
+    ) {
+      throw new Error("This sign-in request expired. Please sign in again.");
+    }
+    const code = Oidc.readOidcCallback(callbackUrl, transaction);
+    await exchange({
+      grant_type: "authorization_code",
+      code,
+      code_verifier: transaction.verifier,
+      redirect_uri: transaction.redirectUri,
+      client_type: "browser",
+    });
+    returnTo = localPath(transaction.returnTo);
+  })();
+  return callbackPromise;
+}
+
+export function primaryOidcReturnTo(): string {
+  return returnTo;
+}
+
+export async function signOutPrimaryOidc(): Promise<void> {
+  const response = await fetch(sameOriginEndpoint("/api/auth/oidc/logout"), {
+    method: "POST",
+    credentials: "same-origin",
+    cache: "no-store",
+    redirect: "error",
+    signal: AbortSignal.timeout(10_000),
+    headers: { "Content-Type": "application/json" },
+    body: JSON.stringify({ client_type: "browser" }),
+  });
+  if (!response.ok) throw new Error("Could not sign out. Please try again.");
+  rememberPrimaryOidcExpiry(0);
+  window.location.replace("/pair");
+}
+
+export function __resetPrimaryOidcForTests(): void {
+  configPromise = undefined;
+  refreshPromise = undefined;
+  callbackPromise = undefined;
+  expiresAt = 0;
+  returnTo = "/";
+}
