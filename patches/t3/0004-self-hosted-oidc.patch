+import * as NodeCrypto from "@effect/platform-node/NodeCrypto";
+import * as NodeServices from "@effect/platform-node/NodeServices";
+import { expect, it } from "@effect/vitest";
+import * as Effect from "effect/Effect";
+import * as Layer from "effect/Layer";
+import * as Redacted from "effect/Redacted";
+import * as Etag from "effect/http/Etag";
+import * as HttpPlatform from "effect/http/HttpPlatform";
+import * as HttpRouter from "effect/http/HttpRouter";
+import * as OidcAuth from "./OidcAuth.ts";
+import * as OidcConfig from "./OidcConfig.ts";
+import * as OidcHttp from "./oidcHttp.ts";
+import * as SessionStore from "./SessionStore.ts";
+
+const origin = "https://environment.example";
+const config = {
+  settings: {
+    issuer: "https://identity.example/",
+    clientId: "test",
+    clientSecret: Redacted.make("test"),
+    publicOrigin: origin,
+    allowedSubjects: ["owner"],
+    redirectUris: [`${origin}/auth/oidc/callback`],
+  },
+};
+
+it.effect("browser refresh requires exact Origin and never returns its refresh secret", () =>
+  Effect.gen(function* () {
+    let seenRefresh: string | undefined;
+    let calls = 0;
+    const routes = OidcHttp.layer.pipe(
+      Layer.provide(Layer.succeed(OidcConfig.OidcConfig, config)),
+      Layer.provide(
+        Layer.mock(SessionStore.SessionStore)({
+          cookieName: "t3_session",
+          legacyCookieName: undefined,
+        }),
+      ),
+      Layer.provide(
+        Layer.mock(OidcAuth.OidcAuth)({
+          token: (input) => {
+            calls += 1;
+            seenRefresh = input.grant_type === "refresh_token" ? input.refresh_token : undefined;
+            return Effect.succeed({
+              access_token: "short-session",
+              refresh_token: "next-refresh",
+              token_type: "Bearer" as const,
+              expires_in: 900,
+            });
+          },
+          logout: () => Effect.void,
+        }),
+      ),
+      Layer.provide(
+        HttpPlatform.layer.pipe(
+          Layer.provideMerge(NodeServices.layer),
+          Layer.provideMerge(Etag.layerWeak),
+        ),
+      ),
+      Layer.provide(Layer.mergeAll(NodeServices.layer, NodeCrypto.layer)),
+    );
+    yield* Effect.acquireUseRelease(
+      Effect.sync(() => HttpRouter.toWebHandler(routes, { disableLogger: true })),
+      (web) =>
+        Effect.gen(function* () {
+          const request = (requestOrigin?: string, clientType = "browser") =>
+            new Request(`${origin}/api/auth/oidc/token`, {
+              method: "POST",
+              headers: {
+                "content-type": "application/json",
+                cookie: "__Secure-t3_oidc_refresh=current-refresh",
+                ...(requestOrigin ? { origin: requestOrigin } : {}),
+              },
+              body: JSON.stringify({
+                grant_type: "refresh_token",
+                client_type: clientType,
+                refresh_token: "body-refresh",
+              }),
+            });
+          for (const requestOrigin of [undefined, "https://attacker.example", "null"]) {
+            const response = yield* Effect.promise(() => web.handler(request(requestOrigin)));
+            expect(response.status).toBe(400);
+          }
+          expect(calls).toBe(0);
+          const browser = yield* Effect.promise(() => web.handler(request(origin)));
+          expect(browser.status).toBe(200);
+          expect(seenRefresh).toBe("current-refresh");
+          const payload = yield* Effect.promise(() => browser.json());
+          expect(payload).toEqual({
+            access_token: "short-session",
+            token_type: "Bearer",
+            expires_in: 900,
+          });
+          expect(browser.headers.get("cache-control")).toBe("no-store");
+          const cookies = browser.headers.getSetCookie();
+          expect(cookies).toHaveLength(2);
+          for (const cookie of cookies) {
+            expect(cookie).toContain("HttpOnly");
+            expect(cookie).toContain("Secure");
+            expect(cookie).toContain("SameSite=Lax");
+          }
+          const native = yield* Effect.promise(() => web.handler(request(undefined, "native")));
+          expect(seenRefresh).toBe("body-refresh");
+          expect(yield* Effect.promise(() => native.json())).toMatchObject({
+            refresh_token: "next-refresh",
+          });
+          expect(native.headers.getSetCookie()).toHaveLength(0);
+        }),
+      (web) => Effect.promise(() => web.dispose()),
+    );
+  }),
+);
