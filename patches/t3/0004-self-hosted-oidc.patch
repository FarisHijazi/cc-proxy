+import { afterEach, beforeEach, expect, it, vi } from "vite-plus/test";
+const mocks = vi.hoisted(() => ({ command: vi.fn(), open: vi.fn() }));
+vi.mock("./onboarding", () => ({ connectOidc: {} }));
+vi.mock("../rpc/atomRegistry", () => ({ appAtomRegistry: {} }));
+vi.mock("@t3tools/client-runtime/state/runtime", () => ({
+  runAtomCommand: mocks.command,
+  squashAtomCommandFailure: () => new Error("Sign-in failed"),
+}));
+import { beginDesktopOidcSignIn, completeDesktopOidcSignIn } from "./oidc";
+
+beforeEach(() => {
+  vi.spyOn(Date, "now").mockReturnValue(1_800_000_000_000);
+  const entries = new Map<string, string>();
+  vi.stubGlobal("sessionStorage", {
+    getItem: (key: string) => entries.get(key) ?? null,
+    setItem: (key: string, value: string) => entries.set(key, value),
+    removeItem: (key: string) => entries.delete(key),
+  });
+  vi.stubGlobal("window", {
+    location: { protocol: "t3code:", assign: vi.fn() },
+    desktopBridge: { openExternal: mocks.open },
+  });
+  vi.stubGlobal(
+    "fetch",
+    vi.fn(async () =>
+      Response.json({
+        enabled: true,
+        providerName: "Identity",
+        authorizationPath: "/api/auth/oidc/authorize",
+      }),
+    ),
+  );
+  mocks.command.mockResolvedValue({ _tag: "Success", value: "saved-environment" });
+  mocks.open.mockResolvedValue(true);
+});
+afterEach(() => {
+  vi.restoreAllMocks();
+  vi.unstubAllGlobals();
+  vi.clearAllMocks();
+});
+
+it.each(["t3code:", "t3code-dev:", "http:"])(
+  "uses the registered native callback for %s and consumes the handoff once",
+  async (protocol) => {
+    window.location.protocol = protocol;
+    await beginDesktopOidcSignIn("https://server.example.test");
+    const authorization = new URL(mocks.open.mock.calls[0]![0]);
+    const redirectUri = `${protocol === "t3code:" ? "t3code" : "t3code-dev"}://app/auth/oidc/callback`;
+    expect(authorization.searchParams.get("redirect_uri")).toBe(redirectUri);
+    const callback = `${redirectUri}?code=opaque-code&state=${authorization.searchParams.get("state")}`;
+    expect(await completeDesktopOidcSignIn(callback)).toBe("saved-environment");
+    expect(mocks.command.mock.calls[0]![2]).toMatchObject({
+      httpBaseUrl: "https://server.example.test",
+      code: "opaque-code",
+      redirectUri,
+    });
+    await expect(completeDesktopOidcSignIn(callback)).rejects.toThrow("No sign-in");
+    expect(mocks.command).toHaveBeenCalledOnce();
+  },
+);
+
+it("rejects unsolicited and mismatched callbacks before exchanging a code", async () => {
+  await expect(
+    completeDesktopOidcSignIn("t3code://app/auth/oidc/callback?code=code&state=wrong"),
+  ).rejects.toThrow();
+  await beginDesktopOidcSignIn("https://server.example.test");
+  await expect(
+    completeDesktopOidcSignIn("t3code://app/auth/oidc/callback?code=code&state=wrong"),
+  ).rejects.toThrow();
+  expect(mocks.command).not.toHaveBeenCalled();
+});
+
+it("expires interrupted sign-in requests", async () => {
+  await beginDesktopOidcSignIn("https://server.example.test");
+  const authorization = new URL(mocks.open.mock.calls[0]![0]);
+  vi.mocked(Date.now).mockReturnValue(1_800_000_000_000 + 11 * 60_000);
+  await expect(
+    completeDesktopOidcSignIn(
+      `t3code://app/auth/oidc/callback?code=code&state=${authorization.searchParams.get("state")}`,
+    ),
+  ).rejects.toThrow("expired");
+  expect(mocks.command).not.toHaveBeenCalled();
+  vi.restoreAllMocks();
+});
+
+it("accepts the exact production hash-router handoff without widening callback validation", async () => {
+  await beginDesktopOidcSignIn("https://server.example.test");
+  const authorization = new URL(mocks.open.mock.calls[0]![0]);
+  const query = `?code=code&state=${authorization.searchParams.get("state")}`;
+  await expect(
+    completeDesktopOidcSignIn(`t3code://other/#/auth/oidc/callback${query}`),
+  ).rejects.toThrow();
+  await expect(
+    completeDesktopOidcSignIn(`t3code://app/other#/auth/oidc/callback${query}`),
+  ).rejects.toThrow();
+  expect(await completeDesktopOidcSignIn(`t3code://app/#/auth/oidc/callback${query}`)).toBe(
+    "saved-environment",
+  );
+});
diff --git a/apps/web/src/connection/oidc.ts b/apps/web/src/connection/oidc.ts
new file mode 100644
index 00000000..7e3e33c9
--- /dev/null
+++ b/apps/web/src/connection/oidc.ts
@@ -0,0 +1,100 @@
+import { Oidc } from "@t3tools/client-runtime/authorization";
+import { AuthOidcConfig, EnvironmentId } from "@t3tools/contracts";
+import { runAtomCommand, squashAtomCommandFailure } from "@t3tools/client-runtime/state/runtime";
+import * as Schema from "effect/Schema";
+import { appAtomRegistry } from "../rpc/atomRegistry";
+import { connectOidc } from "./onboarding";
+
+const STORAGE_KEY = "t3code:oidc:desktop-transaction";
+const Transaction = Schema.Struct({
+  httpBaseUrl: Schema.String,
+  redirectUri: Schema.String,
+  state: Schema.String,
+  verifier: Schema.String,
+  createdAt: Schema.Number,
+  expectedEnvironmentId: Schema.optional(EnvironmentId),
+});
+
+const decodeOidcConfig = Schema.decodeUnknownSync(AuthOidcConfig);
+const decodeTransaction = Schema.decodeUnknownSync(Transaction);
+
+export function selfHostedServerUrl(): string {
+  return import.meta.env.VITE_SELF_HOSTED_SERVER_URL?.trim() ?? "";
+}
+
+export async function beginDesktopOidcSignIn(
+  httpBaseUrl: string,
+  expectedEnvironmentId?: EnvironmentId,
+): Promise<void> {
+  const origin = Oidc.oidcServerOrigin(
+    httpBaseUrl.includes("://") ? httpBaseUrl : `https://${httpBaseUrl}`,
+  );
+  if (!window.desktopBridge) {
+    window.location.assign(origin);
+    return;
+  }
+  const response = await fetch(`${origin}/api/auth/oidc/config`, { redirect: "error" });
+  if (!response.ok) throw new Error("Could not read this server's sign-in settings.");
+  const config = decodeOidcConfig(await response.json());
+  if (!config.enabled) throw new Error("This server has not enabled identity-provider sign-in.");
+  const pkce = await Oidc.createOidcPkce();
+  const scheme = window.location.protocol === "t3code:" ? "t3code" : "t3code-dev";
+  const redirectUri = `${scheme}://app/auth/oidc/callback`;
+  const transaction = {
+    httpBaseUrl: origin,
+    redirectUri,
+    state: pkce.state,
+    verifier: pkce.verifier,
+    createdAt: Date.now(),
+    ...(expectedEnvironmentId ? { expectedEnvironmentId } : {}),
+  };
+  sessionStorage.setItem(STORAGE_KEY, JSON.stringify(transaction));
+  const opened = await window.desktopBridge.openExternal(
+    Oidc.buildOidcAuthorizationUrl({
+      httpBaseUrl: origin,
+      authorizationPath: config.authorizationPath,
+      redirectUri,
+      state: pkce.state,
+      challenge: pkce.challenge,
+    }),
+  );
+  if (!opened) {
+    sessionStorage.removeItem(STORAGE_KEY);
+    throw new Error("Could not open your browser for sign-in.");
+  }
+}
+
+export async function completeDesktopOidcSignIn(callbackUrl: string): Promise<EnvironmentId> {
+  const raw = sessionStorage.getItem(STORAGE_KEY);
+  if (!raw) throw new Error("No sign-in is in progress. Please sign in again.");
+  const transaction = decodeTransaction(JSON.parse(raw));
+  if (Date.now() - transaction.createdAt > 10 * 60_000 || transaction.createdAt > Date.now()) {
+    sessionStorage.removeItem(STORAGE_KEY);
+    throw new Error("This sign-in request expired. Please sign in again.");
+  }
+  const callback = new URL(callbackUrl);
+  const rendererCallback =
+    callback.pathname === "/" &&
+    !callback.search &&
+    callback.hash.startsWith("#/auth/oidc/callback?")
+      ? `${callback.protocol}//${callback.host}${callback.hash.slice(1)}`
+      : callbackUrl;
+  const code = Oidc.readOidcCallback(rendererCallback, transaction);
+  sessionStorage.removeItem(STORAGE_KEY);
+  const result = await runAtomCommand(
+    appAtomRegistry,
+    connectOidc,
+    {
+      httpBaseUrl: transaction.httpBaseUrl,
+      code,
+      codeVerifier: transaction.verifier,
+      redirectUri: transaction.redirectUri,
+      ...(transaction.expectedEnvironmentId
+        ? { expectedEnvironmentId: transaction.expectedEnvironmentId }
+        : {}),
+    },
+    { reportFailure: false, reportDefect: false },
+  );
+  if (result._tag === "Failure") throw squashAtomCommandFailure(result);
+  return result.value;
+}
