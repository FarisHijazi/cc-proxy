@@ -0,0 +1,63 @@
+import { afterEach, beforeEach, expect, it, vi } from "vite-plus/test";
+const mocks = vi.hoisted(() => ({
+  browser: vi.fn(),
+  config: { scheme: "t3code", extra: { selfHostedServerUrl: "https://server.example.test" } },
+}));
+vi.mock("expo-constants", () => ({ default: { expoConfig: mocks.config } }));
+vi.mock("expo-crypto", () => ({
+  getRandomBytes: (length: number) => new Uint8Array(length).fill(3),
+  digest: async () => new Uint8Array(32).buffer,
+  CryptoDigestAlgorithm: { SHA256: "SHA-256" },
+}));
+vi.mock("expo-web-browser", () => ({ openAuthSessionAsync: mocks.browser }));
+import { authorizeOidcConnection, selfHostedServerUrl } from "./oidc";
+
+beforeEach(() => {
+  vi.stubGlobal(
+    "fetch",
+    vi.fn(async () =>
+      Response.json({
+        enabled: true,
+        providerName: "Identity",
+        authorizationPath: "/api/auth/oidc/authorize",
+      }),
+    ),
+  );
+  mocks.browser.mockImplementation(async (value: string, redirectUri: string) => ({
+    type: "success",
+    url: `${redirectUri}?code=opaque-code&state=${new URL(value).searchParams.get("state")}`,
+  }));
+});
+afterEach(() => {
+  vi.unstubAllGlobals();
+  vi.clearAllMocks();
+});
+
+it.each(["t3code", "t3code-dev", "t3code-preview"])(
+  "uses the %s app callback and returns a PKCE-bound handoff",
+  async (scheme) => {
+    mocks.config.scheme = scheme;
+    const result = await authorizeOidcConnection("server.example.test");
+    expect(result).toMatchObject({
+      httpBaseUrl: "https://server.example.test",
+      code: "opaque-code",
+      redirectUri: `${scheme}://auth/oidc/callback`,
+    });
+    expect(result.codeVerifier).toHaveLength(43);
+    expect(selfHostedServerUrl()).toBe("https://server.example.test");
+    expect(mocks.browser).toHaveBeenCalledOnce();
+  },
+);
+it("keeps cancellation distinct from a completed sign-in", async () => {
+  mocks.browser.mockResolvedValue({ type: "cancel" });
+  await expect(authorizeOidcConnection("https://server.example.test")).rejects.toThrow("cancelled");
+});
+it("rejects a callback for another browser transaction", async () => {
+  mocks.browser.mockResolvedValue({
+    type: "success",
+    url: "t3code://auth/oidc/callback?code=code&state=wrong",
+  });
+  await expect(authorizeOidcConnection("https://server.example.test")).rejects.toThrow(
+    "does not match",
+  );
+});
diff --git a/apps/mobile/src/connection/oidc.ts b/apps/mobile/src/connection/oidc.ts
new file mode 100644
index 00000000..f736d43a
--- /dev/null
+++ b/apps/mobile/src/connection/oidc.ts
@@ -0,0 +1,57 @@
+import { Oidc } from "@t3tools/client-runtime/authorization";
+import { AuthOidcConfig, type EnvironmentId } from "@t3tools/contracts";
+import type { ConnectionOnboarding } from "@t3tools/client-runtime/connection";
+import * as Schema from "effect/Schema";
+import Constants from "expo-constants";
+import * as Crypto from "expo-crypto";
+import * as WebBrowser from "expo-web-browser";
+
+const decodeOidcConfig = Schema.decodeUnknownSync(AuthOidcConfig);
+
+export function selfHostedServerUrl(): string {
+  const value: unknown = Constants.expoConfig?.extra?.selfHostedServerUrl;
+  return typeof value === "string" ? value.trim() : "";
+}
+
+export async function authorizeOidcConnection(
+  httpBaseUrl: string,
+  expectedEnvironmentId?: EnvironmentId,
+): Promise<ConnectionOnboarding.OidcConnectionInput> {
+  const origin = Oidc.oidcServerOrigin(
+    httpBaseUrl.includes("://") ? httpBaseUrl : `https://${httpBaseUrl}`,
+  );
+  const response = await fetch(`${origin}/api/auth/oidc/config`, { redirect: "error" });
+  if (!response.ok) throw new Error("Could not read this server's sign-in settings.");
+  const config = decodeOidcConfig(await response.json());
+  if (!config.enabled) throw new Error("This server has not enabled identity-provider sign-in.");
+  const pkce = await Oidc.createOidcPkce({
+    randomBytes: Crypto.getRandomBytes,
+    digest: async (bytes) =>
+      new Uint8Array(
+        await Crypto.digest(Crypto.CryptoDigestAlgorithm.SHA256, new Uint8Array(bytes)),
+      ),
+  });
+  const schemes = Constants.expoConfig?.scheme;
+  const scheme = Array.isArray(schemes) ? schemes[0] : schemes;
+  if (!scheme) throw new Error("This app build has no sign-in callback scheme.");
+  const redirectUri = `${scheme}://auth/oidc/callback`;
+  const result = await WebBrowser.openAuthSessionAsync(
+    Oidc.buildOidcAuthorizationUrl({
+      httpBaseUrl: origin,
+      authorizationPath: config.authorizationPath,
+      redirectUri,
+      state: pkce.state,
+      challenge: pkce.challenge,
+    }),
+    redirectUri,
+  );
+  if (result.type !== "success") throw new Error("Sign-in was cancelled.");
+  const code = Oidc.readOidcCallback(result.url, { redirectUri, state: pkce.state });
+  return {
+    httpBaseUrl: origin,
+    code,
+    codeVerifier: pkce.verifier,
+    redirectUri,
+    ...(expectedEnvironmentId ? { expectedEnvironmentId } : {}),
+  };
+}
