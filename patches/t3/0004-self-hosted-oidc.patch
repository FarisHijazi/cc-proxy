diff --git a/apps/web/src/routes/auth.oidc.callback.tsx b/apps/web/src/routes/auth.oidc.callback.tsx
new file mode 100644
index 00000000..e2c09552
--- /dev/null
+++ b/apps/web/src/routes/auth.oidc.callback.tsx
@@ -0,0 +1,33 @@
+import { createFileRoute, redirect } from "@tanstack/react-router";
+import { OidcSignInSurface } from "../components/auth/OidcSignInSurface";
+import { primaryOidcReturnTo } from "../environments/primary/oidc";
+import { completeDesktopOidcSignIn } from "../connection/oidc";
+
+export const Route = createFileRoute("/auth/oidc/callback")({
+  beforeLoad: async ({ context }) => {
+    if (window.desktopBridge) {
+      await completeDesktopOidcSignIn(window.location.href);
+      throw redirect({ to: "/", replace: true });
+    }
+    if (context.authGateState.status === "authenticated") {
+      throw redirect({ href: primaryOidcReturnTo(), replace: true });
+    }
+  },
+  component: OidcCallback,
+});
+
+function OidcCallback() {
+  const { authGateState } = Route.useRouteContext();
+  return (
+    <OidcSignInSurface
+      providerName={
+        authGateState.status === "requires-auth"
+          ? (authGateState.oidc?.providerName ?? "your identity provider")
+          : "your identity provider"
+      }
+      {...(authGateState.status === "requires-auth" && authGateState.errorMessage
+        ? { initialErrorMessage: authGateState.errorMessage }
+        : {})}
+    />
+  );
+}
