+        }).pipe(Effect.catchTags({ OidcAuthError: respondError })),
+      ),
+      HttpRouter.add(
+        "POST",
+        "/api/auth/oidc/logout",
+        Effect.gen(function* () {
+          const request = yield* HttpServerRequest.HttpServerRequest;
+          const body = yield* request.json.pipe(Effect.mapError(invalid));
+          const input = yield* decodeLogout(body).pipe(Effect.mapError(invalid));
+          const browser = input.client_type === "browser";
+          if (browser && !browserOrigin(request)) return yield* invalid();
