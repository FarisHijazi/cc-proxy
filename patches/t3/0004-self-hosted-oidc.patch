new file mode 100644
index 00000000..ef93d537
--- /dev/null
+++ b/packages/client-runtime/src/authorization/oidc.ts
@@ -0,0 +1,75 @@
+import * as Base64Url from "effect/encoding/Base64Url";
+
+export interface OidcCryptoPort {
+  readonly randomBytes: (length: number) => Uint8Array;
+  readonly digest: (bytes: Uint8Array) => Promise<Uint8Array>;
+}
+
+export async function createOidcPkce(
+  port: OidcCryptoPort = {
+    randomBytes: (length) => globalThis.crypto.getRandomValues(new Uint8Array(length)),
+    digest: async (bytes) =>
+      new Uint8Array(await globalThis.crypto.subtle.digest("SHA-256", new Uint8Array(bytes))),
+  },
+) {
+  const verifier = Base64Url.encode(port.randomBytes(32));
+  const state = Base64Url.encode(port.randomBytes(32));
+  const challenge = Base64Url.encode(await port.digest(new TextEncoder().encode(verifier)));
+  return { verifier, state, challenge };
+}
+
+export function oidcServerOrigin(value: string): string {
+  const url = new URL(value);
+  if (
+    url.username ||
+    url.password ||
+    (url.protocol !== "https:" &&
+      !(url.protocol === "http:" && ["127.0.0.1", "localhost", "[::1]"].includes(url.hostname)))
+  ) {
+    throw new Error("Sign-in requires an HTTPS server address.");
+  }
+  return url.origin;
+}
+
+export function buildOidcAuthorizationUrl(input: {
+  readonly httpBaseUrl: string;
+  readonly authorizationPath: string;
+  readonly redirectUri: string;
+  readonly state: string;
+  readonly challenge: string;
+}): string {
+  const origin = oidcServerOrigin(input.httpBaseUrl);
+  const url = new URL(input.authorizationPath, origin);
+  if (url.origin !== origin || url.username || url.password)
+    throw new Error("The sign-in endpoint must belong to this server.");
+  url.searchParams.set("redirect_uri", input.redirectUri);
+  url.searchParams.set("state", input.state);
+  url.searchParams.set("code_challenge", input.challenge);
+  url.searchParams.set("code_challenge_method", "S256");
+  return url.toString();
+}
+
+export function readOidcCallback(
+  value: string,
+  expected: { readonly redirectUri: string; readonly state: string },
+): string {
+  const url = new URL(value);
+  const redirect = new URL(expected.redirectUri);
+  if (
+    url.protocol !== redirect.protocol ||
+    url.host !== redirect.host ||
+    url.pathname !== redirect.pathname ||
+    url.username ||
+    url.password ||
+    url.hash ||
+    url.searchParams.getAll("state").length !== 1 ||
+    url.searchParams.get("state") !== expected.state ||
+    url.searchParams.has("error") ||
+    url.searchParams.getAll("code").length !== 1
+  ) {
+    throw new Error("This sign-in response does not match the request. Please sign in again.");
+  }
+  const code = url.searchParams.get("code");
+  if (!code) throw new Error("The sign-in response did not include an authorization code.");
+  return code;
+}
diff --git a/packages/client-runtime/src/authorization/oidcNative.test.ts b/packages/client-runtime/src/authorization/oidcNative.test.ts
new file mode 100644
index 00000000..154c0867
--- /dev/null
+++ b/packages/client-runtime/src/authorization/oidcNative.test.ts
@@ -0,0 +1,165 @@
+import { expect, it } from "@effect/vitest";
+import { EnvironmentId } from "@t3tools/contracts";
+import * as Deferred from "effect/Deferred";
+import * as Effect from "effect/Effect";
+import * as Fiber from "effect/Fiber";
+import * as Option from "effect/Option";
+import * as Ref from "effect/Ref";
+import * as RpcHttp from "../rpc/http.ts";
+import { BearerConnectionCredential } from "../connection/catalog.ts";
+import { ConnectionCredentialStore } from "../connection/credentialStore.ts";
+import * as Oidc from "./oidcNative.ts";
+
+const environmentId = EnvironmentId.make("oidc-environment");
+const connectionId = "oidc-route";
+const initial = new BearerConnectionCredential({
+  token: "expired-access",
+  oidc: {
+    issuerOrigin: "https://server.example.test",
+    refreshToken: "refresh-one",
+    expiresAtEpochMs: 0,
+  },
+});
+const descriptor = {
+  environmentId,
+  label: "Test server",
+  platform: { os: "linux", arch: "x64" },
+  serverVersion: "0.0.0-test",
+  capabilities: { repositoryIdentity: true },
+};
+const tokens = () =>
+  Response.json({
+    access_token: "access-two",
+    refresh_token: "refresh-two",
+    expires_in: 900,
+    token_type: "Bearer",
+  });
+const makeHarness = Effect.fn("OidcTest.makeHarness")(function* (
+  input: {
+    readonly response?: () => Promise<Response>;
+    readonly otherEnvironment?: boolean;
+    readonly beforePut?: Effect.Effect<void>;
+  } = {},
+) {
+  const saved = yield* Ref.make(Option.some(initial));
+  const calls: string[] = [];
+  const fetchFn: typeof fetch = async (request) => {
+    const url = String(request);
+    calls.push(url);
+    if (url.endsWith("/.well-known/t3/environment"))
+      return Response.json({
+        ...descriptor,
+        ...(input.otherEnvironment ? { environmentId: "different-environment" } : {}),
+      });
+    if (url.endsWith("/logout")) return new Response(null, { status: 204 });
+    return input.response ? input.response() : tokens();
+  };
+  const service = yield* Oidc.make.pipe(
+    Effect.provideService(ConnectionCredentialStore, {
+      get: () => Ref.get(saved),
+      put: (_id, value) =>
+        (input.beforePut ?? Effect.void).pipe(Effect.andThen(Ref.set(saved, Option.some(value)))),
+      remove: () => Ref.set(saved, Option.none()),
+    }),
+    Effect.provide(RpcHttp.layerRemoteHttpClient(fetchFn)),
+  );
+  return { service, saved, calls };
+});
+
+it.effect("serializes rotating refresh and persists before other callers receive it", () =>
+  Effect.gen(function* () {
+    const putEntered = yield* Deferred.make<void>();
+    const allowPut = yield* Deferred.make<void>();
+    const harness = yield* makeHarness({
+      beforePut: Deferred.succeed(putEntered, undefined).pipe(
+        Effect.andThen(Deferred.await(allowPut)),
+      ),
+    });
+    const input = { connectionId, environmentId, rejectedToken: initial.token };
+    const first = yield* harness.service.getCredential(input).pipe(Effect.forkChild);
+    yield* Deferred.await(putEntered);
+    const second = yield* harness.service.getCredential(input).pipe(Effect.forkChild);
+    yield* Deferred.succeed(allowPut, undefined);
+    const results = yield* Effect.all([Fiber.join(first), Fiber.join(second)]);
+    expect(results.map((item) => item.token)).toEqual(["access-two", "access-two"]);
+    expect(harness.calls.filter((url) => url.endsWith("/token"))).toHaveLength(1);
+    expect(Option.getOrThrow(yield* Ref.get(harness.saved)).oidc?.refreshToken).toBe("refresh-two");
+  }),
+);
+
+it.effect("refuses to send the saved refresh secret to a replaced environment", () =>
+  Effect.gen(function* () {
+    const harness = yield* makeHarness({ otherEnvironment: true });
+    const result = yield* harness.service
+      .getCredential({ connectionId, environmentId })
+      .pipe(Effect.flip);
+    expect(result._tag).toBe("ConnectionBlockedError");
+    expect(harness.calls.every((url) => url.endsWith("/.well-known/t3/environment"))).toBe(true);
+  }),
+);
+
+it.effect("keeps saved credentials on a temporary outage and retries successfully", () =>
+  Effect.gen(function* () {
+    let offline = true;
+    const harness = yield* makeHarness({
+      response: async () => (offline ? new Response(null, { status: 503 }) : tokens()),
+    });
+    const first = yield* harness.service
+      .getCredential({ connectionId, environmentId })
+      .pipe(Effect.flip);
+    expect(first._tag).toBe("ConnectionTransientError");
+    expect(Option.getOrThrow(yield* Ref.get(harness.saved)).oidc?.refreshToken).toBe("refresh-one");
+    offline = false;
+    expect((yield* harness.service.getCredential({ connectionId, environmentId })).token).toBe(
+      "access-two",
+    );
+  }),
+);
+
+it.effect(
+  "treats a revoked grant as sign-in required without replacing it with a new session",
+  () =>
+    Effect.gen(function* () {
+      const harness = yield* makeHarness({
+        response: async () => new Response(null, { status: 401 }),
+      });
+      const result = yield* harness.service
+        .getCredential({ connectionId, environmentId })
+        .pipe(Effect.flip);
+      expect(result._tag).toBe("ConnectionBlockedError");
+      expect(Option.getOrThrow(yield* Ref.get(harness.saved)).token).toBe(initial.token);
+    }),
+);
+
+it.effect("revokes the server grant before removing local credentials", () =>
+  Effect.gen(function* () {
+    const harness = yield* makeHarness();
+    yield* harness.service.revoke(connectionId);
+    expect(harness.calls).toEqual(["https://server.example.test/api/auth/oidc/logout"]);
+    expect(Option.isNone(yield* Ref.get(harness.saved))).toBe(true);
+    const result = yield* harness.service
+      .getCredential({ connectionId, environmentId })
+      .pipe(Effect.flip);
+    expect(result._tag).toBe("ConnectionBlockedError");
+  }),
+);
+
+it.effect("finishes saving a rotated credential when its old socket scope is interrupted", () =>
+  Effect.gen(function* () {
+    const putEntered = yield* Deferred.make<void>();
+    const allowPut = yield* Deferred.make<void>();
+    const harness = yield* makeHarness({
+      beforePut: Deferred.succeed(putEntered, undefined).pipe(
+        Effect.andThen(Deferred.await(allowPut)),
+      ),
+    });
+    const first = yield* harness.service
+      .getCredential({ connectionId, environmentId })
+      .pipe(Effect.forkChild);
+    yield* Deferred.await(putEntered);
+    yield* Effect.sync(() => first.interruptUnsafe());
+    yield* Deferred.succeed(allowPut, undefined);
+    yield* Fiber.await(first);
+    expect(Option.getOrThrow(yield* Ref.get(harness.saved)).oidc?.refreshToken).toBe("refresh-two");
+  }),
+);
diff --git a/packages/client-runtime/src/authorization/oidcNative.ts b/packages/client-runtime/src/authorization/oidcNative.ts
new file mode 100644
index 00000000..26825e32
--- /dev/null
+++ b/packages/client-runtime/src/authorization/oidcNative.ts
@@ -0,0 +1,157 @@
+import {
+  AuthOidcTokenResult,
+  type AuthOidcTokenInput,
+  type EnvironmentId,
+} from "@t3tools/contracts";
+import * as Clock from "effect/Clock";
+import * as Context from "effect/Context";
+import * as Effect from "effect/Effect";
+import * as Layer from "effect/Layer";
+import * as Option from "effect/Option";
+import * as Semaphore from "effect/Semaphore";
+import { HttpClient, HttpClientRequest, HttpClientResponse } from "effect/http";
+import { BearerConnectionCredential } from "../connection/catalog.ts";
+import { ConnectionCredentialStore } from "../connection/credentialStore.ts";
+import {
+  ConnectionBlockedError,
+  ConnectionTransientError,
+  type ConnectionAttemptError,
+} from "../connection/model.ts";
+import { fetchRemoteEnvironmentDescriptor } from "../environment/descriptor.ts";
+
+import { oidcServerOrigin } from "./oidc.ts";
+
+const failedRequest = () =>
+  new ConnectionTransientError({
+    reason: "remote-unavailable",
+    detail: "Could not reach the server's sign-in endpoint.",
+  });
+const signInRequired = () =>
+  new ConnectionBlockedError({
+    reason: "authentication",
+    detail: "Your sign-in expired or was revoked. Sign in to this server again.",
+  });
+
+export const exchangeOidcToken = Effect.fn("Oidc.exchangeToken")(function* (
+  httpBaseUrl: string,
+  payload: AuthOidcTokenInput,
+) {
+  const client = yield* HttpClient.HttpClient;
+  const request = HttpClientRequest.post(
+    `${oidcServerOrigin(httpBaseUrl)}/api/auth/oidc/token`,
+  ).pipe(HttpClientRequest.bodyJsonUnsafe(payload));
+  const response = yield* client
+    .execute(request)
+    .pipe(Effect.timeout("10 seconds"), Effect.mapError(failedRequest));
+  if (response.status === 400 || response.status === 401 || response.status === 403)
+    return yield* signInRequired();
+  if (response.status !== 200) return yield* failedRequest();
+  const tokens = yield* HttpClientResponse.schemaBodyJson(AuthOidcTokenResult)(response).pipe(
+    Effect.mapError(failedRequest),
+  );
+  if (!Number.isFinite(tokens.expires_in) || tokens.expires_in <= 0) return yield* failedRequest();
+  return tokens;
+});
+
+export interface OidcCredentialInput {
+  readonly connectionId: string;
+  readonly environmentId: EnvironmentId;
+  readonly rejectedToken?: string;
+}
+
+export class OidcAuthorization extends Context.Service<
+  OidcAuthorization,
+  {
+    readonly revoke: (connectionId: string) => Effect.Effect<void, ConnectionAttemptError>;
+    readonly getCredential: (
+      input: OidcCredentialInput,
+    ) => Effect.Effect<BearerConnectionCredential, ConnectionAttemptError>;
+    readonly renewBeforeExpiry: (
+      input: OidcCredentialInput & { readonly expiresAtEpochMs: number },
+    ) => Effect.Effect<void, ConnectionAttemptError>;
+  }
+>()("@t3tools/client-runtime/authorization/oidcNative/OidcAuthorization") {}
+
+export const make = Effect.gen(function* () {
+  const credentials = yield* ConnectionCredentialStore;
+  const http = yield* HttpClient.HttpClient;
+  const lock = yield* Semaphore.make(1);
+  const getCredential = Effect.fn("OidcAuthorization.getCredential")((input: OidcCredentialInput) =>
+    lock.withPermits(1)(
+      Effect.gen(function* () {
+        const saved = yield* credentials.get(input.connectionId);
+        if (Option.isNone(saved) || !saved.value.oidc) return yield* signInRequired();
+        const current = saved.value;
+        const oidc = current.oidc!;
+        const now = yield* Clock.currentTimeMillis;
+        if (oidc.expiresAtEpochMs - now > 60_000 && input.rejectedToken !== current.token)
+          return current;
+        const descriptor = yield* fetchRemoteEnvironmentDescriptor({
+          httpBaseUrl: oidc.issuerOrigin,
+        }).pipe(Effect.mapError(failedRequest));
+        if (descriptor.environmentId !== input.environmentId)
+          return yield* new ConnectionBlockedError({
+            reason: "configuration",
+            detail: "This address no longer belongs to the saved server.",
+          });
+        const tokens = yield* exchangeOidcToken(oidc.issuerOrigin, {
+          grant_type: "refresh_token",
+          refresh_token: oidc.refreshToken,
+          client_type: "native",
+        });
+        if (!tokens.refresh_token) return yield* failedRequest();
+        const refreshed = new BearerConnectionCredential({
+          token: tokens.access_token,
+          oidc: {
+            issuerOrigin: oidc.issuerOrigin,
+            refreshToken: tokens.refresh_token,
+            expiresAtEpochMs: (yield* Clock.currentTimeMillis) + tokens.expires_in * 1_000,
+          },
+        });
+        yield* credentials.put(input.connectionId, refreshed);
+        return refreshed;
+      }).pipe(Effect.provideService(HttpClient.HttpClient, http), Effect.uninterruptible),
+    ),
+  );
+  const revoke = Effect.fn("OidcAuthorization.revoke")((connectionId: string) =>
+    lock.withPermits(1)(
+      Effect.gen(function* () {
+        const saved = yield* credentials.get(connectionId);
+        if (Option.isNone(saved) || !saved.value.oidc) return;
+        const oidc = saved.value.oidc;
+        const response = yield* http
+          .execute(
+            HttpClientRequest.post(
+              `${oidcServerOrigin(oidc.issuerOrigin)}/api/auth/oidc/logout`,
+            ).pipe(
+              HttpClientRequest.bodyJsonUnsafe({
+                refresh_token: oidc.refreshToken,
+                client_type: "native",
+              }),
+            ),
+          )
+          .pipe(Effect.timeout("10 seconds"), Effect.mapError(failedRequest));
+        if (response.status < 200 || response.status >= 300) return yield* failedRequest();
+        yield* credentials.remove(connectionId);
+      }),
+    ),
+  );
+  const renewBeforeExpiry = Effect.fnUntraced(function* (
+    input: OidcCredentialInput & { readonly expiresAtEpochMs: number },
+  ) {
+    let expiresAt = input.expiresAtEpochMs;
+    let now = yield* Clock.currentTimeMillis;
+    while (now < expiresAt) {
+      yield* Effect.sleep(Math.max(5_000, expiresAt - 60_000 - now));
+      const renewed = yield* getCredential(input).pipe(
+        Effect.map((value) => value.oidc!.expiresAtEpochMs),
+        Effect.catchTags({ ConnectionTransientError: () => Effect.succeed(expiresAt) }),
+      );
+      expiresAt = Math.max(expiresAt, renewed);
+      now = yield* Clock.currentTimeMillis;
+    }
+  });
+  return OidcAuthorization.of({ getCredential, renewBeforeExpiry, revoke });
+});
+
+export const layer = Layer.effect(OidcAuthorization, make);
