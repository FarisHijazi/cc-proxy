index 00000000..5c81960c
--- /dev/null
+++ b/apps/server/src/auth/OidcAuth.test.ts
@@ -0,0 +1,421 @@
+// @effect-diagnostics-next-line nodeBuiltinImport:off -- Synchronous token digests and timing-safe comparisons keep map keys and PKCE checks atomic.
+import * as NodeCrypto from "node:crypto";
+import * as NodePlatformCrypto from "@effect/platform-node/NodeCrypto";
+import * as NodeServices from "@effect/platform-node/NodeServices";
+import { expect, it } from "@effect/vitest";
+import * as Deferred from "effect/Deferred";
+import * as Effect from "effect/Effect";
+import * as Fiber from "effect/Fiber";
+import * as Layer from "effect/Layer";
+import * as Redacted from "effect/Redacted";
+import * as Option from "effect/Option";
+import * as AuthSessions from "../persistence/AuthSessions.ts";
+import { PersistenceSqlError } from "../persistence/Errors.ts";
+import * as TestClock from "effect/testing/TestClock";
+import * as ServerConfig from "../config.ts";
+import * as ServerEnvironment from "../environment/ServerEnvironment.ts";
+import * as Sqlite from "../persistence/Sqlite.ts";
+import * as OidcAuth from "./OidcAuth.ts";
+import * as OidcConfig from "./OidcConfig.ts";
+import * as OidcIdentityProvider from "./OidcIdentityProvider.ts";
+import * as SessionStore from "./SessionStore.ts";
+import * as ServerSecretStore from "./ServerSecretStore.ts";
+
+const origin = "https://environment.example";
+const redirectUri = `${origin}/auth/oidc/callback`;
+const verifier = "v".repeat(48);
+const challenge = NodeCrypto.createHash("sha256").update(verifier).digest("base64url");
+const metadata = { deviceType: "desktop" as const };
+const settings = {
+  issuer: "https://identity.example/application/o/environment/",
+  clientId: "test-client",
+  clientSecret: Redacted.make("test-secret"),
+  publicOrigin: origin,
+  allowedSubjects: ["owner-subject"],
+  redirectUris: [redirectUri],
+};
+const config = ServerConfig.layerTest(process.cwd(), { prefix: "t3-oidc-test-" });
+const storage = Layer.mergeAll(Sqlite.layerMemory, ServerSecretStore.layer).pipe(
+  Layer.provide(config),
+);
+const sessionLayer = SessionStore.layer.pipe(
+  Layer.provideMerge(storage),
+  Layer.provide(ServerEnvironment.layerIdentity.pipe(Layer.provide(storage))),
+  Layer.provide(config),
+);
+const provider = (
+  onRefresh: (token: string) => void = () => {},
+  denied: boolean | "unavailable" | (() => boolean | "unavailable") = false,
+) =>
+  Layer.succeed(OidcIdentityProvider.OidcIdentityProvider, {
+    authorize: (input) => Effect.succeed(`https://identity.example/authorize?state=${input.state}`),
+    exchange: () =>
+      Effect.succeed({
+        subject: "owner-subject",
+        refreshToken: "provider-refresh",
+        expiresIn: 900,
+      }),
+    refresh: (input) => {
+      onRefresh(input.refreshToken);
+      const failure = typeof denied === "function" ? denied() : denied;
+      return failure
+        ? Effect.fail(
+            new OidcIdentityProvider.OidcProviderError({
+              reason: failure === "unavailable" ? "unavailable" : "rejected",
+            }),
+          )
+        : Effect.succeed({
+            subject: "owner-subject",
+            refreshToken: "rotated-provider-refresh",
+            expiresIn: 900,
+          });
+    },
+    revoke: () => Effect.void,
+  });
+const testLayer = (providerLayer = provider()) =>
+  OidcAuth.layer.pipe(
+    Layer.provideMerge(sessionLayer),
+    Layer.provide(providerLayer),
+    Layer.provide(Layer.succeed(OidcConfig.OidcConfig, { settings })),
+  );
+const begin = Effect.gen(function* () {
+  const auth = yield* OidcAuth.OidcAuth;
+  const start = yield* auth.authorize({
+    redirectUri,
+    challenge,
+    clientState: "client-state-0123456789",
+  });
+  const state = new URL(start.url).searchParams.get("state");
+  const url = `${origin}/api/auth/oidc/callback?state=${state}&code=provider-code`;
+  return { auth, start, url };
+});
+const login = Effect.gen(function* () {
+  const { auth, start, url } = yield* begin;
+  const callback = new URL(yield* auth.callback({ url, browserCookie: start.cookieValue }));
+  const input = {
+    grant_type: "authorization_code" as const,
+    code: callback.searchParams.get("code")!,
+    code_verifier: verifier,
+    redirect_uri: redirectUri,
+  };
+  return { auth, input, token: yield* auth.token(input, metadata) };
+});
+
+it.layer(Layer.mergeAll(NodeServices.layer, NodePlatformCrypto.layer))(
+  "self-hosted OIDC grants",
+  (it) => {
+    it.effect("rejects open redirects, missing browser binding and consumed callbacks", () =>
+      Effect.gen(function* () {
+        const { auth, start, url } = yield* begin;
+        expect(
+          (yield* Effect.result(
+            auth.authorize({
+              redirectUri: "https://attacker.example/auth/oidc/callback",
+              challenge,
+              clientState: "client-state-0123456789",
+            }),
+          ))._tag,
+        ).toBe("Failure");
+        expect(
+          (yield* Effect.result(auth.callback({ url, browserCookie: "wrong-browser" })))._tag,
+        ).toBe("Failure");
+        const result = yield* auth.callback({ url, browserCookie: start.cookieValue });
+        expect(new URL(result).origin).toBe(origin);
+        expect(
+          (yield* Effect.result(auth.callback({ url, browserCookie: start.cookieValue })))._tag,
+        ).toBe("Failure");
+      }).pipe(Effect.provide(testLayer())),
+    );
+
+    it.effect("binds a single-use handoff to PKCE and its exact redirect", () =>
+      Effect.gen(function* () {
+        const { auth, start, url } = yield* begin;
+        const callback = new URL(yield* auth.callback({ url, browserCookie: start.cookieValue }));
+        const input = {
+          grant_type: "authorization_code" as const,
+          code: callback.searchParams.get("code")!,
+          code_verifier: verifier,
+          redirect_uri: redirectUri,
+        };
+        expect(
+          (yield* Effect.result(auth.token({ ...input, code_verifier: "x".repeat(48) }, metadata)))
+            ._tag,
+        ).toBe("Failure");
+        expect(
+          (yield* Effect.result(
+            auth.token({ ...input, redirect_uri: `${origin}/elsewhere` }, metadata),
+          ))._tag,
+        ).toBe("Failure");
+        const result = yield* auth.token(input, metadata);
+        expect(result.expires_in).toBe(900);
+        expect((yield* Effect.result(auth.token(input, metadata)))._tag).toBe("Failure");
+      }).pipe(Effect.provide(testLayer())),
+    );
+
+    it.effect("expires pending authorizations and handoffs", () =>
+      Effect.gen(function* () {
+        const { auth, start, url } = yield* begin;
+        yield* TestClock.adjust("5 minutes");
+        expect(
+          (yield* Effect.result(auth.callback({ url, browserCookie: start.cookieValue })))._tag,
+        ).toBe("Failure");
+        const next = yield* begin;
+        const callback = new URL(
+          yield* auth.callback({ url: next.url, browserCookie: next.start.cookieValue }),
+        );
+        yield* TestClock.adjust("90 seconds");
+        expect(
+          (yield* Effect.result(
+            auth.token(
+              {
+                grant_type: "authorization_code",
+                code: callback.searchParams.get("code")!,
+                code_verifier: verifier,
+                redirect_uri: redirectUri,
+              },
+              metadata,
+            ),
+          ))._tag,
+        ).toBe("Failure");
+      }).pipe(Effect.provide(testLayer())),
+    );
+
+    it.effect(
+      "single-flights concurrent refreshes and revokes replay after the grace period",
+      () => {
+        let refreshes = 0;
+        return Effect.gen(function* () {
+          const { auth, token } = yield* login;
+          const sessions = yield* SessionStore.SessionStore;
+          const [first, second] = yield* Effect.all(
+            [
+              auth.token(
+                { grant_type: "refresh_token", refresh_token: token.refresh_token },
+                metadata,
+              ),
+              auth.token(
+                { grant_type: "refresh_token", refresh_token: token.refresh_token },
+                metadata,
+              ),
+            ],
+            { concurrency: "unbounded" },
+          );
+          expect(first).toEqual(second);
+          expect(refreshes).toBe(1);
+          expect((yield* Effect.result(sessions.verify(token.access_token)))._tag).toBe("Failure");
+          yield* TestClock.adjust("6 seconds");
+          expect(
+            (yield* Effect.result(
+              auth.token(
+                { grant_type: "refresh_token", refresh_token: token.refresh_token },
+                metadata,
+              ),
+            ))._tag,
+          ).toBe("Failure");
+          expect((yield* Effect.result(sessions.verify(first.access_token)))._tag).toBe("Failure");
+          expect(
+            (yield* Effect.result(
+              auth.token(
+                { grant_type: "refresh_token", refresh_token: first.refresh_token },
+                metadata,
+              ),
+            ))._tag,
+          ).toBe("Failure");
+        }).pipe(
+          Effect.provide(
+            testLayer(
+              provider(() => {
+                refreshes += 1;
+              }),
+            ),
+          ),
+        );
+      },
+    );
+
+    it.effect.each(["logout", "local-revoke", "provider-revoke"] as const)(
+      "%s prevents refresh and local access",
+      (mode) =>
+        Effect.gen(function* () {
+          const { auth, token } = yield* login;
+          const sessions = yield* SessionStore.SessionStore;
+          if (mode === "logout") yield* auth.logout(token.refresh_token);
+          if (mode === "local-revoke")
+            yield* sessions.revoke((yield* sessions.verify(token.access_token)).sessionId);
+          expect(
+            (yield* Effect.result(
+              auth.token(
+                { grant_type: "refresh_token", refresh_token: token.refresh_token },
+                metadata,
+              ),
+            ))._tag,
+          ).toBe("Failure");
+          expect((yield* Effect.result(sessions.verify(token.access_token)))._tag).toBe("Failure");
+        }).pipe(Effect.provide(testLayer(provider(undefined, mode === "provider-revoke")))),
+    );
+
+    it.effect("keeps the device grant through a temporary provider outage", () => {
+      let offline = true;
+      return Effect.gen(function* () {
+        const { auth, token } = yield* login;
+        const sessions = yield* SessionStore.SessionStore;
+        const failed = yield* auth
+          .token({ grant_type: "refresh_token", refresh_token: token.refresh_token }, metadata)
+          .pipe(Effect.flip);
+        expect(failed.reason).toBe("temporarily_unavailable");
+        yield* sessions.verify(token.access_token);
+        offline = false;
+        const recovered = yield* auth.token(
+          { grant_type: "refresh_token", refresh_token: token.refresh_token },
+          metadata,
+        );
+        yield* sessions.verify(recovered.access_token);
+      }).pipe(
+        Effect.provide(testLayer(provider(undefined, () => (offline ? "unavailable" : false)))),
+      );
+    });
+
+    it.effect("finishes rotation after the requesting connection disconnects", () =>
+      Effect.gen(function* () {
+        const entered = yield* Deferred.make<void>();
+        const release = yield* Deferred.make<void>();
+        let refreshes = 0;
+        const gatedProvider = Layer.effect(
+          OidcIdentityProvider.OidcIdentityProvider,
+          Effect.gen(function* () {
+            const owner = yield* OidcIdentityProvider.OidcIdentityProvider;
+            return {
+              ...owner,
+              refresh: (input: Parameters<typeof owner.refresh>[0]) =>
+                Effect.gen(function* () {
+                  refreshes += 1;
+                  yield* Deferred.succeed(entered, undefined);
+                  yield* Deferred.await(release);
+                  return yield* owner.refresh(input);
+                }),
+            };
+          }),
+        ).pipe(Layer.provide(provider()));
+        yield* Effect.gen(function* () {
+          const { auth, token } = yield* login;
+          const sessions = yield* SessionStore.SessionStore;
+          const input = {
+            grant_type: "refresh_token" as const,
+            refresh_token: token.refresh_token,
+          };
+          const pending = yield* auth
+            .token(input, metadata)
+            .pipe(Effect.forkChild({ startImmediately: true }));
+          yield* Deferred.await(entered);
+          const disconnect = yield* Fiber.interrupt(pending).pipe(
+            Effect.forkChild({ startImmediately: true }),
+          );
+          yield* Deferred.succeed(release, undefined);
+          yield* Fiber.join(disconnect);
+          const recovered = yield* auth.token(input, metadata);
+          yield* sessions.verify(recovered.access_token);
+          expect(refreshes).toBe(1);
+          expect((yield* Effect.result(sessions.verify(token.access_token)))._tag).toBe("Failure");
+          expect((yield* sessions.listActive()).length).toBe(1);
+        }).pipe(Effect.provide(testLayer(gatedProvider)));
+      }),
+    );
+
+    it.effect.each(["issue", "rotate-error", "rotate-conflict"] as const)(
+      "preserves the prior device session and rotated provider credential on %s failure",
+      (failure) => {
+        let armed = false;
+        const providerTokens: string[] = [];
+        const faultySessions = Layer.effect(
+          SessionStore.SessionStore,
+          Effect.gen(function* () {
+            const owner = yield* SessionStore.SessionStore;
+            return {
+              ...owner,
+              issue: (input: Parameters<typeof owner.issue>[0]) =>
+                armed && failure === "issue"
+                  ? Effect.fail(
+                      new SessionStore.SessionCredentialIssueError({
+                        cause: "injected persistence failure",
+                      }),
+                    )
+                  : owner.issue(input),
+            };
+          }),
+        ).pipe(Layer.provideMerge(sessionLayer));
+        const faultyRepository = Layer.effect(
+          AuthSessions.AuthSessionRepository,
+          Effect.gen(function* () {
+            const owner = yield* AuthSessions.AuthSessionRepository;
+            return {
+              ...owner,
+              rotateOidcGrant: (input: Parameters<typeof owner.rotateOidcGrant>[0]) =>
+                armed && failure === "rotate-error"
+                  ? Effect.fail(new PersistenceSqlError({ operation: "injected rotation failure" }))
