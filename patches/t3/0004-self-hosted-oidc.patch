+            browser ? (request.cookies[refreshCookieName] ?? "") : (input.refresh_token ?? ""),
+          );
+          let response = HttpServerResponse.empty({ status: 204, headers });
+          if (browser) {
+            response = yield* withCookie(
+              response,
+              sessions.cookieName,
+              "",
+              "/",
+              DateTime.toDateUtc(DateTime.makeUnsafe(0)),
+            );
+            response = yield* withCookie(
+              response,
+              refreshCookieName,
+              "",
+              "/api/auth/oidc",
+              DateTime.toDateUtc(DateTime.makeUnsafe(0)),
+            );
+          }
+          return response;
+        }).pipe(Effect.catchTags({ OidcAuthError: respondError })),
+      ),
+    );
+  }),
+);
