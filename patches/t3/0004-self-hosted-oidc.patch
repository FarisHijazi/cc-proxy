+    "invalid_request",
+    "invalid_grant",
+    "temporarily_unavailable",
+  ]),
+}) {
+  override get message() {
+    return "Self-hosted sign-in could not be completed.";
+  }
+}
+
+interface TokenResult {
+  readonly access_token: string;
+  readonly refresh_token: string;
+  readonly token_type: "Bearer";
+  readonly expires_in: number;
+}
+interface PendingAuthorization {
+  readonly redirectUri: string;
+  readonly challenge: string;
+  readonly clientState: string;
+  readonly browserHash: string;
+  readonly nonce: string;
+  readonly verifier: string;
+  readonly expiresAt: number;
+}
+interface PendingCode extends PendingAuthorization {
+  readonly providerGrant: OidcIdentityProvider.ProviderGrant;
+}
+
+export class OidcAuth extends Context.Service<
+  OidcAuth,
+  {
+    readonly authorize: (input: {
+      redirectUri: string;
+      challenge: string;
+      clientState: string;
+    }) => Effect.Effect<
+      {
+        url: string;
+        cookieName: string;
+        cookieValue: string;
+      },
+      OidcAuthError
+    >;
+    readonly callback: (input: {
+      url: string;
+      browserCookie: string | undefined;
+    }) => Effect.Effect<string, OidcAuthError>;
+    readonly token: (
+      input: AuthOidcTokenInput,
+      metadata: AuthClientMetadata,
+    ) => Effect.Effect<TokenResult, OidcAuthError>;
+    readonly logout: (refreshToken: string) => Effect.Effect<void, OidcAuthError>;
+  }
+>()("t3/auth/OidcAuth") {}
+
+const hash = (value: string) => NodeCrypto.createHash("sha256").update(value).digest("base64url");
+const equal = (left: string, right: string) =>
+  left.length === right.length && NodeCrypto.timingSafeEqual(Buffer.from(left), Buffer.from(right));
+export const oidcStateCookieName = (state: string) => `t3_oidc_${hash(state).slice(0, 20)}`;
+const secretName = (id: string) => `oidc-refresh-${id}`;
+const invalidGrant = () => new OidcAuthError({ reason: "invalid_grant" });
+
+const make = Effect.gen(function* () {
+  const { settings } = yield* OidcConfig.OidcConfig;
+  const provider = yield* OidcIdentityProvider.OidcIdentityProvider;
+  const sessions = yield* SessionStore.SessionStore;
+  const repository = yield* AuthSessions.AuthSessionRepository;
+  const secrets = yield* ServerSecretStore.ServerSecretStore;
+  const random = yield* SecureRandom.SecureRandom;
+  const lock = yield* Semaphore.make(1);
+  const pending = new Map<string, PendingAuthorization>();
+  const codes = new Map<string, PendingCode>();
+  // Concurrent browser tabs share the preceding rotation for five seconds, never a second grant.
+  const rotations = new Map<string, { expiresAt: number; result: TokenResult; grantId: string }>();
+  const randomToken = random
+    .randomBytes(32)
+    .pipe(Effect.map((bytes) => Buffer.from(bytes).toString("base64url")));
+  const unavailable = () => new OidcAuthError({ reason: "temporarily_unavailable" });
+  const purge = (now: number) => {
+    for (const map of [pending, codes, rotations]) {
+      for (const [key, value] of map) if (value.expiresAt <= now) map.delete(key);
+    }
+  };
+  const authorize: OidcAuth["Service"]["authorize"] = Effect.fn("OidcAuth.authorize")(
+    function* (input) {
+      if (!settings) return yield* new OidcAuthError({ reason: "disabled" });
+      if (
+        !settings.redirectUris.includes(input.redirectUri) ||
+        !/^[A-Za-z0-9_-]{43}$/.test(input.challenge) ||
+        !/^[A-Za-z0-9_-]{16,256}$/.test(input.clientState)
+      )
+        return yield* new OidcAuthError({ reason: "invalid_request" });
+      const now = yield* Clock.currentTimeMillis;
+      purge(now);
+      if (pending.size >= 128) return yield* unavailable();
+      const state = yield* randomToken;
+      const browserCookie = yield* randomToken;
+      const transaction: PendingAuthorization = {
+        redirectUri: input.redirectUri,
+        challenge: input.challenge,
+        clientState: input.clientState,
+        browserHash: hash(browserCookie),
+        nonce: yield* randomToken,
+        verifier: yield* randomToken,
+        expiresAt: now + 300_000,
+      };
+      const url = yield* provider
+        .authorize({ state, nonce: transaction.nonce, verifier: transaction.verifier })
+        .pipe(Effect.mapError(unavailable));
+      pending.set(state, transaction);
+      return { url, cookieName: oidcStateCookieName(state), cookieValue: browserCookie };
+    },
+  );
+  const callback: OidcAuth["Service"]["callback"] = Effect.fn("OidcAuth.callback")(
+    function* (input) {
+      if (!settings) return yield* new OidcAuthError({ reason: "disabled" });
+      const url = yield* Effect.try({ try: () => new URL(input.url), catch: invalidGrant });
+      if (url.origin !== settings.publicOrigin || url.pathname !== "/api/auth/oidc/callback")
+        return yield* invalidGrant();
+      const state = url.searchParams.get("state") ?? "";
+      const transaction = pending.get(state);
+      const now = yield* Clock.currentTimeMillis;
+      if (
+        !transaction ||
+        transaction.expiresAt <= now ||
+        !input.browserCookie ||
+        !equal(transaction.browserHash, hash(input.browserCookie))
+      )
+        return yield* invalidGrant();
+      pending.delete(state);
+      const providerGrant = yield* provider
+        .exchange({
+          url: url.href,
+          state,
+          nonce: transaction.nonce,
+          verifier: transaction.verifier,
+        })
+        .pipe(Effect.mapError(invalidGrant));
+      if (!settings.allowedSubjects.includes(providerGrant.subject)) return yield* invalidGrant();
+      purge(now);
+      if (codes.size >= 128) return yield* unavailable();
+      const code = yield* randomToken;
+      codes.set(hash(code), { ...transaction, providerGrant, expiresAt: now + 90_000 });
+      const redirect = new URL(transaction.redirectUri);
+      redirect.searchParams.set("code", code);
+      redirect.searchParams.set("state", transaction.clientState);
+      return redirect.href;
+    },
+  );
+  const revoke = Effect.fn("OidcAuth.revokeGrant")(function* (grant: AuthSessions.OidcGrantRecord) {
+    const now = yield* Clock.currentTimeMillis;
+    yield* repository.revokeOidcGrant(grant.grantId, now).pipe(Effect.mapError(unavailable));
+    yield* sessions.revoke(grant.sessionId).pipe(Effect.mapError(unavailable));
+    for (const [key, rotation] of rotations)
+      if (rotation.grantId === grant.grantId) rotations.delete(key);
+    const credential = yield* secrets
+      .get(secretName(grant.grantId))
+      .pipe(Effect.mapError(unavailable));
+    yield* secrets.remove(secretName(grant.grantId)).pipe(Effect.mapError(unavailable));
+    if (Option.isSome(credential))
+      yield* provider.revoke(new TextDecoder().decode(credential.value)).pipe(Effect.ignore);
+  });
+  const token = Effect.fn("OidcAuth.token")(
+    function* (input: AuthOidcTokenInput, metadata: AuthClientMetadata) {
+      if (!settings) return yield* new OidcAuthError({ reason: "disabled" });
+      const now = yield* Clock.currentTimeMillis;
+      purge(now);
+      if (input.grant_type === "authorization_code") {
+        const code = codes.get(hash(input.code));
+        if (
+          !code ||
+          code.expiresAt <= now ||
+          input.redirect_uri !== code.redirectUri ||
+          !/^[A-Za-z0-9._~-]{43,128}$/.test(input.code_verifier) ||
+          !equal(hash(input.code_verifier), code.challenge)
+        )
+          return yield* invalidGrant();
+        codes.delete(hash(input.code));
+        const grantId = yield* randomToken;
+        const refreshToken = `${grantId}.${yield* randomToken}`;
+        const expiresIn = Math.max(1, Math.min(900, code.providerGrant.expiresIn));
+        const issued = yield* sessions
+          .issue({
+            subject: `oidc:${grantId}`,
+            method: "bearer-access-token",
+            scopes: AuthStandardClientScopes,
+            client: metadata,
+            ttl: Duration.seconds(expiresIn),
+          })
+          .pipe(Effect.mapError(unavailable));
+        yield* secrets
+          .set(secretName(grantId), new TextEncoder().encode(code.providerGrant.refreshToken))
+          .pipe(Effect.mapError(unavailable));
+        yield* repository
+          .createOidcGrant({
+            grantId,
+            issuer: settings.issuer,
+            subject: code.providerGrant.subject,
+            refreshHash: hash(refreshToken),
+            previousRefreshHash: null,
+            sessionId: issued.sessionId,
+            expiresAt: now + 30 * 86_400_000,
+            revokedAt: null,
+          })
+          .pipe(
+            Effect.mapError(unavailable),
+            Effect.tapError(() => sessions.revoke(issued.sessionId).pipe(Effect.ignore)),
+          );
+        return {
+          access_token: issued.token,
+          refresh_token: refreshToken,
+          token_type: "Bearer" as const,
+          expires_in: expiresIn,
+        };
+      }
+      const refreshToken = input.refresh_token ?? "";
+      const pieces = refreshToken.split(".");
+      if (pieces.length !== 2 || !pieces.every((part) => /^[A-Za-z0-9_-]{43}$/.test(part)))
+        return yield* invalidGrant();
+      const grantOption = yield* repository
+        .getOidcGrant(pieces[0]!)
+        .pipe(Effect.mapError(unavailable));
+      if (Option.isNone(grantOption)) return yield* invalidGrant();
+      const grant = grantOption.value;
+      if (
+        grant.revokedAt !== null ||
+        grant.expiresAt <= now ||
+        grant.issuer !== settings.issuer ||
+        !settings.allowedSubjects.includes(grant.subject)
+      )
+        return yield* invalidGrant();
+      const session = yield* repository
+        .getById({ sessionId: grant.sessionId })
+        .pipe(Effect.mapError(unavailable));
+      if (Option.isNone(session) || session.value.revokedAt !== null) {
+        yield* revoke(grant);
+        return yield* invalidGrant();
+      }
+      const refreshHash = hash(refreshToken);
+      if (!equal(grant.refreshHash, refreshHash)) {
+        const cached = rotations.get(refreshHash);
+        if (cached && cached.grantId === grant.grantId && cached.expiresAt > now)
+          return cached.result;
+        if (grant.previousRefreshHash !== null && equal(grant.previousRefreshHash, refreshHash))
+          yield* revoke(grant);
+        return yield* invalidGrant();
+      }
+      const credential = yield* secrets
+        .get(secretName(grant.grantId))
+        .pipe(Effect.mapError(unavailable));
+      if (Option.isNone(credential)) return yield* invalidGrant();
+      const refreshed = yield* provider
+        .refresh({
+          refreshToken: new TextDecoder().decode(credential.value),
+          subject: grant.subject,
+        })
+        .pipe(
+          Effect.tapError((error) => (error.reason === "rejected" ? revoke(grant) : Effect.void)),
+          Effect.mapError((error) =>
+            error.reason === "unavailable" ? unavailable() : invalidGrant(),
+          ),
+        );
+      if (refreshed.subject !== grant.subject) {
+        yield* revoke(grant);
+        return yield* invalidGrant();
+      }
+      yield* secrets
+        .set(secretName(grant.grantId), new TextEncoder().encode(refreshed.refreshToken))
+        .pipe(Effect.mapError(unavailable));
+      const nextRefresh = `${grant.grantId}.${yield* randomToken}`;
+      const expiresIn = Math.max(
+        1,
+        Math.min(900, refreshed.expiresIn, Math.floor((grant.expiresAt - now) / 1000)),
+      );
+      const issued = yield* sessions
+        .issue({
+          subject: `oidc:${grant.grantId}`,
+          method: "bearer-access-token",
+          scopes: AuthStandardClientScopes,
+          client: metadata,
+          ttl: Duration.seconds(expiresIn),
+        })
+        .pipe(Effect.mapError(unavailable));
+      const rotated = yield* repository
+        .rotateOidcGrant({
+          grantId: grant.grantId,
+          previousHash: refreshHash,
+          refreshHash: hash(nextRefresh),
+          sessionId: issued.sessionId,
+        })
+        .pipe(
+          Effect.mapError(unavailable),
+          Effect.onError(() => sessions.revoke(issued.sessionId).pipe(Effect.ignore)),
+        );
+      if (!rotated) {
+        yield* sessions.revoke(issued.sessionId).pipe(Effect.ignore);
+        return yield* invalidGrant();
+      }
+      const result = {
+        access_token: issued.token,
+        refresh_token: nextRefresh,
+        token_type: "Bearer" as const,
+        expires_in: expiresIn,
+      };
+      rotations.set(refreshHash, {
+        expiresAt: (yield* Clock.currentTimeMillis) + 5_000,
+        result,
+        grantId: grant.grantId,
+      });
+      yield* sessions.revoke(grant.sessionId).pipe(Effect.mapError(unavailable));
+      return result;
+    },
+    Effect.uninterruptible,
+    lock.withPermits(1),
+  );
+  const logout: OidcAuth["Service"]["logout"] = Effect.fn("OidcAuth.logout")(function* (
+    refreshToken,
+  ) {
+    const [id] = refreshToken.split(".");
+    if (!id || !/^[A-Za-z0-9_-]{43}$/.test(id)) return;
+    const grant = yield* repository.getOidcGrant(id).pipe(Effect.mapError(unavailable));
+    if (Option.isNone(grant) || grant.value.revokedAt !== null) return;
+    const digest = hash(refreshToken);
+    if (
+      !equal(grant.value.refreshHash, digest) &&
+      !(grant.value.previousRefreshHash !== null && equal(grant.value.previousRefreshHash, digest))
+    )
+      return;
+    yield* revoke(grant.value);
+  }, lock.withPermits(1));
+  return { authorize, callback, token, logout };
+});
+
+export const layer = Layer.effect(OidcAuth, make);
