+import * as Config from "effect/Config";
+import * as Context from "effect/Context";
+import * as Effect from "effect/Effect";
+import * as FileSystem from "effect/FileSystem";
+import * as Layer from "effect/Layer";
+import * as Option from "effect/Option";
+import * as Redacted from "effect/Redacted";
+import * as Schema from "effect/Schema";
+
+const ConfigurationFile = Schema.Struct({
+  issuer: Schema.String,
+  clientId: Schema.String,
+  clientSecretFile: Schema.String,
+  publicOrigin: Schema.String,
+  allowedSubjects: Schema.Array(Schema.String),
+  redirectUris: Schema.Array(Schema.String),
+});
+
+const decodeConfiguration = Schema.decodeEffect(Schema.fromJsonString(ConfigurationFile));
+
+export class OidcConfigurationError extends Schema.TaggedError<OidcConfigurationError>()(
+  "OidcConfigurationError",
+  { reason: Schema.Literals(["read", "invalid"]) },
+) {
+  override get message() {
+    return "The self-hosted sign-in configuration is invalid.";
+  }
+}
+
+export class OidcConfig extends Context.Service<
+  OidcConfig,
+  {
+    readonly settings: null | {
+      readonly issuer: string;
+      readonly clientId: string;
+      readonly clientSecret: Redacted.Redacted<string>;
+      readonly publicOrigin: string;
+      readonly allowedSubjects: ReadonlyArray<string>;
+      readonly redirectUris: ReadonlyArray<string>;
+    };
+  }
+>()("t3/auth/OidcConfig") {}
+
+const make = Effect.gen(function* () {
+  const configPath = yield* Config.option(Config.String("T3CODE_OIDC_CONFIG_FILE"));
+  const required = yield* Config.Boolean("T3CODE_OIDC_REQUIRED").pipe(Config.withDefault(false));
+  if (Option.isNone(configPath)) {
+    if (required) return yield* new OidcConfigurationError({ reason: "invalid" });
+    return { settings: null };
+  }
+  const fs = yield* FileSystem.FileSystem;
+  const text = yield* fs
+    .readFileString(configPath.value)
+    .pipe(Effect.mapError(() => new OidcConfigurationError({ reason: "read" })));
+  const settings = yield* decodeConfiguration(text).pipe(
+    Effect.mapError(() => new OidcConfigurationError({ reason: "invalid" })),
+  );
+  const valid = yield* Effect.try({
+    try: () => {
+      const issuer = new URL(settings.issuer);
+      const origin = new URL(settings.publicOrigin);
+      return (
+        issuer.protocol === "https:" &&
+        !issuer.search &&
+        !issuer.hash &&
+        !issuer.username &&
+        !issuer.password &&
+        origin.protocol === "https:" &&
+        origin.origin === settings.publicOrigin &&
+        settings.clientId.length > 0 &&
+        settings.allowedSubjects.length > 0 &&
+        settings.allowedSubjects.every((subject) => subject.length > 0) &&
+        settings.redirectUris.length > 0 &&
+        settings.redirectUris.every((redirect) => {
+          const uri = new URL(redirect);
+          return (
+            !uri.search &&
+            !uri.hash &&
+            !uri.username &&
+            !uri.password &&
+            ((uri.origin === origin.origin && uri.pathname === "/auth/oidc/callback") ||
+              (["t3code:", "t3code-dev:", "t3code-preview:"].includes(uri.protocol) &&
+                ((uri.host === "app" && uri.pathname === "/auth/oidc/callback") ||
+                  (uri.host === "auth" && uri.pathname === "/oidc/callback"))))
+          );
+        })
+      );
+    },
+    catch: () => new OidcConfigurationError({ reason: "invalid" }),
+  });
+  if (!valid) return yield* new OidcConfigurationError({ reason: "invalid" });
+  const secret = (yield* fs
+    .readFileString(settings.clientSecretFile)
+    .pipe(Effect.mapError(() => new OidcConfigurationError({ reason: "read" })))).trim();
+  if (!secret) return yield* new OidcConfigurationError({ reason: "invalid" });
+  return { settings: { ...settings, clientSecret: Redacted.make(secret) } };
+});
+
+export const layer = Layer.effect(OidcConfig, make);
