+import { expect, it } from "@effect/vitest";
+import { readOidcCallback, buildOidcAuthorizationUrl } from "./oidc.ts";
+
+it("binds an authorization response to its exact redirect and state", () => {
+  const request = { redirectUri: "t3code://app/auth/oidc/callback", state: "expected-state" };
+  expect(
+    readOidcCallback("t3code://app/auth/oidc/callback?code=one-use&state=expected-state", request),
+  ).toBe("one-use");
+  for (const url of [
+    "t3code://app/auth/oidc/callback?code=one-use&state=wrong",
+    "t3code://other/auth/oidc/callback?code=one-use&state=expected-state",
+    "t3code://app/other?code=one-use&state=expected-state",
+    "t3code://app/auth/oidc/callback?code=one&code=two&state=expected-state",
+    "t3code://app/auth/oidc/callback?error=access_denied&state=expected-state",
+  ])
+    expect(() => readOidcCallback(url, request)).toThrow();
+});
+
+it("keeps authorization on the selected HTTPS server", () => {
+  const request = {
+    httpBaseUrl: "https://server.example.test",
+    redirectUri: "t3code://app/auth/oidc/callback",
+    state: "state",
+    challenge: "challenge",
+    authorizationPath: "/api/auth/oidc/authorize",
+  };
+  const url = new URL(buildOidcAuthorizationUrl(request));
+  expect(url.origin).toBe("https://server.example.test");
+  expect(url.searchParams.get("code_challenge_method")).toBe("S256");
+  expect(url.searchParams.get("redirect_uri")).toBe(request.redirectUri);
+  expect(() =>
+    buildOidcAuthorizationUrl({
+      ...request,
+      authorizationPath: "https://other.example.test/authorize",
+    }),
+  ).toThrow();
+  expect(() =>
+    buildOidcAuthorizationUrl({ ...request, httpBaseUrl: "http://server.example.test" }),
+  ).toThrow();
+});
