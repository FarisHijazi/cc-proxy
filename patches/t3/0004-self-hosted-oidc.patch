+import * as NodeCrypto from "@effect/platform-node/NodeCrypto";
+import * as NodeServices from "@effect/platform-node/NodeServices";
+import { expect, it } from "@effect/vitest";
+import * as Clock from "effect/Clock";
+import * as Effect from "effect/Effect";
+import * as Layer from "effect/Layer";
+import * as Redacted from "effect/Redacted";
+import * as HttpServerRequest from "effect/http/HttpServerRequest";
+import * as ServerConfig from "../config.ts";
+import * as ServerEnvironment from "../environment/ServerEnvironment.ts";
+import * as Sqlite from "../persistence/Sqlite.ts";
+import * as AuthSessions from "../persistence/AuthSessions.ts";
+import * as ManagedPolicy from "../policy/ManagedPolicy.ts";
+import * as EnvironmentAuth from "./EnvironmentAuth.ts";
+import * as EnvironmentAuthPolicy from "./EnvironmentAuthPolicy.ts";
+import * as PairingGrantStore from "./PairingGrantStore.ts";
+import * as OidcConfig from "./OidcConfig.ts";
+import * as SessionStore from "./SessionStore.ts";
+import * as ServerSecretStore from "./ServerSecretStore.ts";
+
+const settings = {
+  issuer: "https://identity.example/",
+  clientId: "test",
+  clientSecret: Redacted.make("test"),
+  publicOrigin: "https://environment.example",
+  allowedSubjects: ["owner"],
+  redirectUris: ["https://environment.example/auth/oidc/callback"],
+};
+const config = ServerConfig.layerTest(process.cwd(), { prefix: "t3-oidc-policy-test-" });
+const storage = Layer.mergeAll(Sqlite.layerMemory, ServerSecretStore.layer).pipe(
+  Layer.provide(config),
+);
+const authLayer = Layer.effect(EnvironmentAuth.EnvironmentAuth, EnvironmentAuth.make).pipe(
+  Layer.provideMerge(PairingGrantStore.layer),
+  Layer.provideMerge(SessionStore.layer),
+  Layer.provideMerge(EnvironmentAuthPolicy.layer),
+  Layer.provideMerge(storage),
+  Layer.provide(ManagedPolicy.layerTest()),
+  Layer.provide(ServerEnvironment.layerIdentity.pipe(Layer.provide(storage))),
+  Layer.provide(config),
+  Layer.provide(Layer.succeed(OidcConfig.OidcConfig, { settings })),
+);
+const request = (token: string, headers: Record<string, string> = {}) =>
+  HttpServerRequest.fromWeb(
+    new Request("https://environment.example/api/protected", {
+      headers: { authorization: `Bearer ${token}`, ...headers },
+    }),
+  );
+
+it.layer(Layer.mergeAll(NodeServices.layer, NodeCrypto.layer))("OIDC remote boundary", (it) => {
+  it.effect("rejects valid legacy credentials and spoofed identity on HTTP and WS", () =>
+    Effect.gen(function* () {
+      const auth = yield* EnvironmentAuth.EnvironmentAuth;
+      const sessions = yield* SessionStore.SessionStore;
+      const legacy = yield* sessions.issue({ subject: "one-time-token" });
+      expect((yield* Effect.result(auth.authenticateHttpRequest(request(legacy.token))))._tag).toBe(
+        "Failure",
+      );
+      expect(
+        (yield* Effect.result(
+          auth.authenticateHttpRequest(
+            request(legacy.token, {
+              "x-authentik-username": "owner",
+              "x-forwarded-for": "127.0.0.1",
+              "x-forwarded-host": "localhost",
+            }),
+          ),
+        ))._tag,
+      ).toBe("Failure");
+      const ticket = yield* sessions.issueWebSocketToken(legacy.sessionId, { audience: "rpc" });
+      const ws = HttpServerRequest.fromWeb(
+        new Request(`https://environment.example/ws?wsTicket=${ticket.token}`),
+      );
+      expect((yield* Effect.result(auth.authenticateWebSocketUpgrade(ws, "rpc")))._tag).toBe(
+        "Failure",
+      );
+      const forged = yield* sessions.issue({ subject: "oidc:no-such-grant" });
+      expect((yield* Effect.result(auth.authenticateHttpRequest(request(forged.token))))._tag).toBe(
+        "Failure",
+      );
+    }).pipe(Effect.provide(authLayer)),
+  );
+
+  it.effect.each(["valid", "issuer", "subject", "revoked", "expired"] as const)(
+    "checks persisted %s grant on remote access",
+    (scenario) =>
+      Effect.gen(function* () {
+        const auth = yield* EnvironmentAuth.EnvironmentAuth;
+        const sessions = yield* SessionStore.SessionStore;
+        const repository = yield* AuthSessions.AuthSessionRepository;
+        const now = yield* Clock.currentTimeMillis;
+        const session = yield* sessions.issue({ subject: "oidc:device-grant" });
+        yield* repository.createOidcGrant({
+          grantId: "device-grant",
+          issuer: scenario === "issuer" ? "https://attacker.example/" : settings.issuer,
+          subject: scenario === "subject" ? "other-owner" : "owner",
+          refreshHash: "hash",
+          previousRefreshHash: null,
+          sessionId: session.sessionId,
+          expiresAt: now + (scenario === "expired" ? -1 : 60_000),
+          revokedAt: scenario === "revoked" ? now : null,
+        });
+        expect(
+          (yield* Effect.result(auth.authenticateHttpRequest(request(session.token))))._tag,
+        ).toBe(scenario === "valid" ? "Success" : "Failure");
+      }).pipe(Effect.provide(authLayer)),
+  );
+  it.effect("retains only direct loopback CLI access and rejects forwarded loopback claims", () =>
+    Effect.gen(function* () {
+      const auth = yield* EnvironmentAuth.EnvironmentAuth;
+      const sessions = yield* SessionStore.SessionStore;
+      const legacy = yield* sessions.issue({ subject: "cli-issued-session" });
+      const local = {
+        source: { socket: { remoteAddress: "127.0.0.1" } },
+        method: "GET",
+        url: "/api/protected",
+        originalUrl: "/api/protected",
+        cookies: {},
+        headers: { host: "127.0.0.1:3773", authorization: `Bearer ${legacy.token}` },
+      } as unknown as HttpServerRequest.HttpServerRequest;
+      expect((yield* Effect.result(auth.authenticateHttpRequest(local)))._tag).toBe("Success");
+      const forwarded = {
+        ...local,
+        headers: { ...local.headers, "x-forwarded-host": "environment.example" },
+      } as HttpServerRequest.HttpServerRequest;
+      expect((yield* Effect.result(auth.authenticateHttpRequest(forwarded)))._tag).toBe("Failure");
+    }).pipe(Effect.provide(authLayer)),
+  );
+});
