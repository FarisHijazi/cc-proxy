diff --git a/apps/web/src/components/auth/OidcAccountSettings.tsx b/apps/web/src/components/auth/OidcAccountSettings.tsx
new file mode 100644
index 00000000..f2ba1bd5
--- /dev/null
+++ b/apps/web/src/components/auth/OidcAccountSettings.tsx
@@ -0,0 +1,49 @@
+import { useEffect, useState } from "react";
+import { readPrimaryOidcConfig, signOutPrimaryOidc } from "../../environments/primary/oidc";
+import { Alert, AlertDescription } from "../ui/alert";
+import { Button } from "../ui/button";
+
+export function OidcAccountSettings() {
+  const [providerName, setProviderName] = useState<string>();
+  const [error, setError] = useState<string>();
+  const [pending, setPending] = useState(false);
+  // oxlint-disable-next-line t3code/no-unreasoned-state-sync -- reads the server's configured identity provider before displaying sign-out controls
+  useEffect(() => {
+    let disposed = false;
+    void readPrimaryOidcConfig()
+      .then((config) => {
+        if (!disposed && config.enabled) setProviderName(config.providerName);
+      })
+      .catch(() => {});
+    return () => {
+      disposed = true;
+    };
+  }, []);
+  if (!providerName) return null;
+  const signOut = async () => {
+    setPending(true);
+    setError(undefined);
+    try {
+      await signOutPrimaryOidc();
+    } catch (cause) {
+      setError(cause instanceof Error ? cause.message : "Could not sign out.");
+      setPending(false);
+    }
+  };
+  return (
+    <section className="mb-6 space-y-3">
+      <h2 className="text-sm font-medium">Signed in with {providerName}</h2>
+      <p className="text-sm text-muted-foreground">
+        Sign out of this browser. Your running sessions will continue.
+      </p>
+      {error ? (
+        <Alert variant="error">
+          <AlertDescription>{error}</AlertDescription>
+        </Alert>
+      ) : null}
+      <Button variant="outline" disabled={pending} onClick={() => void signOut()}>
+        {pending ? "Signing out…" : "Sign out of this browser"}
+      </Button>
+    </section>
+  );
+}
diff --git a/apps/web/src/components/auth/OidcSessionCoordinator.tsx b/apps/web/src/components/auth/OidcSessionCoordinator.tsx
new file mode 100644
index 00000000..327f0bea
--- /dev/null
+++ b/apps/web/src/components/auth/OidcSessionCoordinator.tsx
@@ -0,0 +1,56 @@
+import { useEffect } from "react";
+import {
+  primaryOidcRefreshDelay,
+  isPrimaryOidcSignInRequiredError,
+  readPrimaryOidcConfig,
+  refreshPrimaryOidcSession,
+  PRIMARY_OIDC_EXPIRY_KEY,
+} from "../../environments/primary/oidc";
+
+export function OidcSessionCoordinator() {
+  // oxlint-disable-next-line t3code/no-unreasoned-state-sync -- renews the same-origin HttpOnly session and recovers after browser suspension
+  useEffect(() => {
+    let disposed = false;
+    let enabled = false;
+    let timer: ReturnType<typeof setTimeout> | undefined;
+    const renew = async () => {
+      if (disposed || !enabled) return;
+      clearTimeout(timer);
+      let retryIn = 30_000;
+      try {
+        await refreshPrimaryOidcSession();
+        retryIn = Math.max(5_000, primaryOidcRefreshDelay());
+      } catch (error) {
+        if (isPrimaryOidcSignInRequiredError(error)) {
+          window.location.replace("/pair");
+          return;
+        }
+      }
+      if (!disposed) timer = setTimeout(() => void renew(), retryIn);
+    };
+    const wake = () => {
+      if (document.visibilityState === "visible") void renew();
+    };
+    const storage = (event: StorageEvent) => {
+      if (enabled && event.key === PRIMARY_OIDC_EXPIRY_KEY && event.newValue === "0")
+        window.location.replace("/pair");
+    };
+    void readPrimaryOidcConfig().then((config) => {
+      enabled = config.enabled;
+      void renew();
+    });
+    window.addEventListener("online", wake);
+    window.addEventListener("storage", storage);
+    window.addEventListener("focus", wake);
+    document.addEventListener("visibilitychange", wake);
+    return () => {
+      disposed = true;
+      clearTimeout(timer);
+      window.removeEventListener("online", wake);
+      window.removeEventListener("storage", storage);
+      window.removeEventListener("focus", wake);
+      document.removeEventListener("visibilitychange", wake);
+    };
+  }, []);
+  return null;
+}
