+import * as NodeServices from "@effect/platform-node/NodeServices";
+import { expect, it } from "@effect/vitest";
+import * as ConfigProvider from "effect/ConfigProvider";
+import * as Effect from "effect/Effect";
+import * as FileSystem from "effect/FileSystem";
+import * as Layer from "effect/Layer";
+import * as OidcConfig from "./OidcConfig.ts";
+
+const readConfig = (env: Readonly<Record<string, string>>) =>
+  OidcConfig.OidcConfig.pipe(
+    Effect.provide(
+      OidcConfig.layer.pipe(Layer.provide(ConfigProvider.layer(ConfigProvider.fromEnv({ env })))),
+    ),
+  );
+
+it.effect("requires a configuration file when the operator requires SSO", () =>
+  Effect.gen(function* () {
+    const required = yield* Effect.result(readConfig({ T3CODE_OIDC_REQUIRED: "true" }));
+    expect(required._tag).toBe("Failure");
+    expect((yield* readConfig({})).settings).toBeNull();
+  }).pipe(Effect.provide(NodeServices.layer)),
+);
+
+it.effect.each([
+  "missing",
+  "malformed",
+  "insecure-issuer",
+  "empty-subjects",
+  "open-redirect",
+] as const)("fails closed for %s configuration", (scenario) =>
+  Effect.scoped(
+    Effect.gen(function* () {
+      const fs = yield* FileSystem.FileSystem;
+      const dir = yield* fs.makeTempDirectoryScoped({ prefix: "t3-oidc-config-" });
+      const file = `${dir}/oidc.json`;
+      yield* fs.writeFileString(`${dir}/secret`, "test-secret");
+      if (scenario !== "missing")
+        yield* fs.writeFileString(
+          file,
+          scenario === "malformed"
+            ? "invalid-json"
+            : JSON.stringify({
+                issuer:
+                  scenario === "insecure-issuer"
+                    ? "http://identity.example"
+                    : "https://identity.example/",
+                publicOrigin: "https://environment.example",
+                clientId: "test",
+                clientSecretFile: `${dir}/secret`,
+                allowedSubjects: scenario === "empty-subjects" ? [] : ["owner"],
+                redirectUris: [
+                  scenario === "open-redirect"
+                    ? "https://attacker.example/callback"
+                    : "https://environment.example/auth/oidc/callback",
+                ],
+              }),
+        );
+      const result = yield* Effect.result(
+        readConfig({ T3CODE_OIDC_REQUIRED: "true", T3CODE_OIDC_CONFIG_FILE: file }),
+      );
+      expect(result._tag).toBe("Failure");
+    }),
+  ).pipe(Effect.provide(NodeServices.layer)),
+);
