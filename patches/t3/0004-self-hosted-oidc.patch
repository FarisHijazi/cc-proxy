+  initialErrorMessage?: string;
+}) {
+  const [error, setError] = useState(initialErrorMessage);
+  const [pending, setPending] = useState(false);
+  const signIn = async () => {
+    setPending(true);
+    setError(undefined);
+    try {
+      await beginPrimaryOidcSignIn();
+    } catch (cause) {
+      setError(
+        cause instanceof Error ? cause.message : "Could not start sign-in. Please try again.",
+      );
+      setPending(false);
+    }
+  };
+  return (
+    <StandalonePage>
+      <StandalonePageHeader
+        title="Sign in to your workspace"
+        description={`Use your ${providerName} account to access your sessions on this server.`}
+      />
+      <div className="mt-6 space-y-4">
+        {error ? (
+          <Alert variant="error">
+            <AlertDescription>{error}</AlertDescription>
+          </Alert>
+        ) : null}
+        <Button disabled={pending} onClick={() => void signIn()}>
+          {pending ? "Opening sign-in…" : `Sign in with ${providerName}`}
+        </Button>
+      </div>
+    </StandalonePage>
+  );
+}
