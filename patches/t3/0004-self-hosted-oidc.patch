+import { AuthOidcLogoutInput, AuthOidcTokenInput } from "@t3tools/contracts";
+import * as Clock from "effect/Clock";
+import * as DateTime from "effect/DateTime";
+import * as Effect from "effect/Effect";
+import * as Layer from "effect/Layer";
+import * as Schema from "effect/Schema";
+import * as Cookies from "effect/http/Cookies";
+import * as HttpRouter from "effect/http/HttpRouter";
+import * as HttpServerRequest from "effect/http/HttpServerRequest";
+import * as HttpServerResponse from "effect/http/HttpServerResponse";
+import * as OidcAuth from "./OidcAuth.ts";
+import * as OidcConfig from "./OidcConfig.ts";
+import * as SessionStore from "./SessionStore.ts";
+import { deriveAuthClientMetadata } from "./utils.ts";
+
+const headers = {
+  "cache-control": "no-store",
+  pragma: "no-cache",
+  "referrer-policy": "no-referrer",
+};
+const decodeToken = Schema.decodeUnknownEffect(AuthOidcTokenInput);
+const decodeLogout = Schema.decodeUnknownEffect(AuthOidcLogoutInput);
+const refreshCookieName = "__Secure-t3_oidc_refresh";
+const cookieOptions = { httpOnly: true, secure: true, sameSite: "lax" as const };
+const invalid = () => new OidcAuth.OidcAuthError({ reason: "invalid_request" });
+const respondError = (error: OidcAuth.OidcAuthError) =>
+  Effect.succeed(
+    HttpServerResponse.jsonUnsafe(
+      { error: error.reason },
+      {
+        status:
+          error.reason === "temporarily_unavailable"
+            ? 503
+            : error.reason === "disabled"
+              ? 404
+              : 400,
+        headers,
+      },
+    ),
+  );
+const withCookie = (
+  response: HttpServerResponse.HttpServerResponse,
+  name: string,
+  value: string,
+  path: string,
+  expires: Date,
+) =>
+  Effect.fromResult(
+    Cookies.set(Cookies.empty, name, value, { ...cookieOptions, path, expires }),
+  ).pipe(
+    Effect.map((cookies) => HttpServerResponse.mergeCookies(response, cookies)),
+    Effect.mapError(invalid),
+  );
+
+export const layer = Layer.unwrap(
+  Effect.gen(function* () {
+    const { settings } = yield* OidcConfig.OidcConfig;
+    const auth = yield* OidcAuth.OidcAuth;
+    const sessions = yield* SessionStore.SessionStore;
+    const browserOrigin = (request: HttpServerRequest.HttpServerRequest) =>
+      settings !== null && request.headers.origin === settings.publicOrigin;
+    return Layer.mergeAll(
+      HttpRouter.add(
+        "GET",
+        "/api/auth/oidc/config",
+        Effect.succeed(
+          HttpServerResponse.jsonUnsafe(
+            settings
+              ? {
+                  enabled: true,
+                  providerName: "Authentik",
+                  authorizationPath: "/api/auth/oidc/authorize",
+                }
+              : { enabled: false },
+            { headers },
+          ),
+        ),
+      ),
+      HttpRouter.add(
+        "GET",
+        "/api/auth/oidc/authorize",
+        Effect.gen(function* () {
+          const request = yield* HttpServerRequest.HttpServerRequest;
+          const url = new URL(request.url, "https://invalid.local");
