+// @effect-diagnostics-next-line nodeBuiltinImport:off -- A real RSA test issuer exercises the library's signature verification.
+import * as NodeCrypto from "node:crypto";
+import { expect, it } from "@effect/vitest";
+import { vi } from "vite-plus/test";
+import * as Effect from "effect/Effect";
+import * as Redacted from "effect/Redacted";
+import * as OidcConfig from "./OidcConfig.ts";
+import * as OidcIdentityProvider from "./OidcIdentityProvider.ts";
+
+const issuer = "https://identity.example/application/o/environment/";
+const publicOrigin = "https://environment.example";
+const settings = {
+  issuer,
+  publicOrigin,
+  clientId: "owner-client",
+  clientSecret: Redacted.make("test-client-secret"),
+  allowedSubjects: ["owner-subject"],
+  redirectUris: [`${publicOrigin}/auth/oidc/callback`],
+};
+
+it.effect.each([
+  "valid",
+  "issuer",
+  "audience",
+  "nonce",
+  "subject",
+  "signature",
+  "expired",
+  "state",
+  "refresh-valid",
+  "refresh-missing",
+  "refresh-issuer",
+  "refresh-audience",
+  "refresh-subject",
+  "refresh-signature",
+] as const)("validates OIDC %s with signed ID tokens", (scenario) =>
+  Effect.gen(function* () {
+    using _clock = vi.spyOn(Date, "now").mockReturnValue(1_800_000_000_000);
+    const refresh = scenario.startsWith("refresh-");
+    const validation = scenario.replace("refresh-", "");
+    let userinfoRequests = 0;
+    const keys = NodeCrypto.generateKeyPairSync("rsa", { modulusLength: 2048 });
+    const jwk = {
+      ...keys.publicKey.export({ format: "jwk" }),
+      kid: "test-key",
+      alg: "RS256",
+      use: "sig",
+    };
+    const encode = (value: unknown) => Buffer.from(JSON.stringify(value)).toString("base64url");
+    const claims = {
+      iss: validation === "issuer" ? "https://attacker.example" : issuer,
+      aud: validation === "audience" ? "another-client" : settings.clientId,
+      sub: validation === "subject" ? "unapproved-subject" : "owner-subject",
+      ...(refresh ? {} : { nonce: validation === "nonce" ? "another-nonce" : "expected-nonce" }),
+      iat: 1_800_000_000,
+      exp: validation === "expired" ? 1_799_999_000 : 1_800_000_900,
+    };
+    const signed = `${encode({ alg: "RS256", kid: "test-key" })}.${encode(claims)}`;
+    const signature =
+      validation === "signature"
+        ? Buffer.alloc(256).toString("base64url")
+        : NodeCrypto.sign("RSA-SHA256", Buffer.from(signed), keys.privateKey).toString("base64url");
+    using _fetch = vi.spyOn(globalThis, "fetch").mockImplementation(async (input) => {
+      const url = String(input);
+      if (url.endsWith(".well-known/openid-configuration"))
+        return Response.json({
+          issuer,
+          authorization_endpoint: "https://identity.example/authorize",
+          token_endpoint: "https://identity.example/token",
+          jwks_uri: "https://identity.example/jwks",
+          userinfo_endpoint: "https://identity.example/userinfo",
+          response_types_supported: ["code"],
+          subject_types_supported: ["public"],
+          id_token_signing_alg_values_supported: ["RS256"],
+          token_endpoint_auth_methods_supported: ["client_secret_post"],
+        });
+      if (url === "https://identity.example/jwks") return Response.json({ keys: [jwk] });
+      if (url === "https://identity.example/token")
+        return Response.json({
+          access_token: "provider-access",
+          token_type: "Bearer",
+          refresh_token: "provider-refresh",
+          expires_in: 900,
+          ...(validation === "missing" ? {} : { id_token: `${signed}.${signature}` }),
+        });
+      if (url === "https://identity.example/userinfo") {
+        userinfoRequests += 1;
+        return new Response("Unavailable", { status: 503 });
+      }
+      throw new Error("Unexpected identity-provider request");
+    });
+    const provider = yield* OidcIdentityProvider.OidcIdentityProvider;
+    const result = yield* Effect.result(
+      refresh
+        ? provider.refresh({ refreshToken: "previous-provider-refresh", subject: "owner-subject" })
+        : provider.exchange({
+            url: `${publicOrigin}/api/auth/oidc/callback?code=provider-code&state=${scenario === "state" ? "wrong-state" : "expected-state"}`,
+            state: "expected-state",
+            nonce: "expected-nonce",
+            verifier: "v".repeat(48),
+          }),
+    );
+    expect(result._tag).toBe(validation === "valid" ? "Success" : "Failure");
+    if (refresh) expect(userinfoRequests).toBe(0);
+    if (result._tag === "Success") {
+      expect(result.success.subject).toBe("owner-subject");
+      expect(result.success.refreshToken).toBe("provider-refresh");
+    } else if (validation === "missing") {
+      expect(result.failure.reason).toBe("rejected");
+    }
+  }).pipe(
+    Effect.provide(OidcIdentityProvider.layer),
+    Effect.provideService(OidcConfig.OidcConfig, { settings }),
+  ),
+);
+
+it.effect("retries discovery after an outage without restarting the server", () =>
+  Effect.gen(function* () {
+    let requests = 0;
+    using _fetch = vi.spyOn(globalThis, "fetch").mockImplementation(async () => {
+      requests += 1;
+      return requests === 1
+        ? new Response("Unavailable", { status: 503 })
+        : Response.json({
+            issuer,
+            authorization_endpoint: "https://identity.example/authorize",
+            token_endpoint: "https://identity.example/token",
+            jwks_uri: "https://identity.example/jwks",
+            response_types_supported: ["code"],
+            subject_types_supported: ["public"],
+            id_token_signing_alg_values_supported: ["RS256"],
+          });
+    });
+    const provider = yield* OidcIdentityProvider.OidcIdentityProvider;
+    const input = { state: "test-state", nonce: "test-nonce", verifier: "v".repeat(48) };
+    expect((yield* Effect.result(provider.authorize(input)))._tag).toBe("Failure");
+    expect((yield* Effect.result(provider.authorize(input)))._tag).toBe("Success");
+    expect(requests).toBe(2);
+  }).pipe(
+    Effect.provide(OidcIdentityProvider.layer),
+    Effect.provideService(OidcConfig.OidcConfig, { settings }),
+  ),
+);
+
+it.effect.each(["network", "http503", "invalid_grant"] as const)(
+  "classifies refresh %s",
+  (failure) =>
+    Effect.gen(function* () {
+      using _fetch = vi.spyOn(globalThis, "fetch").mockImplementation(async (input) => {
+        if (String(input).endsWith(".well-known/openid-configuration"))
+          return Response.json({
+            issuer,
+            authorization_endpoint: "https://identity.example/authorize",
+            token_endpoint: "https://identity.example/token",
+            jwks_uri: "https://identity.example/jwks",
+            response_types_supported: ["code"],
+            subject_types_supported: ["public"],
+            id_token_signing_alg_values_supported: ["RS256"],
+          });
+        if (failure === "network") throw new TypeError("Network unavailable");
+        return failure === "http503"
+          ? new Response("Unavailable", { status: 503 })
+          : Response.json({ error: "invalid_grant" }, { status: 400 });
+      });
+      const provider = yield* OidcIdentityProvider.OidcIdentityProvider;
+      const error = yield* provider
+        .refresh({ refreshToken: "test-refresh", subject: "owner-subject" })
+        .pipe(Effect.flip);
+      expect(error.reason).toBe(failure === "invalid_grant" ? "rejected" : "unavailable");
+    }).pipe(
+      Effect.provide(OidcIdentityProvider.layer),
+      Effect.provideService(OidcConfig.OidcConfig, { settings }),
+    ),
+);
diff --git a/apps/server/src/auth/OidcIdentityProvider.ts b/apps/server/src/auth/OidcIdentityProvider.ts
new file mode 100644
index 00000000..35fa0aef
--- /dev/null
+++ b/apps/server/src/auth/OidcIdentityProvider.ts
@@ -0,0 +1,165 @@
+import * as client from "openid-client";
+import * as Context from "effect/Context";
+import * as Effect from "effect/Effect";
+import * as Layer from "effect/Layer";
+import * as Redacted from "effect/Redacted";
+import * as Schema from "effect/Schema";
+import * as OidcConfig from "./OidcConfig.ts";
+
+export class OidcProviderError extends Schema.TaggedError<OidcProviderError>()(
+  "OidcProviderError",
+  { reason: Schema.Literals(["disabled", "unavailable", "rejected"]) },
+) {
+  override get message() {
+    return "The identity provider could not authorize this device.";
+  }
+}
+
+function providerFailure(error: unknown): OidcProviderError {
+  const unavailable =
+    error instanceof TypeError ||
+    (error instanceof client.ResponseBodyError &&
+      ["server_error", "temporarily_unavailable"].includes(error.error)) ||
+    (error instanceof client.ClientError &&
+      (error.code === "OAUTH_TIMEOUT" ||
+        error.code === "OAUTH_ABORT" ||
+        (error.cause instanceof Response && error.cause.status >= 500)));
+  return new OidcProviderError({ reason: unavailable ? "unavailable" : "rejected" });
+}
+
+export interface ProviderGrant {
+  readonly subject: string;
+  readonly refreshToken: string;
+  readonly expiresIn: number;
+}
+
+export class OidcIdentityProvider extends Context.Service<
+  OidcIdentityProvider,
+  {
+    readonly authorize: (input: {
+      state: string;
+      nonce: string;
+      verifier: string;
+    }) => Effect.Effect<string, OidcProviderError>;
+    readonly exchange: (input: {
+      url: string;
+      state: string;
+      nonce: string;
+      verifier: string;
+    }) => Effect.Effect<ProviderGrant, OidcProviderError>;
+    readonly refresh: (input: {
+      refreshToken: string;
+      subject: string;
+    }) => Effect.Effect<ProviderGrant, OidcProviderError>;
+    readonly revoke: (refreshToken: string) => Effect.Effect<void, OidcProviderError>;
+  }
+>()("t3/auth/OidcIdentityProvider") {}
+
+const make = Effect.gen(function* () {
+  const { settings } = yield* OidcConfig.OidcConfig;
+  let discovered: client.Configuration | undefined;
+  const discover = Effect.tryPromise({
+    try: async () => {
+      if (!settings) throw new Error("disabled");
+      const config = await client.discovery(
+        new URL(settings.issuer),
+        settings.clientId,
+        { id_token_signed_response_alg: "RS256" },
+        client.ClientSecretPost(Redacted.value(settings.clientSecret)),
+        { timeout: 10 },
+      );
+      client.enableNonRepudiationChecks(config);
+      return config;
+    },
+    catch: () => new OidcProviderError({ reason: settings ? "unavailable" : "disabled" }),
+  });
+  const configuration = Effect.suspend(() =>
+    discovered
+      ? Effect.succeed(discovered)
+      : discover.pipe(
+          Effect.tap((value) =>
+            Effect.sync(() => {
+              discovered = value;
+            }),
+          ),
+        ),
+  );
+  const allowed = (subject: unknown): subject is string =>
+    typeof subject === "string" && settings !== null && settings.allowedSubjects.includes(subject);
+  const authorize: OidcIdentityProvider["Service"]["authorize"] = Effect.fn(
+    "OidcIdentityProvider.authorize",
+  )(function* (input) {
+    const config = yield* configuration;
+    return yield* Effect.tryPromise({
+      try: async () =>
+        client.buildAuthorizationUrl(config, {
+          redirect_uri: `${settings!.publicOrigin}/api/auth/oidc/callback`,
+          scope: "openid profile offline_access",
+          state: input.state,
+          nonce: input.nonce,
+          code_challenge: await client.calculatePKCECodeChallenge(input.verifier),
+          code_challenge_method: "S256",
+        }).href,
+      catch: () => new OidcProviderError({ reason: "unavailable" }),
+    });
+  });
+  const exchange: OidcIdentityProvider["Service"]["exchange"] = Effect.fn(
+    "OidcIdentityProvider.exchange",
+  )(function* (input) {
+    const config = yield* configuration;
+    return yield* Effect.tryPromise({
+      try: async () => {
+        const tokens = await client.authorizationCodeGrant(config, new URL(input.url), {
+          pkceCodeVerifier: input.verifier,
+          expectedState: input.state,
+          expectedNonce: input.nonce,
+          idTokenExpected: true,
+        });
+        const subject = tokens.claims()?.sub;
+        if (!allowed(subject) || !tokens.refresh_token) throw new Error("rejected");
+        return {
+          subject,
+          refreshToken: tokens.refresh_token,
+          expiresIn: Math.min(900, tokens.expires_in ?? 900),
+        };
+      },
+      catch: providerFailure,
+    });
+  });
+  const refresh: OidcIdentityProvider["Service"]["refresh"] = Effect.fn(
+    "OidcIdentityProvider.refresh",
+  )(function* (input) {
+    const config = yield* configuration;
+    return yield* Effect.tryPromise({
+      try: async () => {
+        if (!allowed(input.subject)) throw new Error("rejected");
+        const tokens = await client.refreshTokenGrant(config, input.refreshToken, {
+          scope: "openid profile offline_access",
+        });
+        const claims = tokens.claims();
+        // Authentik refreshes include signed identity; a second request could lose an already-rotated token.
+        if (!claims || claims.sub !== input.subject || !allowed(claims.sub)) {
+          throw new Error("rejected");
+        }
+        return {
+          subject: input.subject,
+          refreshToken: tokens.refresh_token ?? input.refreshToken,
+          expiresIn: Math.min(900, tokens.expires_in ?? 900),
+        };
+      },
+      catch: providerFailure,
+    });
+  });
+  const revoke: OidcIdentityProvider["Service"]["revoke"] = Effect.fn(
+    "OidcIdentityProvider.revoke",
+  )(function* (token) {
+    const config = yield* configuration;
+    yield* Effect.tryPromise({
+      try: () => client.tokenRevocation(config, token, { token_type_hint: "refresh_token" }),
+      catch: () => new OidcProviderError({ reason: "unavailable" }),
+    });
+  });
+  return { authorize, exchange, refresh, revoke };
+});
+
+export const layer = Layer.effect(OidcIdentityProvider, make);
