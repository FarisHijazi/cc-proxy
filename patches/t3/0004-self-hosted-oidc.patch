+                    ? Effect.succeed(false)
+                    : owner.rotateOidcGrant(input),
+            };
+          }),
+        ).pipe(Layer.provideMerge(faultySessions));
+        const layer = OidcAuth.layer.pipe(
+          Layer.provideMerge(faultyRepository),
+          Layer.provide(provider((token) => providerTokens.push(token))),
+          Layer.provide(Layer.succeed(OidcConfig.OidcConfig, { settings })),
+        );
+        return Effect.gen(function* () {
+          const { auth, token } = yield* login;
+          const sessions = yield* SessionStore.SessionStore;
+          const secrets = yield* ServerSecretStore.ServerSecretStore;
+          const original = yield* sessions.verify(token.access_token);
+          armed = true;
+          expect(
+            (yield* Effect.result(
+              auth.token(
+                { grant_type: "refresh_token", refresh_token: token.refresh_token },
+                metadata,
+              ),
+            ))._tag,
+          ).toBe("Failure");
+          const stored = yield* secrets.get(`oidc-refresh-${token.refresh_token.split(".")[0]}`);
+          expect(Option.isSome(stored) && new TextDecoder().decode(stored.value)).toBe(
+            "rotated-provider-refresh",
+          );
+          yield* sessions.verify(token.access_token);
+          expect((yield* sessions.listActive()).map((session) => session.sessionId)).toEqual([
+            original.sessionId,
+          ]);
+          armed = false;
+          const recovered = yield* auth.token(
+            { grant_type: "refresh_token", refresh_token: token.refresh_token },
+            metadata,
+          );
+          yield* sessions.verify(recovered.access_token);
+          expect(providerTokens).toEqual(["provider-refresh", "rotated-provider-refresh"]);
+        }).pipe(Effect.provide(layer));
+      },
+    );
+
+    it.effect(
+      "allows offline return after access expiry but not past the absolute grant lifetime",
+      () =>
+        Effect.gen(function* () {
+          const { auth, token } = yield* login;
+          yield* TestClock.adjust("1 day");
+          const renewed = yield* auth.token(
