+it("highlights live sessions by urgency, animating only with motion allowed", () => {
+  const highlight = (state?: "running" | "idle" | "requires_action" | "unavailable") =>
+    externalSessionStatus(state === undefined ? identity : { ...identity, state }).highlightClass;
+  expect(highlight("requires_action")).toContain("bg-warning");
+  expect(highlight("requires_action")).toContain("motion-safe:animate-");
+  expect(highlight("running")).toContain("bg-info");
+  expect(highlight("running")).toContain("motion-safe:animate-");
+  expect(highlight("idle")).toContain("bg-success");
+  expect(highlight("idle")).not.toContain("animate-");
+  expect(highlight("unavailable")).toBeNull();
+  expect(highlight()).toBeNull();
+  for (const state of ["running", "requires_action"] as const)
+    expect(
+      highlight(state)
+        ?.split(" ")
+        .filter((name) => name.includes("animate-")),
+    ).toSatisfy((names: string[]) => names.every((name) => name.startsWith("motion-safe:")));
+});
