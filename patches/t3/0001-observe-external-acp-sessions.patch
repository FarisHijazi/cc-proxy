 describe("AcpRegistryAdapterV2", () => {
+  it.effect("fails an external import without starting an unbound replacement", () =>
+    Effect.gen(function* () {
+      let starts = 0;
+      const result = yield* openClaudeReplaySession(
+        [
+          claudeFrames.open[0],
+          {
+            type: "emit_inbound",
+            frame: {
+              kind: "response",
+              method: "initialize",
+              result: {
+                protocolVersion: 2,
+                info: { name: "external-fixture", version: "1" },
+                capabilities: { session: {} },
+                _meta: { "t3.codes/externalSession": true },
+              },
+            },
+          },
+          {
+            type: "expect_outbound",
+            frame: { kind: "request", method: "session/resume", params: "<any>" },
+          },
+          {
+            type: "emit_inbound",
+            frame: {
+              kind: "response",
+              method: "session/resume",
+              error: { code: -32000, message: "Existing session unavailable" },
+            },
+          },
+        ],
+        undefined,
+        true,
+        "claude-acp",
+        "missing-native-session",
+        {
+          activationError: new EffectAcpErrors.AcpTransportError({
+            detail: "Existing session unavailable",
+            method: "session/resume",
+            cause: "test",
+          }),
+          onRuntimeStart: () => {
+            starts += 1;
+            if (starts > 1) throw new Error("Unexpected replacement runtime");
+          },
+        },
+      ).pipe(Effect.exit);
+      assert.isTrue(Exit.isFailure(result));
+      assert.equal(starts, 1);
+    }).pipe(Effect.provide(layerTest), Effect.scoped),
+  );
+
+  it.effect("marks external cancellation transport failure as delivery unknown", () =>
+    Effect.gen(function* () {
+      const session = yield* openClaudeReplaySession(
+        [
+          claudeFrames.open[0],
+          {
+            type: "emit_inbound",
+            frame: {
+              kind: "response",
+              method: "initialize",
+              result: {
+                protocolVersion: 2,
+                info: { name: "external-fixture", version: "1" },
+                capabilities: { session: {} },
+                _meta: { "t3.codes/externalSession": true },
+              },
+            },
+          },
+          ...claudeFrames.open.slice(2),
+          ...claudeFrames.prompt(1),
+          claudeMarker("external working"),
+          claudeFrames.closeRequest,
+          claudeFrames.closed,
+        ],
+        undefined,
+        true,
+        "claude-acp",
+        undefined,
+        {
+          cancelError: new EffectAcpErrors.AcpTransportError({
+            detail: "Cancellation transport failed",
+            cause: "test",
+          }),
+        },
+      );
+      const input = session.turnInput(1);
+      yield* session.runtime.startTurn(input);
+      const started = yield* session.throughMarker("external working");
+      const turn = started.find((event) => event.type === "provider_turn.updated");
+      if (turn?.type !== "provider_turn.updated") throw new Error("Missing running turn");
+      const error = yield* session.runtime
+        .interruptTurn({
+          providerThread: input.providerThread,
+          providerTurnId: turn.providerTurn.id,
+          requestRuntimeRestart: true,
+        })
+        .pipe(Effect.flip);
+      if (error._tag !== "ProviderAdapterInterruptError")
+        throw new Error("Missing typed cancellation failure");
+      assert.isTrue(error.deliveryUnknown);
+      assert.isTrue(yield* session.runtime.hasPendingBackgroundWork!);
+    }).pipe(Effect.provide(layerTest), Effect.scoped),
+  );
+
+  it.effect("cancels external active work and waits for idle without closing its session", () =>
+    Effect.gen(function* () {
+      const gate = makeProviderReplayGate(["cancelled-idle"]);
+      const session = yield* openClaudeReplaySession(
+        [
+          claudeFrames.open[0],
+          {
+            type: "emit_inbound",
+            frame: {
+              kind: "response",
+              method: "initialize",
+              result: {
+                protocolVersion: 2,
+                info: { name: "external-fixture", version: "1" },
+                capabilities: { session: {} },
+                _meta: { "t3.codes/externalSession": true },
+              },
+            },
+          },
+          ...claudeFrames.open.slice(2),
+          ...claudeFrames.prompt(1),
+          claudeMarker("external working"),
+          {
+            type: "expect_outbound",
+            frame: {
+              kind: "notification",
+              method: "session/cancel",
+              params: { sessionId: CLAUDE_ROOT_SESSION },
+            },
+          },
+          claudeMarker("cancel dispatched"),
+          { ...claudeFrames.idle("cancelled"), label: "cancelled-idle" },
+          claudeFrames.closeRequest,
+          claudeFrames.closed,
+        ],
+        gate,
+      );
+      assert.isTrue(session.runtime.providerSession.capabilities.threads.canInterruptThread);
+      const input = session.turnInput(1);
+      yield* session.runtime.startTurn(input);
+      const started = yield* session.throughMarker("external working");
+      const turn = started.find((event) => event.type === "provider_turn.updated");
+      if (turn?.type !== "provider_turn.updated") throw new Error("Missing running provider turn");
+      const stopping = yield* session.runtime
+        .interruptTurn({
+          providerThread: input.providerThread,
+          providerTurnId: turn.providerTurn.id,
+          requestRuntimeRestart: true,
+        })
+        .pipe(Effect.forkScoped);
+      const beforeIdle = yield* session.throughMarker("cancel dispatched");
+      assert.isFalse(beforeIdle.some((event) => event.type === "turn.terminal"));
+      gate.release("cancelled-idle");
+      yield* Fiber.join(stopping);
+      const stopped = yield* session.until((event) => event.type === "turn.terminal");
+      const terminal = stopped.at(-1);
+      assert.isTrue(terminal?.type === "turn.terminal" && terminal.status === "cancelled");
+      assert.isTrue(
+        stopped.some(
+          (event) =>
+            event.type === "provider_thread.updated" && event.providerThread.status === "idle",
+        ),
+      );
+    }).pipe(Effect.provide(layerTest), Effect.scoped),
+  );
+
+  it.effect("binds an explicit native prompt echo and response to replay identities", () =>
+    Effect.gen(function* () {
+      const session = yield* openClaudeReplaySession([
+        ...claudeFrames.open,
+        {
+          type: "expect_outbound",
+          frame: {
+            kind: "request",
+            method: "session/prompt",
+            params: {
+              sessionId: CLAUDE_ROOT_SESSION,
+              prompt: "<any>",
+              _meta: { "t3.codes/messageId": "message-claude-lifecycle-1" },
+            },
+          },
+        },
+        claudeFrames.update(CLAUDE_ROOT_SESSION, {
+          sessionUpdate: "user_message",
+          messageId: "actual-native-user",
+          content: [{ type: "text", text: "Native reformatted prompt" }],
+          _meta: { "t3.codes/messageId": "message-claude-lifecycle-1" },
+        }),
+        claudeFrames.prompt(1)[2],
+        claudeFrames.update(CLAUDE_ROOT_SESSION, {
+          sessionUpdate: "agent_message",
+          messageId: "actual-native-answer",
+          content: [{ type: "text", text: "Native answer" }],
+        }),
+        claudeFrames.idle("end_turn"),
+        claudeFrames.closeRequest,
+        claudeFrames.closed,
+      ]);
+      assert.isFalse(session.runtime.providerSession.capabilities.threads.canInterruptThread);
+      const input = session.turnInput(1);
+      yield* session.runtime.startTurn(input);
+      const events = yield* session.until((event) => event.type === "turn.terminal");
+      const userItem = events.find(
+        (event) => event.type === "turn_item.updated" && event.turnItem.type === "user_message",
+      );
+      if (userItem?.type !== "turn_item.updated" || userItem.turnItem.type !== "user_message")
+        throw new Error("Missing native prompt binding");
+      assert.equal(
+        userItem.turnItem.id,
+        (yield* IdAllocator.IdAllocatorV2).derive.userTurnItem({
+          messageId: input.message.messageId,
+        }),
+      );
+      assert.equal(userItem.turnItem.messageId, input.message.messageId);
+      assert.equal(userItem.turnItem.text, "test prompt");
+      assert.equal(
+        userItem.turnItem.nativeItemRef?.nativeId,
+        `${CLAUDE_ROOT_SESSION}:history:user:message:actual-native-user`,
+      );
+      const assistant = events.findLast(
+        (event) => event.type === "message.updated" && event.message.role === "assistant",
+      );
+      if (assistant?.type !== "message.updated") throw new Error("Missing native response");
+      assert.equal(
+        assistant.nativeItemRef?.nativeId,
+        `${CLAUDE_ROOT_SESSION}:history:assistant:message:actual-native-answer`,
+      );
+      assert.equal(assistant.providerThreadId, input.providerThread.id);
+    }).pipe(Effect.provide(layerTest), Effect.scoped),
+  );
+
+  it.effect.each([
+    { kind: "approval", decision: "accept" },
+    { kind: "approval", decision: "decline" },
+    { kind: "question", decision: "accept" },
+    { kind: "question", decision: "cancel" },
+    { kind: "approval", decision: "withdraw" },
+    { kind: "question", decision: "withdraw" },
+  ] as const)("answers a preexisting external $kind with $decision before any prompt", (testCase) =>
+    Effect.gen(function* () {
+      const gate = makeProviderReplayGate(["withdrawal"]);
+      const method =
+        testCase.kind === "approval" ? "session/request_permission" : "elicitation/create";
+      const params =
+        testCase.kind === "approval"
+          ? {
+              sessionId: CLAUDE_ROOT_SESSION,
+              toolCall: {
+                toolCallId: "existing-control",
+                title: "Run selected command",
+                kind: "execute",
+                status: "pending",
+                rawInput: { command: "test" },
+              },
+              options: [
+                { optionId: "allow", name: "Allow once", kind: "allow_once" },
+                { optionId: "deny", name: "Deny", kind: "reject_once" },
+              ],
+            }
+          : {
+              sessionId: CLAUDE_ROOT_SESSION,
+              mode: "form",
+              message: "Choose a file",
+              requestedSchema: {
+                type: "object",
+                properties: { file: { type: "string", enum: ["a.ts", "b.ts"] } },
+                required: ["file"],
+              },
+            };
+      const session = yield* openClaudeReplaySession(
+        [
+          claudeFrames.open[0],
+          {
+            type: "emit_inbound",
+            frame: {
+              kind: "response",
+              method: "initialize",
+              result: {
+                protocolVersion: 1,
+                agentInfo: { name: "external-fixture", version: "1" },
+                agentCapabilities: { loadSession: true, sessionCapabilities: { close: {} } },
+                authMethods: [],
+                _meta: { "t3.codes/externalSession": { version: 1 } },
+              },
+            },
+          },
+          {
+            type: "expect_outbound",
+            frame: { kind: "request", method: "session/load", params: "<any>" },
+          },
+          claudeFrames.update(CLAUDE_ROOT_SESSION, {
+            sessionUpdate: "session_info_update",
+            _meta: {
+              "t3.codes/externalSessionState": { version: 1, state: "requires_action" },
+            },
+          }),
+          { type: "emit_inbound", frame: { kind: "response", method: "session/load", result: {} } },
+          { type: "emit_inbound", frame: { kind: "request", method, params } },
+          ...(testCase.decision === "withdraw"
+            ? [
+                {
+                  type: "emit_inbound",
+                  label: "withdrawal",
+                  frame: {
+                    kind: "notification",
+                    method: "$/cancel_request",
+                    params: { requestId: 999 },
+                  },
+                },
+                claudeMarker("unrelated withdrawal ignored"),
+                {
+                  type: "expect_outbound",
+                  frame: {
+                    kind: "notification",
+                    method: "session/cancel",
+                    params: { sessionId: CLAUDE_ROOT_SESSION },
+                  },
+                },
+                {
+                  type: "emit_inbound",
+                  frame: {
+                    kind: "notification",
+                    method: "$/cancel_request",
+                    params: { requestId: 1 },
+                  },
+                },
+                claudeMarker("withdrawal processed"),
+              ]
+            : []),
+          {
+            type: "expect_outbound",
+            frame: {
+              kind: "response",
+              method,
+              result:
+                testCase.kind === "approval"
+                  ? testCase.decision === "withdraw"
+                    ? { outcome: { outcome: "cancelled" } }
+                    : {
+                        outcome: {
+                          outcome: "selected",
+                          optionId: testCase.decision === "accept" ? "allow" : "deny",
+                        },
+                      }
+                  : testCase.decision === "accept"
+                    ? { action: "accept", content: { file: "a.ts" } }
+                    : { action: "cancel" },
+            },
+          },
+          claudeMarker("external request answered"),
+          claudeFrames.closeRequest,
+          claudeFrames.closed,
+        ],
+        gate,
+        false,
+        "fleet-fixture",
+        CLAUDE_ROOT_SESSION,
+        { runtimeMode: "full-access" },
+      );
+      const earlyResponse = Effect.gen(function* () {
+        while (true) {
+          const frame = (yield* Queue.take(session.outgoing)) as {
+            result?: unknown;
+            error?: unknown;
+          };
+          if ("result" in frame || "error" in frame) return [];
+        }
+      });
+      const events = yield* Effect.raceFirst(
+        session.until((event) => event.type === "runtime_request.updated"),
+        earlyResponse,
+      );
+      const event = events.find((event) => event.type === "runtime_request.updated");
+      assert.isDefined(event, "The external request must wait for the owner's explicit answer");
+      if (event?.type !== "runtime_request.updated") throw new Error("Missing external request");
+      assert.isNull(event.runtimeRequest.providerTurnId);
+      const node = events.find((event) => event.type === "node.updated");
+      if (node?.type !== "node.updated") throw new Error("Missing external request node");
+      assert.isNull(node.node.runId);
+      assert.isNull(node.node.parentNodeId);
+      assert.equal(node.node.providerThreadId, session.providerThread.id);
+      if (testCase.decision === "withdraw") {
+        gate.release("withdrawal");
+        const unchanged = yield* session.throughMarker("unrelated withdrawal ignored");
+        assert.isFalse(
+          unchanged.some(
+            (event) =>
+              event.type === "runtime_request.updated" &&
+              event.runtimeRequest.status === "cancelled",
+          ),
+        );
+        yield* session.runtime.interruptThread!({ providerThread: session.providerThread });
+        const withdrawn = yield* session.throughMarker("withdrawal processed");
+        assert.isTrue(
+          withdrawn.some(
+            (candidate) =>
+              candidate.type === "runtime_request.updated" &&
+              candidate.runtimeRequest.id === event.runtimeRequest.id &&
+              candidate.runtimeRequest.status === "cancelled",
+          ),
+        );
+      } else {
+        yield* session.runtime.respondToRuntimeRequest({
+          requestId: event.runtimeRequest.id,
+          ...(testCase.kind === "approval"
+            ? { decision: testCase.decision }
+            : testCase.decision === "accept"
+              ? { answers: { file: "a.ts" } }
+              : {}),
+        });
+      }
+      const settled = yield* session.throughMarker("external request answered");
+      assert.isFalse(
+        settled.some(
+          (event) => event.type === "turn.terminal" || event.type === "provider_turn.updated",
+        ),
+      );
+      assert.isEmpty(session.offers);
+    }).pipe(Effect.provide(layerTest), Effect.scoped),
+  );
+
+  it.effect(
+    "projects canonical native input only after the exact external dispatch is accepted",
+    () =>
+      Effect.gen(function* () {
+        const session = yield* openClaudeReplaySession(
+          [
+            claudeFrames.open[0],
+            {
+              type: "emit_inbound",
+              frame: {
+                kind: "response",
+                method: "initialize",
+                result: {
+                  protocolVersion: 1,
+                  agentInfo: { name: "external-fixture", version: "1" },
