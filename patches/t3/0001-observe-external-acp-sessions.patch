diff --git a/packages/provider-acp/src/server/externalSession.ts b/packages/provider-acp/src/server/externalSession.ts
new file mode 100644
index 00000000..7cb57629
--- /dev/null
+++ b/packages/provider-acp/src/server/externalSession.ts
@@ -0,0 +1,45 @@
+export function supportsExternalSession(
+  metadata: Readonly<Record<string, unknown>> | null | undefined,
+) {
+  const value = metadata?.["t3.codes/externalSession"];
+  return (
+    value === true ||
+    (typeof value === "object" && value !== null && "version" in value && value.version === 1)
+  );
+}
+
+export function externalSessionState(
+  metadata: Readonly<Record<string, unknown>> | null | undefined,
+) {
+  const value = metadata?.["t3.codes/externalSessionState"];
+  if (
+    typeof value !== "object" ||
+    value === null ||
+    !("version" in value) ||
+    value.version !== 1 ||
+    !("state" in value)
+  )
+    return null;
+  return value.state === "running" ||
+    value.state === "idle" ||
+    value.state === "requires_action" ||
+    value.state === "unavailable"
+    ? value.state
+    : null;
+}
+
+export function acceptedExternalSessionInput(
+  metadata: Readonly<Record<string, unknown>> | null | undefined,
+) {
+  const value = metadata?.["t3.codes/externalSessionDispatch"];
+  return typeof value === "object" &&
+    value !== null &&
+    "version" in value &&
+    value.version === 1 &&
+    "state" in value &&
+    value.state === "accepted" &&
+    "messageId" in value &&
+    typeof value.messageId === "string"
+    ? value.messageId
+    : null;
+}
