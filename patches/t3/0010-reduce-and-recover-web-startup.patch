diff --git a/apps/web/src/bootstrap.test.ts b/apps/web/src/bootstrap.test.ts
new file mode 100644
index 00000000..ef20c322
--- /dev/null
+++ b/apps/web/src/bootstrap.test.ts
@@ -0,0 +1,70 @@
+import { describe, expect, it, vi } from "vite-plus/test";
+
+const mocks = vi.hoisted(() => ({ showBootError: vi.fn().mockName("showBootError") }));
+
+vi.mock("./lib/bootError", () => ({ showBootError: mocks.showBootError }));
+
+// Mirrors Vite's build preload helper when main's CSS or JS chunk fails to load.
+vi.mock("./main", () => {
+  const error = new TypeError("Failed to fetch dynamically imported module: /assets/main.js");
+  const event = Object.assign(new Event("vite:preloadError", { cancelable: true }), {
+    payload: error,
+  });
+  window.dispatchEvent(event);
+  throw error;
+});
+
+function createStorageStub(initial: Record<string, string> = {}): Storage {
+  const store = new Map(Object.entries(initial));
+  return {
+    getItem: (key) => store.get(key) ?? null,
+    setItem: (key, value) => {
+      store.set(key, value);
+    },
+    removeItem: (key) => {
+      store.delete(key);
+    },
+    clear: () => store.clear(),
+    key: (index) => [...store.keys()][index] ?? null,
+    get length() {
+      return store.size;
+    },
+  };
+}
+
+async function bootWithFailingMainChunk(storage: Storage) {
+  vi.resetModules();
+  mocks.showBootError.mockClear();
+  const reload = vi.fn().mockName("location.reload");
+  const page = Object.assign(new EventTarget(), { sessionStorage: storage, location: { reload } });
+  const dispatch = vi.spyOn(page, "dispatchEvent");
+  vi.stubGlobal("window", page);
+  try {
+    const { boot } = await import("./bootstrap");
+    await boot;
+    const event = dispatch.mock.calls[0]?.[0];
+    return { reload, showBootError: mocks.showBootError, event };
+  } finally {
+    vi.unstubAllGlobals();
+  }
+}
+
+describe("bootstrap", () => {
+  it("reloads once instead of showing the boot error when the main chunk fails to load", async () => {
+    const { reload, showBootError, event } = await bootWithFailingMainChunk(createStorageStub());
+
+    expect(event?.defaultPrevented).toBe(true);
+    expect(reload).toHaveBeenCalledTimes(1);
+    expect(showBootError).not.toHaveBeenCalled();
+  });
+
+  it("shows the boot error when the main chunk fails again after the reload", async () => {
+    const { reload, showBootError, event } = await bootWithFailingMainChunk(
+      createStorageStub({ "t3code:chunk-load-reloaded": import.meta.env.APP_VERSION }),
+    );
+
+    expect(event?.defaultPrevented).toBe(false);
+    expect(reload).not.toHaveBeenCalled();
+    expect(showBootError).toHaveBeenCalledTimes(1);
+  });
+});
