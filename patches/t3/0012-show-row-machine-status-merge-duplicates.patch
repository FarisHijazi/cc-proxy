+  const match = LEGACY_FLEET_LABEL.exec(title);
+  if (match === null) return undefined;
+  const [, transport, rest] = match as unknown as [string, string, string];
+  const titled = transport === "tmux" ? /^\S+ — (.+)$/.exec(rest) : null;
+  return (titled?.[1] ?? rest).trim() || undefined;
+};
