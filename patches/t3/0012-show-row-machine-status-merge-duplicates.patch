+
+it("reads a discovered title out of the legacy fleet label", () => {
+  const strip = AcpRegistrySessions.withoutLegacyFleetLabel;
+  assert.equal(strip("[Dev / Dev · tmux] rcwd-b — Claude reply"), "Claude reply");
+  assert.equal(strip("[Work / Work · tmux] hydrolix"), "hydrolix");
+  assert.equal(strip("[Remote Control · native] hq-reply-radar-1"), "hq-reply-radar-1");
+  assert.equal(strip("[Dev / Codex · codex] Reply — with dash"), "Reply — with dash");
+  assert.isUndefined(strip("[draft] my own name"));
+  assert.isUndefined(strip("Reply drafts runway"));
+});
+
+it.effect("replaces a legacy fleet label on a listed thread and marks unlisted ones offline", () =>
+  Effect.gen(function* () {
+    const f = yield* fixture();
+    const sql = yield* SqlClient.SqlClient;
+    const at = DateTime.makeUnsafe(timestamp);
+    const identity = {
+      version: 1 as const,
+      engine: "claude-code" as const,
+      connection: { kind: "fleet" as const, host: "Work", transport: "tmux" as const },
+      capabilities: {
+        send: true,
+        interrupt: true,
+        respond: false,
+        setModel: false,
+        setPermissionMode: false,
+        terminal: false,
+      },
+      state: "running" as const,
+    };
+    const owner = (sessionId: string, title: string) => ({
+      id: ProviderThreadId.make(`${sessionId}-provider`),
+      appThreadId: threadId(sessionId),
+      driver,
+      providerInstanceId: instanceId,
+      providerSessionId: null,
+      ownerNodeId: null,
+      nativeThreadRef: { driver, nativeId: sessionId, strength: "strong" as const },
+      nativeConversationHeadRef: null,
+      nativeMetadata: { title, externalSession: identity },
+      lastRunOrdinal: null,
+      handoffIds: [],
+      forkedFrom: null,
+      status: "idle" as const,
+      firstRunOrdinal: 1,
+      createdAt: at,
+      updatedAt: at,
+    });
+
+    // Listed: the stored discovery title is an older legacy label than the thread's.
+    yield* f.seed(threadId("live"));
+    f.setIdentityRecord(
+      owner("live", "[Work / Work · tmux] coach"),
+      false,
+      "[Work / Work · tmux] hq-reply-radar-1 — coach",
+    );
+    f.setResult(() =>
+      Effect.succeed({
+        ...page(["live"]),
+        sessions: page(["live"]).sessions.map((session) => ({
+          ...session,
+          title: "Reply drafts runway",
+          externalSession: identity,
+        })),
+      }),
+    );
+    yield* f.sessions.reconcile;
+    const renamed = f.metadataEvents.find((event) => event.type === "thread.metadata-updated");
+    assert.equal(
+      renamed?.type === "thread.metadata-updated" && renamed.payload.title,
+      "Reply drafts runway",
+    );
+
+    // Unlisted: the session ended, so it shows offline under its own name.
+    f.metadataEvents.length = 0;
+    const gone = {
+      ...owner("gone", "[Work / Work · tmux] coach"),
+      nativeMetadata: {
+        title: "[Work / Work · tmux] coach",
+        externalSession: {
+          ...identity,
+          connection: { ...identity.connection, host: "Work / Work" },
+        },
+      },
+    };
+    yield* sql`
+      INSERT INTO orchestration_v2_projection_threads (
+        thread_id, project_id, title, default_provider, runtime_mode, interaction_mode,
+        active_provider_thread_id, created_at, updated_at, payload_json
+      ) VALUES (
+        ${threadId("gone")}, ${projectId}, '[Work / Work · tmux] hq-reply-radar-1 — coach',
+        ${instanceId}, 'approval-required', 'default', ${gone.id}, ${timestamp}, ${timestamp}, '{}'
+      )
+    `;
+    yield* sql`
+      INSERT INTO orchestration_v2_projection_provider_threads (
+        provider_thread_id, thread_id, provider, status, updated_at, payload_json, driver, provider_instance_id
+      ) VALUES (
+        ${gone.id}, ${threadId("gone")}, ${instanceId}, 'idle', ${timestamp},
+        ${JSON.stringify({ nativeThreadRef: { nativeId: "gone" }, nativeMetadata: { externalSession: identity } })},
+        ${driver}, ${instanceId}
+      )
+    `;
+    f.setIdentityRecord(gone, false, "[Work / Work · tmux] hq-reply-radar-1 — coach");
+    f.setResult(() => Effect.succeed(page([])));
+    yield* f.sessions.reconcile;
+    const [provider, thread] = f.metadataEvents;
+    if (provider?.type !== "provider-thread.updated") return assert.fail();
+    if (thread?.type !== "thread.metadata-updated") return assert.fail();
+    assert.equal(provider.payload.nativeMetadata?.externalSession?.state, "unavailable");
+    assert.equal(provider.payload.nativeMetadata?.externalSession?.connection.host, "Work");
+    assert.equal(provider.payload.nativeMetadata?.title, "coach");
+    assert.equal(thread.payload.title, "coach");
+    assert.deepEqual(thread.payload.updatedAt, at);
+    // Already settled: another pass writes nothing.
+    yield* f.sessions.reconcile;
+    assert.equal(f.metadataEvents.length, 2);
+    assert.deepEqual(f.launched, []);
+    assert.deepEqual(f.historyLoads, []);
+  }).pipe(Effect.scoped, Effect.provide(SqlitePersistence.layerMemory)),
+);
