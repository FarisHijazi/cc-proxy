 .../src/provider/AcpRegistrySessions.ts       | 186 ++++++++++++++----
 apps/web/src/components/Sidebar.logic.ts      |   9 +-
 .../components/sidebar/SidebarThreadRow.tsx   |  28 ++-
 .../src/externalSessionPresentation.test.ts   |  34 ++++
 apps/web/src/externalSessionPresentation.ts   |  12 ++
 packages/contracts/src/externalSession.ts     |   2 +
 7 files changed, 343 insertions(+), 49 deletions(-)

