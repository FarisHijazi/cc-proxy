@@ -0,0 +1,66 @@
+import { createMemoryHistory } from "@tanstack/react-router";
+import { DEFAULT_CLIENT_SETTINGS } from "@t3tools/contracts/settings";
+import type * as Context from "effect/Context";
+import { expect, it, vi } from "vite-plus/test";
+import { page } from "vite-plus/test/browser";
+
+import { AppRoot } from "~/AppRoot";
+import { __setClientSettingsForTests } from "~/hooks/useSettings";
+import { getRouter } from "~/router";
+import { installFakeEnvironment, type FakeDriver } from "../test/fakeEnvironment";
+import { act, render } from "../test/render";
+import { Route } from "./routes/auth.oidc.callback";
+
+vi.mock("../../../packages/client-runtime/src/connection/driver.ts", async (importOriginal) => {
+  const [actual, { fakeDriver }, Layer] = await Promise.all([
+    importOriginal<{ readonly ConnectionDriver: Context.Key<unknown, FakeDriver> }>(),
+    import("../test/fakeEnvironment"),
+    import("effect/Layer"),
+  ]);
+  return { ...actual, layer: Layer.succeed(actual.ConnectionDriver, fakeDriver) };
+});
+vi.mock(import("~/rpc/requestLatencyState"), async (original) => ({
+  ...(await original()),
+  trackRpcRequestSent: () => {},
+}));
+
+it("keeps Settings inside its sidebar provider while an OIDC callback is pending", async () => {
+  using _environment = installFakeEnvironment([]);
+  __setClientSettingsForTests({
+    ...DEFAULT_CLIENT_SETTINGS,
+    onboardingCompletedAt: "2026-01-01T00:00:00.000Z",
+  });
+  let complete = () => {};
+  const pending = new Promise<void>((resolve) => {
+    complete = resolve;
+  });
+  using callback = vi.spyOn(Route.options, "beforeLoad").mockImplementation(async () => {
+    await pending;
+  });
+  const router = getRouter(createMemoryHistory({ initialEntries: ["/settings/general"] }));
+  await router.load();
+  // AppRoot owns the real application router.
+  await using _app = await render(<AppRoot router={router} />, { router: false });
+  await expect.element(page.getByRole("dialog", { name: "Settings", exact: true })).toBeVisible();
+
+  const navigation = router.navigate({ to: "/auth/oidc/callback" });
+  try {
+    await vi.waitFor(() => expect(callback).toHaveBeenCalledOnce());
+    await expect.element(page.getByRole("dialog", { name: "Settings", exact: true })).toBeVisible();
+    await expect
+      .element(page.getByText("Something went wrong.", { exact: true }))
+      .not.toBeInTheDocument();
+  } finally {
+    await act(async () => {
+      complete();
+      await navigation;
+    });
+  }
+
+  await expect
+    .element(page.getByRole("heading", { name: "Sign in to your workspace" }))
+    .toBeVisible();
+  await expect
+    .element(page.getByRole("dialog", { name: "Settings", exact: true }))
+    .not.toBeInTheDocument();
+});
