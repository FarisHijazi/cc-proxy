+// @effect-diagnostics nodeBuiltinImport:off
+import * as NodeURL from "node:url";
+import * as NodeCrypto from "@effect/platform-node/NodeCrypto";
+import * as NodeServices from "@effect/platform-node/NodeServices";
+import { assert, it } from "@effect/vitest";
+import { ProviderInstanceId } from "@t3tools/contracts";
+import * as HostProcess from "@t3tools/shared/HostProcess";
+import * as TestProviderHost from "@t3tools/provider-testing/TestProviderHost";
+import * as Effect from "effect/Effect";
+import * as FileSystem from "effect/FileSystem";
+import * as Layer from "effect/Layer";
+import * as Schema from "effect/Schema";
+import { AcpRegistrySettings } from "../settings.ts";
+import * as AcpRegistrySupport from "./AcpRegistrySupport.ts";
+import { listAcpRegistrySessions } from "./probe.ts";
+
+const settings = Schema.decodeSync(AcpRegistrySettings)({
+  source: "local",
+  commandPath: "fixture",
+});
+const layerHost = TestProviderHost.layer().pipe(
+  Layer.provideMerge(Layer.mergeAll(NodeServices.layer, NodeCrypto.layer)),
+);
+
+it.live(
+  "negotiates native identity on the management wire without starting or loading sessions",
+  () =>
+    Effect.gen(function* () {
+      const fs = yield* FileSystem.FileSystem;
+      const cwd = yield* fs.makeTempDirectoryScoped({ prefix: "t3-external-discovery-" });
+      const log = `${cwd}/methods.log`;
+      yield* fs.writeFileString(log, "");
+      const command = yield* HostProcess.ExecutablePath;
+      const result = yield* listAcpRegistrySessions({
+        instanceId: ProviderInstanceId.make("fleet-connection"),
+        settings,
+        cwd,
+        environment: {},
+      }).pipe(
+        Effect.provide(
+          Layer.mock(AcpRegistrySupport.AcpRegistryCatalog)({
+            resolve: () =>
+              Effect.succeed({
+                distribution: "local",
+                spawn: {
+                  command,
+                  args: [
+                    NodeURL.fileURLToPath(
+                      new URL("./testing/externalSession.fixture.mjs", import.meta.url),
+                    ),
+                    log,
+                  ],
+                  cwd,
+                },
+              }),
+          }),
+        ),
+      );
+      assert.deepEqual(
+        result.sessions.map((row) => row.sessionId),
+        ["opaque-claude-route", "opaque-codex-route", "malformed-route"],
+      );
+      assert.deepEqual(
+        result.sessions.map((row) => row.externalSession?.engine),
+        ["claude-code", "codex", undefined],
+      );
+      assert.equal(result.sessions[0]?.externalSession?.connection.host, "worker");
+      assert.isTrue(result.sessions[0]?.externalSession?.capabilities.send);
+      assert.deepEqual((yield* fs.readFileString(log)).trim().split("\n"), [
+        "initialize",
+        "session/list",
+      ]);
+    }).pipe(Effect.scoped, Effect.provide(layerHost)),
+);
