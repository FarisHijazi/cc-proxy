+import * as NodeFS from "node:fs";
+import * as NodeReadline from "node:readline";
+let negotiated = false;
+const identity = (engine, transport) => ({
+  version: 1,
+  engine,
+  connection: { kind: "fleet", host: "worker", transport },
+  capabilities: {
+    send: true,
+    interrupt: true,
+    respond: false,
+    setModel: false,
+    setPermissionMode: false,
+    terminal: false,
+  },
+});
+NodeReadline.createInterface({ input: process.stdin }).on("line", (line) => {
+  const request = JSON.parse(line);
+  if (request.id === undefined) return;
+  NodeFS.appendFileSync(process.argv[2], request.method + "\n");
+  let result;
+  if (request.method === "initialize") {
+    negotiated =
+      request.params.clientCapabilities?._meta?.["t3.codes/externalSession"]?.version === 1;
+    result = {
+      protocolVersion: 1,
