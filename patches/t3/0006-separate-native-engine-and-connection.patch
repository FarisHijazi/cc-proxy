diff --git a/packages/provider-acp/src/server/externalSession.test.ts b/packages/provider-acp/src/server/externalSession.test.ts
new file mode 100644
index 00000000..8448c624
--- /dev/null
+++ b/packages/provider-acp/src/server/externalSession.test.ts
@@ -0,0 +1,73 @@
+import { describe, expect, it } from "@effect/vitest";
+import {
+  externalSessionIdentity,
+  externalSessionConnectionRole,
+  externalSessionRuntimeInfo,
+} from "./externalSession.ts";
+
+const identity = {
+  version: 1,
+  engine: "claude-code",
+  connection: { kind: "fleet", host: "worker", transport: "tmux" },
+  model: "model-a",
+  capabilities: {
+    send: true,
+    interrupt: true,
+    respond: false,
+    setModel: false,
+    setPermissionMode: false,
+    terminal: false,
+  },
+};
+
+describe("external session identity boundary", () => {
+  it("uses the native engine and only observed models in runtime instructions", () => {
+    const claude = externalSessionIdentity({ "t3.codes/externalSessionIdentity": identity });
+    expect(externalSessionRuntimeInfo(claude)).toEqual({
+      harness: "Claude Code",
+      model: "model-a",
+    });
+    expect(externalSessionRuntimeInfo({ ...claude!, engine: "codex" })).toEqual({
+      harness: "Codex",
+      model: "model-a",
+    });
+    expect(externalSessionRuntimeInfo(undefined)).toEqual({ harness: "external session" });
+  });
+  it("retains explicit native identity and requires complete boolean capabilities", () => {
+    expect(externalSessionIdentity({ "t3.codes/externalSessionIdentity": identity })).toEqual(
+      identity,
+    );
+    for (const invalid of [
+      { ...identity, version: 2 },
+      { ...identity, engine: "acpRegistry" },
+      { ...identity, engine: "codex" },
+      { ...identity, connection: { ...identity.connection, host: "" } },
+      { ...identity, capabilities: { send: true } },
+      { ...identity, capabilities: { ...identity.capabilities, send: "true" } },
+      { ...identity, model: "" },
+    ])
+      expect(
+        externalSessionIdentity({ "t3.codes/externalSessionIdentity": invalid }),
+      ).toBeUndefined();
+    expect(externalSessionIdentity({ provider: "claude", model: "model-a" })).toBeUndefined();
+  });
+  it("requires explicit negotiated discovery role", () => {
+    expect(
+      externalSessionConnectionRole({
+        "t3.codes/externalSession": { version: 1 },
+        "t3.codes/connectionRole": { version: 1, role: "discovery" },
+      }),
+    ).toBe("discovery");
+    expect(
+      externalSessionConnectionRole({
+        "t3.codes/connectionRole": { version: 1, role: "discovery" },
+      }),
+    ).toBeUndefined();
+    expect(
+      externalSessionConnectionRole({
+        "t3.codes/externalSession": { version: 1 },
+        "t3.codes/connectionRole": { version: 2, role: "discovery" },
+      }),
+    ).toBeUndefined();
+  });
+});
diff --git a/packages/provider-acp/src/server/externalSession.ts b/packages/provider-acp/src/server/externalSession.ts
index 7cb57629..e2ea04ad 100644
--- a/packages/provider-acp/src/server/externalSession.ts
+++ b/packages/provider-acp/src/server/externalSession.ts
@@ -1,3 +1,45 @@
+import { ExternalSessionIdentity } from "@t3tools/contracts";
+import * as Schema from "effect/Schema";
+
+const isExternalSessionIdentity = Schema.is(ExternalSessionIdentity);
+
+export function externalSessionIdentity(
+  metadata: Readonly<Record<string, unknown>> | null | undefined,
+): ExternalSessionIdentity | undefined {
+  const value = metadata?.["t3.codes/externalSessionIdentity"];
+  return isExternalSessionIdentity(value) &&
+    (value.engine === "codex") === (value.connection.transport === "codex")
+    ? value
+    : undefined;
+}
+
+export function externalSessionRuntimeInfo(identity: ExternalSessionIdentity | undefined) {
+  return {
+    harness:
+      identity?.engine === "claude-code"
+        ? "Claude Code"
+        : identity?.engine === "codex"
+          ? "Codex"
+          : "external session",
+    ...(identity?.model === undefined ? {} : { model: identity.model }),
+  };
+}
