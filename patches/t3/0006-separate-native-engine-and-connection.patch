diff --git a/apps/web/src/externalSessionPresentation.test.ts b/apps/web/src/externalSessionPresentation.test.ts
new file mode 100644
index 00000000..03766372
--- /dev/null
+++ b/apps/web/src/externalSessionPresentation.test.ts
@@ -0,0 +1,55 @@
+import { describe, expect, it } from "vite-plus/test";
+import {
+  externalSessionPresentation,
+  externalSessionSendDisabledReason,
+} from "./externalSessionPresentation";
+
+const identity = {
+  version: 1 as const,
+  engine: "claude-code" as const,
+  connection: { kind: "fleet" as const, host: "node-one", transport: "tmux" as const },
+  capabilities: {
+    send: true,
+    interrupt: true,
+    respond: true,
+    setModel: false,
+    setPermissionMode: false,
+    terminal: false,
+  },
+};
+
+describe("externalSessionPresentation", () => {
+  it("uses the observed engine and model without guessing from transport or local defaults", () => {
+    expect(externalSessionPresentation(identity)).toEqual({
+      driverKind: "claudeAgent",
+      displayName: "Claude Code",
+      modelLabel: "Model unknown",
+      connectionLabel: "node-one · Fleet · tmux",
+    });
+    expect(
+      externalSessionPresentation({ ...identity, engine: "codex", model: "gpt-5.4" }),
+    ).toMatchObject({ driverKind: "codex", displayName: "Codex", modelLabel: "gpt-5.4" });
+    expect(externalSessionPresentation(null)).toBeNull();
+    expect(externalSessionPresentation(null, "discovery")).toMatchObject({
+      displayName: "Agent unknown",
+      modelLabel: "Model unknown",
+    });
+  });
+});
+
+it("gates input by the current session capability and preserves live request responses", () => {
+  const stopped = { ...identity, capabilities: { ...identity.capabilities, send: false } };
+  expect(externalSessionSendDisabledReason(stopped, "discovery", false)).not.toBeNull();
+  expect(externalSessionSendDisabledReason(stopped, "discovery", true)).toBeNull();
+  expect(
+    externalSessionSendDisabledReason(
+      { ...stopped, capabilities: { ...stopped.capabilities, respond: false } },
+      "discovery",
+      true,
+    ),
+  ).not.toBeNull();
+  expect(externalSessionSendDisabledReason(undefined, "discovery", false)).toBe(
+    "Loading session details.",
+  );
+  expect(externalSessionSendDisabledReason(undefined, undefined, false)).toBeNull();
+});
