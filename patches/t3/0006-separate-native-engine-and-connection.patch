+import { ProviderDriverKind, type ExternalSessionIdentity } from "@t3tools/contracts";
+
+export function externalSessionPresentation(
+  session: ExternalSessionIdentity | null | undefined,
+  connectionRole?: "discovery",
+) {
+  if (!session)
+    return connectionRole === "discovery"
+      ? {
+          driverKind: ProviderDriverKind.make("externalSession"),
+          displayName: "Agent unknown",
+          modelLabel: "Model unknown",
+          connectionLabel: "Fleet connection",
+        }
+      : null;
+  return {
+    driverKind: ProviderDriverKind.make(session.engine === "claude-code" ? "claudeAgent" : "codex"),
+    displayName: session.engine === "claude-code" ? "Claude Code" : "Codex",
+    modelLabel: session.model ?? "Model unknown",
+    connectionLabel: `${session.connection.host} · Fleet · ${session.connection.transport}`,
+  };
+}
+
+export function externalSessionSendDisabledReason(
+  session: ExternalSessionIdentity | null | undefined,
+  connectionRole: "discovery" | undefined,
+  answeringRequest: boolean,
+): string | null {
+  if (!session) return connectionRole === "discovery" ? "Loading session details." : null;
+  if (answeringRequest)
+    return session.capabilities.respond
+      ? null
+      : "This connection cannot answer requests for this session.";
+  return session.capabilities.send
+    ? null
+    : "This session cannot accept messages through this connection.";
+}
