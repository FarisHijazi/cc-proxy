+/** Environment options as an external thread should show them: its own machine in place of T3's. */
+export function environmentsForExternalSession<T extends { environmentId: string; label: string }>(
+  environments: readonly T[],
+  environmentId: string | undefined,
+  session: ExternalSessionIdentity | null | undefined,
+): readonly T[] {
+  if (!session) return environments;
+  return environments.map((environment) =>
+    environment.environmentId === environmentId
+      ? { ...environment, label: session.connection.host }
+      : environment,
+  );
+}
