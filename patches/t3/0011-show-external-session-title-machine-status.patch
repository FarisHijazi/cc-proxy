+
+it.effect(
+  "follows the owner's title, machine and activity on existing threads until renamed here",
+  () =>
+    Effect.gen(function* () {
+      const f = yield* fixture();
+      const capabilities = {
+        send: true,
+        interrupt: true,
+        respond: false,
+        setModel: false,
+        setPermissionMode: false,
+        terminal: false,
+      };
+      const imported = {
+        version: 1 as const,
+        engine: "claude-code" as const,
+        connection: {
+          kind: "fleet" as const,
+          host: "Work / Work",
+          transport: "tmux" as const,
+        },
+        capabilities,
+      };
+      const discovered = {
+        ...imported,
+        connection: { ...imported.connection, host: "Work" },
+        state: "running" as const,
+      };
+      const id = threadId("existing");
+      yield* f.seed(id);
+      const at = DateTime.makeUnsafe(timestamp);
+      const oldTitle = "[Work / Work · tmux] hq-reply-radar-1 — coach";
+      const owner = {
+        id: ProviderThreadId.make("existing-provider"),
+        appThreadId: id,
+        driver,
+        providerInstanceId: instanceId,
+        providerSessionId: null,
+        ownerNodeId: null,
+        nativeThreadRef: { driver, nativeId: "existing", strength: "strong" as const },
+        nativeConversationHeadRef: null,
+        nativeMetadata: { title: oldTitle, externalSession: { ...imported, model: "observed" } },
+        lastRunOrdinal: null,
+        handoffIds: [],
+        forkedFrom: null,
+        status: "idle" as const,
+        firstRunOrdinal: 1,
+        createdAt: at,
+        updatedAt: at,
+      };
+      const listing = (title: string, state: "running" | "idle") =>
+        Effect.succeed({
+          ...page(["existing"]),
+          sessions: page(["existing"]).sessions.map((session) => ({
+            ...session,
+            title,
+            externalSession: { ...discovered, state },
+          })),
+        });
+      f.setIdentityRecord(owner, false, oldTitle);
+      f.setResult(() => listing("Reply drafts runway", "running"));
+      yield* f.sessions.reconcile;
+      assert.deepEqual(
+        f.metadataEvents.map((event) => event.type),
+        ["provider-thread.updated", "thread.metadata-updated"],
+      );
+      const [provider, thread] = f.metadataEvents;
+      if (provider?.type !== "provider-thread.updated") return assert.fail();
+      if (thread?.type !== "thread.metadata-updated") return assert.fail();
+      assert.isTrue(provider.metadataOnly);
+      assert.deepEqual(provider.payload.nativeMetadata?.externalSession, {
+        ...discovered,
+        model: "observed",
+      });
+      assert.equal(provider.payload.nativeMetadata?.title, "Reply drafts runway");
+      assert.equal(thread.payload.title, "Reply drafts runway");
+      assert.deepEqual(thread.payload.updatedAt, at);
+      // An unchanged pass writes nothing; a changed activity writes only metadata.
+      yield* f.sessions.reconcile;
+      assert.equal(f.metadataEvents.length, 2);
+      f.setResult(() => listing("Reply drafts runway", "idle"));
+      yield* f.sessions.reconcile;
+      assert.deepEqual(
+        f.metadataEvents.slice(2).map((event) => event.type),
+        ["provider-thread.updated"],
+      );
+      // A title someone chose in T3 is never overwritten by the owner.
+      f.setIdentityRecord(
+        {
+          ...owner,
+          nativeMetadata: { ...owner.nativeMetadata, title: "Reply drafts runway" },
+        },
+        false,
+        "My own name",
+      );
+      f.setResult(() => listing("Renamed by the owner", "idle"));
+      yield* f.sessions.reconcile;
+      assert.isFalse(
+        f.metadataEvents.slice(3).some((event) => event.type === "thread.metadata-updated"),
+      );
+      assert.deepEqual(f.launched, []);
+      assert.deepEqual(f.historyLoads, []);
+    }).pipe(Effect.scoped, Effect.provide(SqlitePersistence.layerMemory)),
+);
