@@ -277,7 +308,164 @@ const make = Effect.gen(function* () {
     return { threadId, imported: true } as const;
   }, coordinator.withSessionMutation);
 
-  return AcpRegistrySessions.of({ project, sessionManager, findOwner, importSession });
+  const importPendingHistory = Effect.fn("AcpRegistrySessions.importPendingHistory")(function* (
+    threadId: ThreadId,
+  ) {
+    const existing = yield* threadManagement.getThreadShell(threadId).pipe(
+      Effect.mapError(
+        (cause) =>
+          new AcpRegistryOperationError({
+            reason: "session_import_failed",
+            message: "Could not inspect external session history.",
+            cause,
+          }),
+      ),
+    );
+    if (
+      existing === null ||
+      !AgentSessionImporter.isNativeHistoryPending({
+        historyOrigin: existing.historyOrigin,
+        hasRun: existing.latestRunId !== null,
+      })
+    )
+      return false;
+    const instance = yield* providerInstances.getInstance(existing.providerInstanceId);
+    if (instance?.acpSessionManagement === undefined) return false;
+    const snapshot = yield* instance.snapshot.getSnapshot;
+    if (snapshot.nativeSessions?.canObserve !== true) return false;
+    const rows = yield* sql<{ readonly native_id: string | null }>`
+      SELECT json_extract(payload_json, '$.nativeThreadRef.nativeId') AS native_id
+      FROM orchestration_v2_projection_provider_threads
+      WHERE thread_id = ${threadId} AND provider_thread_id = ${existing.activeProviderThreadId}
+    `.pipe(
+      Effect.mapError(
+        (cause) =>
+          new AcpRegistryOperationError({
+            reason: "session_import_failed",
+            message: "Could not inspect external session identity.",
+            cause,
+          }),
+      ),
+    );
+    const nativeId = rows[0]?.native_id;
+    if (
+      nativeId == null ||
+      importedThreadId({
+        driver: instance.driverKind,
+        instanceId: instance.instanceId,
+        sessionId: nativeId,
+      }) !== threadId
+    )
+      return false;
+    const destination = yield* project(existing.projectId);
+    yield* agentSessionImporter
+      .importNativeHistory({
+        threadId,
+        workspaceRoot: destination.workspaceRoot,
+        observe: true,
+      })
+      .pipe(
+        Effect.mapError(
+          (cause) =>
+            new AcpRegistryOperationError({
+              reason: "session_import_failed",
+              message: "Could not import external session history.",
+              cause,
+            }),
+        ),
+      );
+    return true;
+  });
+
+  const reconcile = Effect.gen(function* () {
+    const instances = yield* providerInstances.listInstances;
+    yield* Effect.forEach(
+      instances,
+      (instance) =>
+        Effect.gen(function* () {
+          const manager = instance.acpSessionManagement;
+          if (!instance.enabled || manager?.autoImportProjectId === undefined) return;
+          const snapshot = yield* instance.snapshot.getSnapshot;
+          if (
+            snapshot.nativeSessions?.canObserve !== true ||
+            snapshot.nativeSessions.canList !== true
+          )
+            return;
+          const destination = yield* project(manager.autoImportProjectId);
+          if (destination.deletedAt !== null || destination.archivedAt != null) return;
+          const cursors = new Set<string>();
+          let cursor: string | undefined;
+          do {
+            const page = yield* manager.listSessions({
+              cwd: destination.workspaceRoot,
+              ...(cursor === undefined ? {} : { cursor }),
+            });
+            yield* Effect.forEach(
+              page.sessions,
+              (session) =>
+                importSession(
+                  {
+                    instanceId: instance.instanceId,
+                    projectId: destination.id,
+                    sessionId: session.sessionId,
+                    ...(session.title === null ? {} : { title: session.title }),
+                    ...(session.updatedAt === null ? {} : { updatedAt: session.updatedAt }),
+                  },
+                  { deferHistory: true },
+                ).pipe(
+                  Effect.catch((cause) =>
