+                      instanceId: instance.instanceId,
+                      cause,
+                    }),
+                  ),
+                ),
+              { discard: true },
+            );
+            if (page.nextCursor === null) return;
+            if (cursors.has(page.nextCursor)) {
+              yield* Effect.logWarning("External session discovery repeated a page cursor", {
+                instanceId: instance.instanceId,
+              });
+              return;
+            }
+            cursors.add(page.nextCursor);
+            cursor = page.nextCursor;
+          } while (cursor !== undefined);
+        }).pipe(
+          Effect.catchCause((cause) =>
+            Effect.logWarning("External session discovery failed; preserving existing threads", {
+              instanceId: instance.instanceId,
+              cause,
+            }),
+          ),
+        ),
+      { concurrency: 4, discard: true },
+    );
+  }).pipe(Effect.withSpan("AcpRegistrySessions.reconcile"));
+
+  return AcpRegistrySessions.of({
+    project,
+    sessionManager,
+    findOwner,
+    importSession,
+    reconcile,
+    importPendingHistory,
+  });
 });
 
 export const layer = Layer.effect(AcpRegistrySessions, make);
+
+export const layerAutoImport = Layer.effectDiscard(
+  Effect.gen(function* () {
+    const sessions = yield* AcpRegistrySessions;
+    const startup = yield* ServerRuntimeStartup.ServerRuntimeStartup;
+    yield* startup.awaitCommandReady.pipe(
+      Effect.andThen(sessions.reconcile.pipe(Effect.repeat(Schedule.spaced("30 seconds")))),
+      Effect.catchCause((cause) =>
+        Effect.logWarning("External session discovery stopped", { cause }),
+      ),
+      Effect.forkScoped,
+    );
+  }),
+);
