+++ b/apps/server/src/provider/AcpRegistrySessions.test.ts
@@ -0,0 +1,360 @@
+import { assert, it } from "@effect/vitest";
+import * as NodeCrypto from "@effect/platform-node/NodeCrypto";
+import {
+  AcpRegistryOperationError,
+  ProjectId,
+  ProviderDriverKind,
+  ProviderInstanceId,
+  type AcpRegistryListSessionsResult,
+  type OrchestrationV2ThreadProjection,
+  type OrchestrationV2ThreadShell,
+  ProviderThreadId,
+} from "@t3tools/contracts";
+import * as AcpRegistryRuntimeCoordinator from "@t3tools/provider-acp-registry/server/AcpRegistryRuntimeCoordinator";
+import type { ProviderInstance } from "@t3tools/provider-core/server/driver";
+import * as Context from "effect/Context";
+import * as Deferred from "effect/Deferred";
+import * as Effect from "effect/Effect";
+import * as Layer from "effect/Layer";
+import * as Option from "effect/Option";
+import * as SqlClient from "effect/sql/SqlClient";
+import * as TestClock from "effect/testing/TestClock";
+
+import * as ThreadLaunchService from "../orchestration-v2/ThreadLaunchService.ts";
+import * as ThreadManagementService from "../orchestration-v2/ThreadManagementService.ts";
+import * as SqlitePersistence from "../persistence/Sqlite.ts";
+import * as AgentSessionImporter from "../project/AgentSessionImporter.ts";
+import * as ProjectService from "../project/ProjectService.ts";
+import * as ServerRuntimeStartup from "../serverRuntimeStartup.ts";
+import * as AcpRegistrySessions from "./AcpRegistrySessions.ts";
+import * as ProviderInstanceRegistry from "./ProviderInstanceRegistry.ts";
+import * as ProviderRegistry from "./ProviderRegistry.ts";
+
+const projectId = ProjectId.make("fleet-project");
+const instanceId = ProviderInstanceId.make("fleet-provider");
+const driver = ProviderDriverKind.make("acpRegistry");
+const timestamp = "2026-11-17T00:00:00.000Z";
+const threadId = (sessionId: string) =>
+  AcpRegistrySessions.importedThreadId({ driver, instanceId, sessionId });
+const page = (ids: ReadonlyArray<string>, nextCursor: string | null = null) => ({
+  sessions: ids.map((sessionId) => ({
+    sessionId,
+    cwd: "/remote/work",
+    additionalDirectories: [],
+    title: sessionId,
+    updatedAt: null,
+    importedThreadId: null,
+  })),
+  nextCursor,
+  canLoad: true,
+  canResume: true,
+  canDelete: false,
+});
+
+const fixture = Effect.fn(function* () {
+  const sql = yield* SqlClient.SqlClient;
+  const launched: Array<ThreadLaunchService.ThreadLaunchInput> = [];
+  const listed: Array<string | undefined> = [];
+  const historyLoads: Array<
+    Parameters<AgentSessionImporter.AgentSessionImporter["Service"]["importNativeHistory"]>[0]
+  > = [];
+  let shell: OrchestrationV2ThreadShell | null = null;
+  let enabled = true;
+  let optedIn = true;
+  let observable = true;
+  let archivedProject = false;
+  let result = (
+    _cursor?: string,
+  ): Effect.Effect<AcpRegistryListSessionsResult, AcpRegistryOperationError> =>
+    Effect.succeed(page(["first"]));
+  const seed = (id: string, lifecycle: "active" | "archived" | "deleted" = "active") => sql`
+    INSERT INTO orchestration_v2_projection_threads (
+      thread_id, project_id, title, default_provider, runtime_mode, interaction_mode,
+      created_at, updated_at, archived_at, deleted_at, payload_json
+    ) VALUES (
+      ${id}, ${projectId}, 'existing', ${instanceId}, 'approval-required', 'default',
+      ${timestamp}, ${timestamp}, ${lifecycle === "archived" ? timestamp : null},
+      ${lifecycle === "deleted" ? timestamp : null}, '{}'
+    )
+  `;
+  const instance = {
+    instanceId,
+    driverKind: driver,
+    get enabled() {
+      return enabled;
+    },
+    snapshot: {
+      getSnapshot: Effect.sync(() => ({
+        nativeSessions: {
+          canList: true,
+          canLoad: true,
+          canObserve: observable,
+        },
+      })),
+    },
+    acpSessionManagement: {
+      get autoImportProjectId() {
+        return optedIn ? projectId : undefined;
+      },
+      listSessions: ({ cursor }: { readonly cursor?: string }) =>
+        Effect.suspend(() => {
+          listed.push(cursor);
+          return result(cursor);
+        }),
+    },
+  } as unknown as ProviderInstance;
+  const instances = [instance];
+  const services = AcpRegistrySessions.layer.pipe(
+    Layer.provide(
+      Layer.mergeAll(
+        Layer.mock(ProjectService.ProjectService)({
+          getById: () =>
+            Effect.sync(() =>
+              Option.some({
+                id: projectId,
+                title: "Fleet",
+                workspaceRoot: "/local/fleet",
+                scripts: [],
+                defaultModelSelection: null,
+                createdAt: timestamp,
+                updatedAt: timestamp,
+                archivedAt: archivedProject ? timestamp : null,
+                deletedAt: null,
+              }),
+            ),
+        }),
+        Layer.mock(ProviderInstanceRegistry.ProviderInstanceRegistry)({
+          getInstance: () => Effect.succeed(instance),
+          listInstances: Effect.succeed(instances),
+        }),
+        Layer.mock(ProviderRegistry.ProviderRegistry)({ getProviders: Effect.succeed([]) }),
+        Layer.mock(AcpRegistryRuntimeCoordinator.AcpRegistryRuntimeCoordinator)({
+          withSessionMutation: (effect) => effect,
+        }),
+        Layer.mock(ThreadManagementService.ThreadManagementService)({
+          getThreadShell: () => Effect.sync(() => shell),
+        }),
+        Layer.mock(ThreadLaunchService.ThreadLaunchService)({
+          launch: (input) =>
+            Effect.gen(function* () {
+              assert.isDefined(input.threadId);
+              const id = input.threadId!;
+              launched.push(input);
+              yield* seed(id);
+              return {
+                threadId: id,
+                projection: {} as OrchestrationV2ThreadProjection,
+                resumed: false,
+              };
+            }).pipe(Effect.orDie),
+        }),
+        Layer.mock(ServerRuntimeStartup.ServerRuntimeStartup)({
+          enqueueCommand: (effect) => effect,
+        }),
+        // Discovery must not load history, open observers, send prompts, or own native lifecycle.
+        Layer.mock(AgentSessionImporter.AgentSessionImporter)({
+          importNativeHistory: (input) =>
+            Effect.sync(() => {
+              assert.isNotNull(shell);
+              historyLoads.push(input);
+              shell = { ...shell!, historyOrigin: "v1_import" };
+              return 1;
+            }),
+        }),
+        Layer.succeed(SqlClient.SqlClient, sql),
+        NodeCrypto.layer,
+      ),
+    ),
+  );
+  const context = yield* Layer.build(services);
+  const sessions = Context.get(context, AcpRegistrySessions.AcpRegistrySessions);
+  return {
+    sessions,
+    historyLoads,
+    setPendingShell: (id: OrchestrationV2ThreadShell["id"]) => {
+      shell = {
+        id,
+        projectId,
+        providerInstanceId: instanceId,
+        latestRunId: null,
+        activeProviderThreadId: ProviderThreadId.make(id + ":provider"),
+      } as OrchestrationV2ThreadShell;
+    },
+    launched,
+    listed,
+    seed,
+    bind: (owner: string, nativeId: string) => sql`
+      INSERT INTO orchestration_v2_projection_provider_threads (
+        provider_thread_id, thread_id, provider, status, updated_at, payload_json, driver, provider_instance_id
+      ) VALUES (
+        ${owner + ":provider"}, ${owner}, ${instanceId}, 'idle', ${timestamp},
+        ${JSON.stringify({ nativeThreadRef: { nativeId } })}, ${driver}, ${instanceId}
+      )
+    `,
+    addUnavailableInstance: () =>
+      instances.unshift({
+        ...instance,
+        instanceId: ProviderInstanceId.make("unavailable"),
+        acpSessionManagement: {
+          ...instance.acpSessionManagement!,
+          listSessions: () =>
+            Effect.fail(
+              new AcpRegistryOperationError({
+                reason: "session_list_unsupported",
+                message: "offline",
+              }),
+            ),
+        },
+      }),
+    setResult: (next: typeof result) => {
+      result = next;
+    },
+    setEnabled: (value: boolean) => {
+      enabled = value;
+    },
+    setOptedIn: (value: boolean) => {
+      optedIn = value;
+    },
+    setObservable: (value: boolean) => {
+      observable = value;
+    },
+    setArchivedProject: (value: boolean) => {
+      archivedProject = value;
+    },
+  };
+});
+
+it.effect(
+  "discovers new external threads lazily and never recreates active, archived or deleted threads",
+  () =>
+    Effect.gen(function* () {
+      const f = yield* fixture();
+      for (const state of ["active", "archived", "deleted"] as const)
+        yield* f.seed(threadId(state), state);
+      yield* f.seed("older-owner", "deleted");
+      yield* f.bind("older-owner", "owned");
+      f.setResult((cursor) =>
+        Effect.succeed(
+          cursor === undefined
+            ? page(["active", "archived", "deleted", "owned", "first"], "second")
+            : page(["first", "second"]),
+        ),
+      );
+      yield* f.sessions.reconcile;
+      yield* f.sessions.reconcile;
+      assert.deepEqual(
+        f.launched.map((item) => item.threadId),
+        [threadId("first"), threadId("second")],
+      );
+      assert.deepEqual(f.listed, [undefined, "second", undefined, "second"]);
+      assert.deepEqual(f.historyLoads, []);
+      for (const input of f.launched) {
+        assert.equal(input.projectId, projectId);
+        assert.deepEqual(input.workspaceStrategy, { type: "root" });
+        assert.isUndefined(input.initialMessage);
+        assert.isDefined(input.importedNativeThread);
+      }
+    }).pipe(Effect.scoped, Effect.provide(SqlitePersistence.layerMemory)),
+);
+
+it.effect(
+  "requires both explicit destination and observable sessions and preserves offline history",
+  () =>
+    Effect.gen(function* () {
+      const f = yield* fixture();
+      f.setOptedIn(false);
+      yield* f.sessions.reconcile;
+      f.setOptedIn(true);
+      f.setObservable(false);
+      yield* f.sessions.reconcile;
+      f.setObservable(true);
+      f.setEnabled(false);
+      yield* f.sessions.reconcile;
+      f.setEnabled(true);
+      f.setArchivedProject(true);
+      yield* f.sessions.reconcile;
+      assert.deepEqual(f.listed, []);
+      f.setArchivedProject(false);
+      f.addUnavailableInstance();
+      f.setResult(() =>
+        Effect.fail(
+          new AcpRegistryOperationError({ reason: "session_list_unsupported", message: "offline" }),
+        ),
+      );
+      yield* f.sessions.reconcile;
+      f.setResult(() => Effect.succeed(page(["first"])));
+      yield* f.sessions.reconcile;
+      f.setResult(() => Effect.succeed(page([])));
+      yield* f.sessions.reconcile;
+      f.setResult(() => Effect.succeed(page(["first", "new-later"])));
+      yield* f.sessions.reconcile;
+      assert.deepEqual(
+        f.launched.map((item) => item.threadId),
+        [threadId("first"), threadId("new-later")],
+      );
+    }).pipe(Effect.scoped, Effect.provide(SqlitePersistence.layerMemory)),
+);
+
+it.effect("terminates broken cursor cycles without losing already discovered sessions", () =>
+  Effect.gen(function* () {
+    const f = yield* fixture();
+    f.setResult(() => Effect.succeed(page(["first"], "same")));
+    yield* f.sessions.reconcile;
+    assert.deepEqual(f.listed, [undefined, "same"]);
+    assert.equal(f.launched.length, 1);
+  }).pipe(Effect.scoped, Effect.provide(SqlitePersistence.layerMemory)),
+);
+
+it.effect("runs discovery after readiness and continues without an open client", () =>
+  Effect.gen(function* () {
+    const ready = yield* Deferred.make<void>();
+    const first = yield* Deferred.make<void>();
+    const second = yield* Deferred.make<void>();
+    let scans = 0;
+    yield* Layer.build(
+      AcpRegistrySessions.layerAutoImport.pipe(
+        Layer.provide(
+          Layer.mergeAll(
+            Layer.mock(ServerRuntimeStartup.ServerRuntimeStartup)({
+              awaitCommandReady: Deferred.await(ready),
+            }),
+            Layer.mock(AcpRegistrySessions.AcpRegistrySessions)({
+              reconcile: Effect.sync(() => ++scans).pipe(
+                Effect.flatMap((count) =>
+                  Deferred.succeed(count === 1 ? first : second, undefined),
+                ),
+                Effect.asVoid,
+              ),
+            }),
+          ),
+        ),
+      ),
+    );
+    assert.equal(scans, 0);
+    yield* Deferred.succeed(ready, undefined);
+    yield* Deferred.await(first);
+    yield* TestClock.adjust("30 seconds");
+    yield* Deferred.await(second);
+    assert.equal(scans, 2);
+  }).pipe(Effect.scoped),
+);
+
+it.effect("loads a selected deferred thread through the history owner only once", () =>
+  Effect.gen(function* () {
+    const f = yield* fixture();
+    const id = threadId("deferred");
+    yield* f.seed(id);
+    yield* f.bind(id, "deferred");
+    f.setPendingShell(id);
+    f.setObservable(false);
+    assert.isFalse(yield* f.sessions.importPendingHistory(id));
+    assert.deepEqual(f.historyLoads, []);
+    f.setObservable(true);
+    assert.isTrue(yield* f.sessions.importPendingHistory(id));
+    assert.isFalse(yield* f.sessions.importPendingHistory(id));
+    assert.deepEqual(f.historyLoads, [
+      { threadId: id, workspaceRoot: "/local/fleet", observe: true },
+    ]);
+    assert.deepEqual(f.launched, []);
+  }).pipe(Effect.scoped, Effect.provide(SqlitePersistence.layerMemory)),
+);
